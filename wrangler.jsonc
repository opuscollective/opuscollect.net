// Cloudflare Workers config for the static Astro site (output in dist/).
{
  "name": "opuscollect-net",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": { "logs": { "enabled": true, "invocation_logs": true }, "traces": { "enabled": false } },
  // Required by `wrangler preview` (PR preview builds). Empty means "inherit the settings above".
  "previews": {}
}
