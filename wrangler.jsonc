// Cloudflare Worker for opuscollect.net: static pages from dist/, server routes in dist/_worker.js.
{
  "name": "opuscollect-net",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
    // No not_found_handling: unmatched paths must reach the Worker (accounts, profiles, API).
    // The Worker serves the 404 page itself.
  },
  "observability": { "logs": { "enabled": true, "invocation_logs": true }, "traces": { "enabled": false } },

  // Production data. Members, profiles, connections and verification live here.
  "d1_databases": [
    { "binding": "DB", "database_name": "opus-db", "database_id": "19bb8afa-2fc3-49fa-ab5d-1eaed7ef2cfd", "migrations_dir": "migrations" }
  ],
  // Profile photos and verification evidence. Never public by URL; served through the Worker.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "opus-media" }],
  // Existing waitlist storage (moved from Pages Functions).
  "kv_namespaces": [{ "binding": "WAITLIST", "id": "6cfbc14233c141aa9bbc4b3888d6bfeb" }],
  "vars": { "SITE_ENV": "production", "SHOW_SAMPLE_DATA": "0", "EMAIL_FROM": "Opus Collective <hello@opuscollect.net>" },

  // PR preview builds use separate, throwaway data so testing never touches real members.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "opus-db-preview", "database_id": "222a516b-3e7d-43f2-a8c3-31509e6022de", "migrations_dir": "migrations" }
    ],
    "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "opus-media-preview" }],
    "kv_namespaces": [{ "binding": "WAITLIST", "id": "bda17c52a1b6484ba1f82fd25057247d" }],
    "vars": { "SITE_ENV": "preview", "SHOW_SAMPLE_DATA": "1", "EMAIL_FROM": "Opus Collective <hello@opuscollect.net>" }
  }
}
