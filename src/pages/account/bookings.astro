---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { listMyBookings, STATUS_LABEL } from '@/server/bookings';
import { formatSlot, tzAbbr, money } from '@/lib/booking-time';
import '@/styles/app.css';
import '@/styles/business.css';
export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/sign-in?next=/account/bookings');
const rows = await listMyBookings(Astro.locals.runtime.env.DB, user.id);
---
<BaseLayout title="Your bookings" noindex>
  <section class="app">
    <div class="app__wrap app__wrap--wide" style="margin-inline:auto">
      <p class="t-meta app__kicker"><a class="link" href="/account">Account</a></p>
      <h1 class="app__title">Your bookings</h1>
      <p class="app__lead">Studio requests you’ve made while signed in. Requests made as a guest are in your email.</p>
      <div class="panel" style="margin-top:24px">
        {rows.length === 0 ? <p class="empty"><b>No bookings yet.</b>Find a studio in <a class="link" href="/studios">Opus World</a>.</p> : (
          <ul class="blist" role="list">{rows.map((b) => (
            <li class="bitem">
              <div><p class="bitem__when"><a class="link" href={`/bookings/${b.id}`}>{b.service_name}</a> · {b.studio_name}</p>
                <p class="bitem__who">{b.start_at ? `${formatSlot(b.start_at, b.timezone)} ${tzAbbr(b.start_at, b.timezone)}` : 'Remote project'} · {money(b.price_cents, b.currency)}</p>
                <p class="bitem__meta">{b.ref}</p></div>
              <div class="bitem__actions"><span class={`pill pill--${b.status}`}>{STATUS_LABEL[b.status]}</span></div>
            </li>
          ))}</ul>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
