---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ReleaseForm from '@/components/account/ReleaseForm.astro';
import { getMyProfile } from '@/server/profiles';
import { listReleases, KIND_LABEL, dateLabel, type Release } from '@/server/releases';
import { SPECIALTIES } from '@/data/specialties';
import '@/styles/app.css';
export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/sign-up?next=' + encodeURIComponent('/account/releases?new=1'));
const db = Astro.locals.runtime.env.DB;
const profile = await getMyProfile(db, user.id);
if (!profile) return Astro.redirect('/start');
let notReady = false;
const releases = await listReleases(db, profile.id).catch(() => { notReady = true; return []; });
const working = releases.filter((r) => r.stage === 'in_progress');
const out = releases.filter((r) => r.stage === 'released');
const openForm = Astro.url.searchParams.has('new') || releases.length === 0;
const defaultRole = profile.primarySpecialty ? SPECIALTIES[profile.primarySpecialty]?.label ?? '' : '';
const meta = (r: Release) => [KIND_LABEL[r.kind], r.artist && `with ${r.artist}`, r.role, dateLabel(r.releaseDate) && (r.stage === 'released' ? dateLabel(r.releaseDate) : `Target ${dateLabel(r.releaseDate)}`)].filter(Boolean).join(' · ');
---
<BaseLayout title="Your releases" noindex>
  <section class="app">
    <div class="app__wrap app__wrap--wide" style="margin-inline:auto">
      <p class="t-meta app__kicker">Releases</p>
      <h1 class="app__title">Your releases</h1>
      <p class="app__lead">What you’re working on and what you’ve put out. You choose what shows on <a class="link" href={`/m/${profile.handle}`}>your profile</a>.</p>

      {notReady && <p class="notice notice--warn" style="margin-top:20px">Releases aren’t switched on for this environment yet. Saving will work once the database update is applied.</p>}
      <div class="row" style="margin-top:24px">
        <button class="btn-app" type="button" data-new hidden={openForm}>Start or add a release</button>
      </div>

      <div class="panel" data-form-panel hidden={!openForm} style="margin-top:16px">
        <h2 data-form-title>Start or add a release</h2>
        <div style="margin-top:16px"><ReleaseForm defaultRole={defaultRole} /></div>
      </div>

      {[['Working on', working], ['Released', out]].map(([title, list]) => (list as Release[]).length > 0 && (
        <section class="rl" aria-label={title as string}>
          <h2 class="t-meta rl__h">{title}</h2>
          <ul class="rl__list" role="list">
            {(list as Release[]).map((r) => (
              <li class="rl__row" data-release={JSON.stringify(r)}>
                <div class="rl__txt">
                  <p class="rl__title">{r.link ? <a href={r.link} target="_blank" rel="noopener nofollow">{r.title} ↗</a> : r.title}</p>
                  <p class="rl__meta">{meta(r)}</p>
                  {r.notes && <p class="rl__notes">{r.notes}</p>}
                </div>
                <div class="rl__actions">
                  <span class:list={['rl__vis', { 'is-private': !r.showOnProfile }]}>{r.showOnProfile ? 'On your profile' : 'Private'}</span>
                  <button type="button" class="btn-app btn-app--ghost" data-toggle>{r.showOnProfile ? 'Hide' : 'Show'}</button>
                  {r.stage === 'in_progress' && <button type="button" class="btn-app btn-app--ghost" data-mark-out>Mark as released</button>}
                  <button type="button" class="btn-app btn-app--ghost" data-edit>Edit</button>
                  <button type="button" class="btn-app btn-app--ghost" data-delete aria-label={`Delete ${r.title}`}>Delete</button>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="rl__note">Releases are added by you. Opus doesn’t check them, and they’re shown as yours, not as verified credits.</p>
    </div>
  </section>
</BaseLayout>

<script>
  import { bindReleaseForm, type ReleaseOut } from '@/scripts/releases';
  const panel = document.querySelector<HTMLElement>('[data-form-panel]')!;
  const form = panel.querySelector<HTMLFormElement>('[data-release-form]')!;
  const newBtn = document.querySelector<HTMLButtonElement>('[data-new]')!;
  const cancel = form.querySelector<HTMLButtonElement>('[data-release-cancel]')!;
  const title = panel.querySelector<HTMLElement>('[data-form-title]')!;
  const ctl = bindReleaseForm(form, () => { location.href = '/account/releases'; });
  ctl.fill(null);
  cancel.hidden = false;
  const open = (r: ReleaseOut | null) => {
    ctl.fill(r);
    title.textContent = r ? 'Edit release' : 'Start or add a release';
    panel.hidden = false; newBtn.hidden = true;
    panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    form.querySelector<HTMLInputElement>('[name="title"]')?.focus({ preventScroll: true });
  };
  newBtn.addEventListener('click', () => open(null));
  cancel.addEventListener('click', () => { panel.hidden = true; newBtn.hidden = false; });

  const patch = async (id: string, body: object) => {
    const r = await fetch(`/api/releases/${encodeURIComponent(id)}`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
    if (r.ok) location.reload(); else alert(((await r.json().catch(() => ({}))) as { error?: string }).error ?? 'Something went wrong.');
  };
  document.querySelectorAll<HTMLElement>('[data-release]').forEach((li) => {
    const r = JSON.parse(li.dataset.release!) as ReleaseOut;
    li.querySelector('[data-edit]')?.addEventListener('click', () => open(r));
    li.querySelector('[data-toggle]')?.addEventListener('click', () => patch(r.id, { showOnProfile: !r.showOnProfile }));
    li.querySelector('[data-mark-out]')?.addEventListener('click', () => patch(r.id, { stage: 'released' }));
    li.querySelector('[data-delete]')?.addEventListener('click', async () => {
      if (!confirm(`Delete “${r.title}”? This can’t be undone.`)) return;
      const res = await fetch(`/api/releases/${encodeURIComponent(r.id)}`, { method: 'DELETE' });
      if (res.ok) location.reload();
    });
  });
</script>

<style>
  .rl { margin-top: 40px; }
  .rl__h { color: var(--text-3); margin-bottom: 12px; }
  .rl__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .rl__row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .rl__txt { min-width: 0; flex: 1 1 320px; }
  .rl__title { font-size: 18px; font-weight: 500; letter-spacing: -0.02em; }
  .rl__title a:hover { color: var(--accent); }
  .rl__meta { margin-top: 4px; font-size: 14px; color: var(--text-3); }
  .rl__notes { margin-top: 6px; font-size: 14px; color: var(--text-2); }
  .rl__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .rl__actions .btn-app { min-height: 36px; padding: 0 12px; font-size: 13px; }
  .rl__vis { font-size: 12px; color: var(--text-2); padding: 4px 8px; border-radius: var(--r-pill); background: var(--surface); }
  .rl__vis.is-private { color: var(--text-3); border: 1px dashed var(--line-strong); background: none; }
  .rl__note { margin-top: 28px; font-size: 13px; color: var(--text-3); }
</style>
