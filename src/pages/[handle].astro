---
import { CITIES, citySlug } from '@/data/cities';
import BaseLayout from '@/layouts/BaseLayout.astro';
import VerifiedBadge from '@/components/ui/VerifiedBadge.astro';
import { SPECIALTIES, allSpecialties } from '@/data/specialties';
import { PLACE_BY_ID, visibleLabel } from '@/data/places';
import { getPublicProfile, mediaUrl } from '@/server/profiles';
import { relationship, DEFAULT_INTRO, INTRO_MAX, profileConnections } from '@/server/connections';
import { NO_OVERLAP, overlap } from '@/server/overlap';
import { connectionCount } from '@/server/messages';
import { profileReleases } from '@/server/releases';
import { RELEASE_KINDS } from '@/data/music';
import { getPageConfig } from '@/server/page-config';
import { listHireServices } from '@/server/hire';
import { HIRE_ENABLED } from '@/lib/features';
import { membershipsOf, myInvites } from '@/server/clans';
import { recordView } from '@/server/views';
import '@/styles/app.css';
import '@/styles/clans.css';
import '@/styles/music.css';
export const prerender = false;

const handle = Astro.params.handle ?? '';
const viewer = Astro.locals.user;
const db = Astro.locals.runtime.env.DB;
const found = await getPublicProfile(db, handle, viewer?.id ?? null);
if (!found) {
  Astro.response.status = 404;
  // Empty 404: Astro renders the site's own 404 page (header, footer, both themes).
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const { profile: p, isOwner, ownerId } = found;
if (p.handle !== handle) return Astro.redirect(`/${p.handle}`, 301);
if (p.status === 'published') await recordView(Astro.locals.runtime.env, Astro.locals.runtime.ctx, p.id, Astro.request, isOwner);

// Honour the member's location choice (city, metro area, state/country, or hidden).
const initials = (n: string) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join('');
const where = visibleLabel(p.placeId, p.locationVisibility);
// Links to the metro area on World, unless the member shows only a region or nothing.
const metroPlace = p.placeId ? PLACE_BY_ID.get(PLACE_BY_ID.get(p.placeId)?.metroId ?? '') : undefined;
const worldCity = p.locationVisibility === 'city' || p.locationVisibility === 'metro' ? metroPlace?.name : undefined;
const roles = p.primarySpecialty ? allSpecialties(p.primarySpecialty, p.specialties).map((s) => SPECIALTIES[s].label) : [];
const rel = viewer ? await relationship(db, viewer.id, ownerId) : null;
// Accepted connections only; never estimated.
const connections = await connectionCount(db, ownerId);
const people = connections > 0 ? await profileConnections(db, ownerId, viewer?.id ?? null).catch(() => ({ faces: [], mutual: 0 })) : { faces: [], mutual: 0 };
// What a signed-in visitor shares with this member: mutual connections and works they both appear on. Nothing is shown without overlap.
const shared = viewer && !isOwner ? await overlap(db, viewer.id, ownerId).catch(() => NO_OVERLAP) : NO_OVERLAP;
const sharedNames = shared.mutuals.slice(0, 2).map((x) => x.name.split(' ')[0]!);
const firstNames = people.faces.slice(0, 2).map((f) => f.name.split(' ')[0]);
// The member's record: releases they put out, plus releases where they confirmed a credit.
const record = await profileReleases(db, ownerId);
// Bands and other groups this member accepted. Invitations are shown to the member only.
const clans = await membershipsOf(db, ownerId).catch(() => []);
const invites = isOwner ? await myInvites(db, ownerId).catch(() => []) : [];
const LINK_LABEL: Record<string, string> = { spotify: 'Spotify', appleMusic: 'Apple Music', soundcloud: 'SoundCloud', youtube: 'YouTube', instagram: 'Instagram', tiktok: 'TikTok', website: 'Website' };
const links = Object.entries(p.links).filter(([, v]) => !!v);
const hire = HIRE_ENABLED && (p.status === 'published' || isOwner) ? await listHireServices(db, p.id).catch(() => []) : [];
const usd = (c: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(c / 100);
const page = await getPageConfig(Astro.locals.runtime.env.WAITLIST, p.id);
// Essentials lead the page; with none chosen, the latest work leads on its own. Then all work, by year.
const essentials = (page.essentials.map((id) => record.find((x) => x.id === id)).filter(Boolean) as typeof record).slice(0, 6);
const lead = essentials.length ? essentials : record[0] ? [record[0]] : [];
const noteOf = (id: string) => page.notes[id] ?? '';
const byYear = (() => {
  const m = new Map<string, typeof record>();
  for (const x of record) { const y = x.releaseDate?.slice(0, 4) ?? (x.released ? 'Earlier' : 'Coming'); m.set(y, [...(m.get(y) ?? []), x]); }
  return [...m.entries()];
})();
const essentialIds = new Set(essentials.map((x) => x.id));
const hue = [...p.handle].reduce((a, c) => (a * 31 + c.charCodeAt(0)) % 360, 0);
const photo = p.photoKey ? mediaUrl(p.photoKey) : null;
const show = (k: 'works' | 'credits' | 'about') => !page.hide.includes(k);
const ord = (k: string) => page.order.indexOf(k as never);
const hasAbout = !!(p.bio || p.achievements.length || p.collaborations.length || p.portfolio.length);
const releaseLine = (x: (typeof record)[number]) => [x.artist && (!x.own || !x.roles.includes('Primary Artist')) ? x.artist : null, x.own && x.roles.length === 1 && x.roles[0] === 'Primary Artist' ? null : x.roles.length ? x.roles.join(', ') : null, RELEASE_KINDS[x.kind], x.releaseDate?.slice(0, 4)].filter(Boolean).join(' · ');
const byLine = (x: (typeof record)[number]) => [x.artist && (!x.own || !x.roles.includes('Primary Artist')) ? x.artist : null, x.own && x.roles.length === 1 && x.roles[0] === 'Primary Artist' ? null : x.roles.length ? x.roles.join(', ') : null].filter(Boolean).join(' · ');
const isEmpty = !record.length && !p.credits.length && !hasAbout;
const desc = `${p.displayName}${roles.length ? ` · ${roles.join(', ')}` : ''}${where ? ` · ${where}` : ''} on Opus.`;
---
<BaseLayout title={p.displayName} description={desc} noindex={p.status !== 'published'} image={p.photoKey ? mediaUrl(p.photoKey)! : undefined}>
  {isOwner && (
    <div class="mp-preview">
      <span><b>{p.status === 'published' ? 'This is your public page.' : 'Draft preview.'}</b> {p.status === 'published' ? 'Everyone sees it exactly like this.' : 'Only you can see it until you publish.'}</span>
      <span class="mp-preview__a">
        <a class="btn-app btn-app--ghost" href="/account/profile">Edit profile</a>
        <a class="btn-app btn-app--ghost" href="/account/page">Customize page</a>
        <a class="btn-app btn-app--ghost" href="/works/mine?add=1">Add a work</a>
        <a class="btn-app btn-app--ghost" href={`/${p.handle}/links`}>Link in bio</a>
        <a class="btn-app btn-app--ghost" href="/account/world">My World</a>
      </span>
    </div>
  )}
  <article class="mp" style={`--mp-hue:${hue}`}>
    <div class="mp__wash" aria-hidden="true" style={photo ? `background-image:url(${photo})` : ''}></div>
    <div class="mp__inner">
      <div class:list={['mp__banner', { 'has-cover': !!p.coverKey }]} role="img" aria-label={p.coverKey ? `Banner of ${p.displayName}` : undefined} aria-hidden={p.coverKey ? undefined : 'true'} style={(p.coverKey ? `background-image:url(${mediaUrl(p.coverKey)});` : photo ? `--b-img:url(${photo});` : '')}></div>
      <header class:list={['mp__head', { 'no-photo': !photo }]}>
        <div class="mp__photo" style={`view-transition-name:pf-${p.handle};` + (photo ? `background-image:url(${photo})` : '')} role="img" aria-label={photo ? `Photo of ${p.displayName}` : p.displayName}>{!photo && initials(p.displayName)}</div>
        <div class="mp__id">
          <p class="mp__kicker">{roles.length ? roles.slice(0, 3).join(' · ') : 'Opus member'}{p.verification === 'verified' && <VerifiedBadge size={16} />}</p>
          <h1 class="mp__name">{p.displayName}</h1>
          {page.tagline && <p class="mp__tag">{page.tagline}</p>}
          <ul class="mp__facts" role="list">
            {where && <li>{where && worldCity ? <a class="mp__where" href={CITIES.some((c) => c.name === worldCity) ? `/world/${citySlug(worldCity)}` : `/world?city=${encodeURIComponent(worldCity)}`}>{where}</a> : where}</li>}
            {p.genres.length > 0 && <li>{p.genres.slice(0, 3).join(', ')}</li>}
            {hire.length > 0 && <li class="is-on">For hire</li>}
            <li><b>{connections.toLocaleString('en-US')}</b> {connections === 1 ? 'connection' : 'connections'}</li>
          </ul>
          {links.length + page.links.length > 0 && (
            <ul class="mp__chips" role="list">
              {page.links.map((l) => <li><a href={l.url} target="_blank" rel="noopener nofollow ugc">{l.label} ↗</a></li>)}
              {links.map(([k, v]) => <li><a href={v} target="_blank" rel="noopener nofollow ugc">{LINK_LABEL[k] ?? k} ↗</a></li>)}
            </ul>
          )}
          {clans.length > 0 && (
            <ul class="mp__groups" role="list" aria-label="Groups">
              {clans.map((m) => (
                <li><a href={m.clan.href} title={[m.clan.typeLabel, m.roles.join(', ')].filter(Boolean).join(' · ')}>
                  <span class="mp__gl" style={m.clan.photo ? `background-image:url(${m.clan.photo})` : ''}>{!m.clan.photo && m.clan.name.slice(0, 1)}</span>
                  <span class="mp__gn">{m.clan.name}</span>
                </a></li>
              ))}
            </ul>
          )}
          {/* When the visitor shares something with this member, that row replaces the general one. */}
          {connections > 0 && shared.mutualCount === 0 && shared.works.length === 0 && (
            <div class="mp__people">
              {people.faces.length > 0 && <span class="mp__faces" aria-hidden="true">{people.faces.map((f) => (
                <a href={`/${f.handle}`} tabindex="-1" title={f.name} style={f.photoKey ? `background-image:url(${mediaUrl(f.photoKey)})` : ''}>{!f.photoKey && f.name.slice(0, 1)}</a>
              ))}</span>}
              <span class="mp__people-t">
                {people.faces.length > 0 ? <>Connected with {firstNames.join(', ')}{connections > firstNames.length && ` and ${connections - firstNames.length} ${connections - firstNames.length === 1 ? 'other' : 'others'}`}</> : `${connections} ${connections === 1 ? 'connection' : 'connections'}`}
              </span>
            </div>
          )}
          {(shared.mutualCount > 0 || shared.works.length > 0) && (
            <div class="mp__shared">
              <span class="mp__faces">
                {shared.mutuals.slice(0, 3).map((f) => (
                  <a href={`/${f.handle}`} title={f.name} style={f.photo ? `background-image:url(${f.photo})` : ''}>{!f.photo && f.name.slice(0, 1)}</a>
                ))}
                {shared.works.slice(0, 3).map((w) => (
                  <a class="is-sq" href={`/r/${w.id}`} title={w.title} style={w.cover ? `background-image:url(${w.cover})` : ''}>{!w.cover && w.title.slice(0, 1)}</a>
                ))}
              </span>
              <p>
                {shared.mutualCount > 0 && (sharedNames.length > 0
                  ? <>You both know {sharedNames.map((n, i) => <>{i > 0 && ', '}<b>{n}</b></>)}{shared.mutualCount > sharedNames.length && ` and ${shared.mutualCount - sharedNames.length} ${shared.mutualCount - sharedNames.length === 1 ? 'other' : 'others'}`}</>
                  : `${shared.mutualCount} mutual ${shared.mutualCount === 1 ? 'connection' : 'connections'}`)}
                {shared.mutualCount > 0 && shared.works.length > 0 && <i aria-hidden="true"> · </i>}
                {shared.works.length > 0 && <>Together on {shared.works.slice(0, 2).map((w, i) => <>{i > 0 && ', '}<b>{w.title}</b></>)}{shared.works.length > 2 && ` and ${shared.works.length - 2} more`}</>}
              </p>
            </div>
          )}
          <div class="mp__actions">
          {isOwner ? null : !viewer ? (
            <>
              <a class="btn-app" href={'/sign-in?next=' + encodeURIComponent('/' + p.handle + '?connect=1')}>Connect</a>
              <a class="btn-app btn-app--ghost" href={'/sign-in?next=' + encodeURIComponent('/' + p.handle + '?connect=1')}>Message</a>
            </>
          ) : rel?.state === 'connected' ? (
            <>
              <span class="mp__state" data-conn-state="connected">Connected</span>
              <button class="btn-app" type="button" data-message-handle={p.handle}>Message</button>
            </>
          ) : rel?.state === 'sent' ? (
            <>
              <span class="mp__state" data-conn-state="sent">Request sent</span>
              <button class="btn-app btn-app--ghost" type="button" data-conn-act="withdraw" data-conn-id={rel.id}>Cancel request</button>
            </>
          ) : rel?.state === 'received' ? (
            <>
              <button class="btn-app" type="button" data-conn-act="accept" data-conn-id={rel.id}>Accept</button>
              <button class="btn-app btn-app--ghost" type="button" data-conn-act="decline" data-conn-id={rel.id}>Decline</button>
            </>
          ) : rel?.state === 'none' ? (
            <>
              <button class="btn-app" type="button" data-connect-open aria-haspopup="dialog">Connect</button>
              <button class="btn-app btn-app--ghost" type="button" data-connect-open aria-haspopup="dialog">Message</button>
            </>
          ) : null}
          {viewer && !isOwner && (
            <details class="mp__more">
              <summary aria-label="More actions">···</summary>
              <div>
                {rel?.state === 'connected' && <button type="button" class="mp__more-plain" data-conn-act="remove" data-conn-id={rel.id}>Remove connection</button>}
                {rel?.state === 'connected' && <a class="mp__more-link" href="/network">My Network</a>}
                <button type="button" data-block={rel?.state === 'blocked' ? 'off' : 'on'}>{rel?.state === 'blocked' ? 'Unblock' : 'Block'} {p.displayName}</button>
              </div>
            </details>
          )}
          </div>
        </div>
      </header>
      {invites.length > 0 && <p class="notice" style="margin-top:20px"><b>{invites.length === 1 ? `${invites[0]!.clan.name} invited you to join.` : `${invites.length} group invitations.`}</b> Only you can see this. <a class="link" href="/clans/mine">Answer in My groups</a></p>}
      {rel?.state === 'received' && <p class="mp__note" data-conn-note>{p.displayName} asked to connect with you. You can also answer in <a class="link" href="/network?tab=received">My Network</a>.</p>}
      <p class="dim mu-err" data-conn-status role="alert"></p>

      {viewer && !isOwner && rel?.state === 'none' && (
        <dialog class="cdlg" data-connect aria-labelledby="cdlg-title">
          <form class="cdlg__form" data-connect-form novalidate>
            <div class="cdlg__who">
              <span class="cdlg__av" style={p.photoKey ? `background-image:url(${mediaUrl(p.photoKey)})` : ''} aria-hidden="true"></span>
              <span>
                <b id="cdlg-title">Connect with {p.displayName}</b>
                <small>{[roles[0], where].filter(Boolean).join(' · ') || 'Opus member'}</small>
              </span>
            </div>
            <input type="hidden" name="to" value={p.handle} />
            <label class="field cdlg__field">
              <span>Introduction <span class="dim">(optional)</span></span>
              <textarea class="textarea" name="message" maxlength={INTRO_MAX} rows="4" data-intro>{DEFAULT_INTRO}</textarea>
              <small class="cdlg__count"><span data-intro-count>{DEFAULT_INTRO.length}</span>/{INTRO_MAX}</small>
            </label>
            <p class="cdlg__fine">{p.displayName} sees this with your request. It isn’t a message; once you’re connected you can message each other.</p>
            <div data-status class="form-status"></div>
            <div class="cdlg__row">
              <button class="btn-app btn-app--ghost" type="button" data-connect-cancel>Cancel</button>
              <button class="btn-app" type="submit">Send request</button>
            </div>
          </form>
        </dialog>
      )}

      {viewer && !isOwner && hire.length > 0 && (
        <dialog class="cdlg" data-work aria-labelledby="wdlg-title">
          <form class="cdlg__form" data-work-form novalidate>
            <div class="cdlg__who"><span><b id="wdlg-title">Request to work with {p.displayName}</b><small data-work-service></small></span></div>
            <input type="hidden" name="handle" value={p.handle} />
            <input type="hidden" name="serviceId" />
            <label class="field cdlg__field"><span>About the project *</span><textarea class="textarea" name="project" maxlength="1500" rows="4" placeholder="What are you making? Reference tracks, genre, what you need from them."></textarea></label>
            <label class="field"><span>Your budget <span class="dim">(optional)</span></span><input class="input" name="budget" maxlength="120" placeholder="e.g. $200" /></label>
            <label class="field"><span>When <span class="dim">(optional)</span></span><input class="input" name="deadline" maxlength="120" placeholder="e.g. by Dec 15, or this weekend" /></label>
            <p class="cdlg__fine">{p.displayName} sees this and accepts or declines. If they accept, you’re connected and can message. Nothing is charged on Opus.</p>
            <div data-status class="form-status"></div>
            <div class="cdlg__row"><button class="btn-app btn-app--ghost" type="button" data-work-cancel>Cancel</button><button class="btn-app" type="submit">Send request</button></div>
          </form>
        </dialog>
      )}

      {isEmpty && !isOwner && hire.length === 0 ? (
        <p class="mp__new">{p.displayName} is new to Opus. Their works and credits will appear here.</p>
      ) : (
      <div class="mp__grid">
        <div class="mp__main">
          {HIRE_ENABLED && (hire.length > 0 || isOwner) && (
            <section class="mp__sec mp__hire" id="hire" style="order:-1">
              <h2 class="mp__h">Work with {p.displayName.split(' ')[0]}</h2>
              {hire.length > 0 ? (
                <ul class="mp__svc" role="list">{hire.map((x) => (
                  <li>
                    <span><b>{x.name}</b><small>{x.mode === 'remote' ? 'Remote' : 'In person'} · from {usd(x.fromCents)}{x.description && ` · ${x.description}`}</small></span>
                    {isOwner ? null : viewer ? <button class="btn-app btn-app--ghost" type="button" data-work-open data-sid={x.id} data-sname={x.name}>Request</button> : <a class="btn-app btn-app--ghost" href={'/sign-in?next=' + encodeURIComponent('/' + p.handle)}>Request</a>}
                  </li>
                ))}</ul>
              ) : <p class="dim">Offer a beat, a mix or a session, remote or in person, and show “For hire” here and in World. <a class="link" href="/account/hire">List a service</a></p>}
              {isOwner && hire.length > 0 && <p class="dim mp__fine"><a class="link" href="/account/hire">Edit services and requests</a></p>}
              {hire.length > 0 && !isOwner && <p class="dim mp__fine">“From” prices are a guide. You agree the details and payment directly; Opus doesn’t take payment yet.</p>}
            </section>
          )}
          {show('works') && (record.length > 0 || isOwner) && (
            <section class="mp__sec" id="works" style={`order:${ord('works')}`}>
              {lead.length > 0 ? (
                <>
                  <h2 class="mp__h">{essentials.length ? 'Essentials' : 'Latest'}</h2>
                  <ul class:list={['mp__ess', { 'is-one': lead.length === 1 }]} role="list">{lead.map((x, i) => (
                    <li>
                      <a href={`/r/${x.id}`}>
                        <span class="mp__ess-cover" style={x.coverKey ? `background-image:url(${mediaUrl(x.coverKey)})` : `--c:${(hue + 40 + i * 47) % 360}`}></span>
                        <span class="mp__ess-t">
                          <small>{RELEASE_KINDS[x.kind]} · {x.released ? (x.releaseDate?.slice(0, 4) ?? "Out now") : "Coming"}</small>
                          <b>{x.title}</b>
                          {byLine(x) && <em>{byLine(x)}</em>}
                          {noteOf(x.id) ? <span class="mp__ess-n">{noteOf(x.id)}</span> : isOwner ? <span class="mp__ess-n is-hint">Add a line about this work in Customize page.</span> : null}
                        </span>
                      </a>
                    </li>
                  ))}</ul>
                  {record.length > 1 && (
                    <>
                      <h2 class="mp__h">All work <span>{record.length}</span></h2>
                      <div class="mp__years">{byYear.map(([year, items]) => (
                        <section class="mp__year">
                          <h3>{year}</h3>
                          <ul role="list">{items.map((x, i) => (
                            <li><a href={`/r/${x.id}`}>
                              <span class="mp__row-cover" style={x.coverKey ? `background-image:url(${mediaUrl(x.coverKey)})` : `--c:${(hue + 40 + i * 47) % 360}`}></span>
                              <span class="mp__row-t">
                                <b>{x.title}{essentialIds.has(x.id) && <i>Essential</i>}</b>
                                <small>{[RELEASE_KINDS[x.kind], byLine(x)].filter(Boolean).join(' · ')}</small>
                                {noteOf(x.id) && !essentialIds.has(x.id) && <span class="mp__row-n">{noteOf(x.id)}</span>}
                              </span>
                            </a></li>
                          ))}</ul>
                        </section>
                      ))}</div>
                    </>
                  )}
                </>
              ) : (
                <>
                  <h2 class="mp__h">Works</h2>
                  <ul class="mp__shelf mp__shelf--ghost" role="list">{[0, 1, 2, 3].map((i) => <li><a href="/works/mine?add=1"><span class="mp__tile" style={`--c:${(hue + i * 40) % 360}`}></span><b>{i === 0 ? 'Add your first work' : ' '}</b><small>{i === 0 ? 'Search a song or paste a link' : ' '}</small></a></li>)}</ul>
                </>
              )}
            </section>
          )}
          {show('credits') && p.credits.length > 0 && (
            <section class="mp__sec" style={`order:${ord('credits')}`}><h2 class="mp__h">{record.length ? 'Other credits' : 'Credits'}</h2>
              <ul class="mp__credits" role="list">
                {p.credits.map((c) => (
                  <li>
                    <span class="mp__ct">{c.url ? <a href={c.url} target="_blank" rel="noopener nofollow ugc">{c.title}</a> : c.title}</span>
                    <span class="dim">{[c.artist, c.role, c.year].filter(Boolean).join(' · ')}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}
          {show('about') && hasAbout && (
            <section class="mp__sec" style={`order:${ord('about')}`}><h2 class="mp__h">About</h2>
              {p.bio && <p class="mp__bio">{p.bio}</p>}
              {p.achievements.length > 0 && <ul class="mp__list" role="list">{p.achievements.map((a) => <li>{a}</li>)}</ul>}
              {p.collaborations.length > 0 && <ul class="mp__tags" role="list">{p.collaborations.map((a) => <li>{a}</li>)}</ul>}
              {p.portfolio.length > 0 && <ul class="mp__links" role="list">{p.portfolio.map((x) => <li><a href={x.url} target="_blank" rel="noopener nofollow ugc">{x.title || new URL(x.url).hostname} ↗</a></li>)}</ul>}
            </section>
          )}
        </div>
      </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .mp-preview { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; padding: 10px 16px; border-bottom: 1px solid var(--line); background: var(--surface-sunken); font-size: 14px; color: var(--c-fg-subtle); }
  .mp-preview { align-items: center; position: sticky; top: var(--hdr-h); z-index: calc(var(--z-header) - 1); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .mp-preview__a { display: inline-flex; flex-wrap: wrap; gap: 8px; }
  @media (max-width: 860px) { .mp-preview { position: static; } }
  .mp-preview .btn-app { min-height: 34px; padding: 0 14px; font-size: 13px; }
  .mp-preview b { color: var(--text); font-weight: 500; }
