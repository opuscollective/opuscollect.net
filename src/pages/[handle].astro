  .mp__ess.is-one .mp__ess-cover { flex: none; width: clamp(180px, 24vw, 300px); }
  .mp__ess.is-one .mp__ess-t b { font-size: clamp(1.8rem, 1rem + 2.4vw, 3rem); letter-spacing: -0.04em; }
  .mp__ess.is-one .mp__ess-n { max-width: 52ch; font-size: 16px; -webkit-line-clamp: 6; }
  /* All work, by year. */
  /* All work: the rest of the catalogue as a quieter shelf of smaller covers, grouped by year. */
  .mp__facts .is-away a { color: var(--pf-ink); }
  .tr { margin-top: 14px; padding: 22px; border-radius: 20px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  .tr__h { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 0 0 12px; font-size: 16px; font-weight: 500; letter-spacing: -0.02em; }
  .tr__h span { font-size: 12.5px; font-weight: 400; color: var(--text-3); }
  .tr__list li { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 9px 0; border-top: 1px solid var(--line); }
  .tr__list li:first-child { border-top: 0; padding-top: 0; }
  .tr__list a { display: inline-flex; align-items: center; gap: 10px; color: inherit; text-decoration: none; min-width: 0; }
  .tr__list a:hover b { text-decoration: underline; text-underline-offset: 3px; }
  .tr__list b { font-size: 14px; font-weight: 500; letter-spacing: -0.01em; }
  .tr__list small { flex: none; font-size: 12.5px; color: var(--text-3); }
  /* Marked by the member: a ring. Real connections there: filled. Home: the accent. */
  .tr__list i { flex: none; width: 9px; height: 9px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--text-3); }
  .tr__list .is-on i { background: var(--text-2); box-shadow: none; }
  .tr__list .is-home i { background: var(--pf-ink); box-shadow: 0 0 0 3px var(--pf-soft); }
  .tr__list .is-now small { color: var(--pf-ink); }
  .tr__fine { margin: 12px 0 0; font-size: 12.5px; color: var(--text-3); }
  .mp__rows { border-top: 1px solid var(--line); }
  .mp__rows a { display: flex; align-items: center; gap: 16px; padding: 12px 4px; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; transition: background var(--dur, .15s) var(--ease, ease); }
  .mp__rows a:hover { background: var(--surface-hover); }
  .mp__rows .mp__row-cover { flex: none; width: 60px; border-radius: 8px; }
  .mp__rows .mp__row-t { flex: 1; }
  .mp__rows .mp__row-t b { display: flex; align-items: center; gap: 10px; font-size: 16px; }
  .mp__rows .mp__row-t b i { display: inline-block; margin: 0; }
  .mp__rows .mp__row-t small { font-size: 13.5px; }
  .mp__row-y { flex: none; font-size: 14px; color: var(--text-3); font-variant-numeric: tabular-nums; }
  .mp__years { display: flex; flex-direction: column; gap: 34px; }
  .mp__year h3 { margin: 0 0 14px; font-size: 14px; font-weight: 500; color: var(--text-3); font-variant-numeric: tabular-nums; letter-spacing: .04em; }
  .mp__year ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 148px), 1fr)); gap: 22px 16px; }
  .mp__year a { display: flex; flex-direction: column; gap: 10px; color: inherit; text-decoration: none; }
  .mp__year a:hover .mp__row-t b { text-decoration: underline; text-underline-offset: 3px; }
  .mp__row-cover { aspect-ratio: 1; border-radius: 8px; }
  .mp__row-t { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .mp__row-t b { font-weight: 500; font-size: 14px; letter-spacing: -0.01em; line-height: 1.25; }
  .mp__row-t b i { display: block; width: max-content; margin: 4px 0 0; padding: 1px 7px; border-radius: var(--r-pill); box-shadow: inset 0 0 0 1px var(--line-strong); font-style: normal; font-size: 10.5px; font-weight: 400; color: var(--text-3); }
  .mp__row-t small { font-size: 12.5px; color: var(--text-3); }
  .mp__row-n { margin-top: 2px; font-size: 14px; line-height: 1.45; color: var(--text-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .mp__shelf { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 22px 16px; }
  .mp__shelf a { display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: inherit; }
  .mp__shelf .mp__tile { margin-bottom: 8px; transition: transform .2s ease; }
  .mp__shelf a:hover .mp__tile { transform: translateY(-3px); }
  .mp__shelf b { font-size: 15px; font-weight: 500; letter-spacing: -0.01em; }
  .mp__shelf small { font-size: 13px; color: var(--text-3); line-height: 1.4; }
  .mp__shelf--ghost .mp__tile { opacity: .35; box-shadow: none; }
  .mp__shelf--ghost li:not(:first-child) { opacity: .6; }
  .mp__bio { white-space: pre-line; color: var(--text-2); }
  .mp__credits li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; padding: 14px 0; border-bottom: 1px solid var(--c-line); font-size: 15px; }
  .mp__credits li:first-child { border-top: 1px solid var(--c-line); }
  .mp__sec .mp__tags, .mp__sec .mp__links, .mp__sec .mp__list { margin-top: 14px; }
  .mp__svc { display: grid; gap: 8px; }
  .mp__svc li { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 16px 18px; border-radius: 16px; box-shadow: inset 0 0 0 1px var(--line); }
  .mp__svc small { display: block; margin-top: 3px; font-size: 13px; color: var(--text-3); }
  .mp__svc b { font-weight: 500; }
  .mp__fine { margin-top: 10px; font-size: 13px; }
  /* Phones: essentials are a swipeable shelf, like a streaming app. */
  @media (max-width: 600px) {
    .mp__ess:not(.is-one) { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter, 20px); margin-inline: calc(var(--gutter, 20px) * -1); padding: 0 var(--gutter, 20px) 8px; scrollbar-width: none; }
    .mp__ess:not(.is-one)::-webkit-scrollbar { display: none; }
    .mp__ess:not(.is-one) li { flex: 0 0 min(70%, 250px); scroll-snap-align: start; }
  }
  @media (max-width: 600px) { .mp__facts { gap: 6px 18px; } .mp__facts li + li::before { display: none; } }
  @media (max-width: 860px) {
    .mp__banner { border-radius: 16px; }
    .mp__head { padding: 0 4px; }
    .mp__photo { width: 104px; margin-top: -52px; }
    .mp__name { font-size: clamp(1.7rem, 7.5vw, 2.2rem); }
    .mp__actions .btn-app { flex: 1; }
    .mp__inner { padding-bottom: 56px; }
    .mp__ess.is-one a { flex-direction: column; align-items: flex-start; }
    .mp__ess.is-one .mp__ess-cover { width: 100%; }
    .mp__ess.is-one a { align-items: stretch; }
    .mp__ess { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mp__ess.is-one { grid-template-columns: minmax(0, 1fr); }
    .mp__year ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script>
  import '@/scripts/feedback-vote.ts';
  import { bindForm } from '@/scripts/form';
  document.querySelector<HTMLButtonElement>('[data-all-works]')?.addEventListener('click', (e) => { document.querySelector('[data-works]')?.classList.add('is-all'); (e.currentTarget as HTMLElement).remove(); });
  // The bio shows three lines; a tap opens the rest.
  document.querySelector<HTMLElement>('[data-bio]')?.addEventListener('click', (e) => (e.currentTarget as HTMLElement).classList.add('is-open'));
  // Connect: a compact dialog with an optional, editable introduction. Nothing is sent until "Send request".
  const dlg = document.querySelector<HTMLDialogElement>('[data-connect]');
  const form = dlg?.querySelector<HTMLFormElement>('[data-connect-form]');
  const opens = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-connect-open]'));
  const open = opens[0];
  const intro = dlg?.querySelector<HTMLTextAreaElement>('[data-intro]');
  const count = dlg?.querySelector<HTMLElement>('[data-intro-count]');
  intro?.addEventListener('input', () => { if (count) count.textContent = String(intro.value.length); });
  const openDlg = () => { if (!dlg) return; dlg.showModal(); intro?.focus(); intro?.setSelectionRange(intro.value.length, intro.value.length); };
  opens.forEach((b) => b.addEventListener('click', openDlg));
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); }); // click outside the card
  dlg?.querySelector('[data-connect-cancel]')?.addEventListener('click', () => dlg.close());
  dlg?.addEventListener('close', () => open?.focus());
  // Arriving from a World preview's Connect button opens the dialog directly.
  if (new URLSearchParams(location.search).get('connect') === '1' && open) openDlg();
  if (form) bindForm(form, { url: '/api/connections', busyLabel: 'Sending…', onSuccess: () => { location.href = location.pathname; } });


  // Request to work: a small dialog that sends project details to the member.
  const wdlg = document.querySelector<HTMLDialogElement>('[data-work]');
  const wform = wdlg?.querySelector<HTMLFormElement>('[data-work-form]');
  document.querySelectorAll<HTMLButtonElement>('[data-work-open]').forEach((b) => b.addEventListener('click', () => {
    if (!wdlg || !wform) return;
    (wform.elements.namedItem('serviceId') as HTMLInputElement).value = b.dataset.sid!;
    const l = wdlg.querySelector<HTMLElement>('[data-work-service]'); if (l) l.textContent = b.dataset.sname ?? '';
    wdlg.showModal();
  }));
  wdlg?.addEventListener('click', (e) => { if (e.target === wdlg) wdlg.close(); });
  wdlg?.querySelector('[data-work-cancel]')?.addEventListener('click', () => wdlg.close());
  if (wform) bindForm(wform, { url: '/api/hire/request', busyLabel: 'Sending…', onSuccess: () => { wdlg?.close(); const n = document.createElement('p'); n.className = 'mp__note'; n.textContent = 'Request sent. You’ll see their answer in Requests.'; document.querySelector('.mp__head')?.after(n); } });

  // Cancel, accept, decline and remove, right here on the profile.
  const cstatus = document.querySelector<HTMLElement>('[data-conn-status]');
  document.querySelectorAll<HTMLButtonElement>('[data-conn-act]').forEach((b) => b.addEventListener('click', async () => {
    const act = b.dataset.connAct!;
    if (act === 'remove' && !confirm('Remove this connection? You can connect again later.')) return;
    b.disabled = true; if (cstatus) cstatus.textContent = '';
    const r = await fetch(`/api/connections/${b.dataset.connId}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: act }) });
    if (r.ok) { location.href = location.pathname; return; }
    b.disabled = false;
    if (cstatus) cstatus.textContent = (await r.json().catch(() => ({}))).error ?? 'Something went wrong.';
  }));

  document.querySelector<HTMLButtonElement>('[data-block]')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const on = b.dataset.block === 'on';
    if (on && !confirm('Block this member? They won’t be able to send you requests, and any connection between you is removed.')) return;
    const handle = location.pathname.split('/').pop();
    const r = await fetch('/api/connections/block', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ handle, on }) });
    if (r.ok) location.reload();
  });
</script>
