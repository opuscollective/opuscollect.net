---
/**
 * A member's public portfolio: opuscollect.net/<username>.
 * Real pages (/world, /music, …) always match before this route, and their names are reserved
 * (src/server/usernames.ts), so a username can never shadow a page. Anything else that isn't a
 * published profile gets the normal 404.
 */
import PortfolioLayout from '@/layouts/PortfolioLayout.astro';
import VerifiedBadge from '@/components/ui/VerifiedBadge.astro';
import { SITE } from '@/data/site';
import { loadPortfolio, describe } from '@/server/portfolio';
import { relationship } from '@/server/connections';
import { notFound } from '@/server/not-found';
import { PLACE_BY_ID } from '@/data/places';
import { SOCIAL_ICONS } from '@/lib/social-icons';
export const prerender = false;

const param = Astro.params.handle ?? '';
const viewer = Astro.locals.user;
const env = Astro.locals.runtime.env;
const result = await loadPortfolio(env.DB, param, viewer?.id ?? null);
if (!result) return notFound(env, Astro.url);
if ('redirect' in result) return Astro.redirect(result.redirect + Astro.url.search, 301);

const pf = result.portfolio;
const p = pf.profile;
const isOwner = pf.isOwner;
const rel = viewer && !isOwner ? await relationship(env.DB, viewer.id, pf.ownerId) : null;
const path = `/${p.handle}`;
const canonical = new URL(path, SITE.url).href;
const shareUrl = new URL(path, Astro.url.origin).href;
const published = p.status === 'published';
const isProd = env.SITE_ENV === 'production';
const noindex = !published || !p.allowIndexing || !isProd;
if (noindex) Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');
// The owner previews their page inside Customize Your Profile (same-origin frame only).
if (isOwner) Astro.response.headers.set('x-frame-options', 'SAMEORIGIN');

const title = `${p.displayName}${pf.roles[0] ? ` · ${pf.roles[0]}` : ''} · ${SITE.product}`;
const description = describe(pf);
const year = new Date().getFullYear();
const firstName = p.displayName.split(/\s+/)[0];

// Structured data: a ProfilePage about a Person, using only what the member published.
const place = p.placeId ? PLACE_BY_ID.get(p.placeId) : undefined;
const address = pf.where && place && p.locationVisibility !== 'hidden'
  ? { '@type': 'PostalAddress', ...(p.locationVisibility === 'region' ? {} : { addressLocality: p.locationVisibility === 'metro' ? (PLACE_BY_ID.get(place.metroId) ?? place).name : place.name }), addressRegion: place.region || undefined, addressCountry: place.country }
  : undefined;
const jsonLd = published ? {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonical,
  dateModified: new Date(p.updatedAt).toISOString(),
  mainEntity: {
    '@type': 'Person',
    name: p.displayName,
    url: canonical,
    ...(pf.photo ? { image: new URL(pf.photo, SITE.url).href } : {}),
    ...(pf.roles.length ? { jobTitle: pf.roles[0], knowsAbout: pf.roles } : {}),
    ...(p.tagline || p.bio ? { description: p.tagline || p.bio.slice(0, 300) } : {}),
    ...(address ? { homeLocation: { '@type': 'Place', address } } : {}),
    ...(pf.socials.length ? { sameAs: pf.socials.map((s) => s.url) } : {}),
  },
} : null;

const connectHref = '/sign-in?next=' + encodeURIComponent(`${path}?connect=1`);
const bioIsTagline = p.bio.trim() === p.tagline.trim();
---
<PortfolioLayout title={title} description={description} canonical={canonical} image={pf.hero} imageAlt={`Photo of ${p.displayName}`} noindex={noindex} preload={pf.hero} jsonLd={jsonLd}>
  <div slot="bar" class="pf-bar">
    <a class="pf-bar__mark" href="/" aria-label="Opus home">Opus</a>
    <div class="pf-bar__right">
      {isOwner && <a class="pf-chip" href="/account/profile#customize" target="_top">Customize</a>}
      <button class="pf-icon" type="button" data-share data-url={shareUrl} data-title={p.displayName} aria-label="Share this profile">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3.5M7.5 8 12 3.5 16.5 8"/><path d="M5 12.5V19a1.5 1.5 0 0 0 1.5 1.5h11A1.5 1.5 0 0 0 19 19v-6.5"/></svg>
      </button>
      {viewer && !isOwner && (
        <details class="pf-more">
          <summary class="pf-icon" aria-label="More actions"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor"><circle cx="5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="19" cy="12" r="1.7"/></svg></summary>
          <div><button type="button" data-block={rel?.state === 'blocked' ? 'off' : 'on'} data-handle={p.handle}>{rel?.state === 'blocked' ? 'Unblock' : 'Block'} {p.displayName}</button></div>
        </details>
      )}
    </div>
  </div>

  {isOwner && !published && (
    <p class="pf-draft"><b>Draft.</b> Only you can see this page. Publish it from <a href="/account/profile#visibility" target="_top">Customize Your Profile</a>.</p>
  )}

  <article class="pf" itemscope itemtype="https://schema.org/Person">
    <header class:list={['pf-hero', { 'pf-hero--empty': !pf.hero, 'pf-hero--mono': p.coverMono }]} style={`--focus:${p.coverFocus}`}>
      {pf.hero ? (
        <img class="pf-hero__img" src={pf.hero} alt={`Photo of ${p.displayName}`} fetchpriority="high" decoding="async" itemprop="image" />
      ) : (
        <div class="pf-hero__default" aria-hidden="true"><span>{p.displayName.slice(0, 1).toUpperCase()}</span></div>
      )}
      <h1 class="pf-name"><span itemprop="name">{p.displayName}</span>{p.verification === 'verified' && <a class="pf-name__badge" href="/verified" title="Opus Verified: earned, never bought"><VerifiedBadge size={30} /></a>}</h1>
    </header>

    <div class="pf-col">
      {(pf.roles[0] || pf.where) && (
        <p class="pf-meta">
          {pf.roles[0] && <span itemprop="jobTitle">{pf.roles[0]}</span>}
          {pf.where && (pf.worldHref ? <a href={pf.worldHref} title={`Find people in ${pf.where} on World`}>{pf.whereShort}</a> : <span>{pf.whereShort}</span>)}
        </p>
      )}
      {p.tagline && <p class="pf-tagline" itemprop="description">{p.tagline}</p>}

      {pf.socials.length > 0 && (
        <nav class="pf-socials" aria-label={`${p.displayName} elsewhere`}>
          {pf.socials.map((s) => <a href={s.url} target="_blank" rel="noopener me" aria-label={s.label} title={s.label} class={`pf-socials__${s.key}`} set:html={SOCIAL_ICONS[s.key]} />)}
        </nav>
      )}

      <div class="pf-actions">
        {isOwner ? (
          <a class="pf-btn" href="/account/profile#customize" target="_top">Customize your profile</a>
        ) : !viewer ? (
          p.openToCollab ? <a class="pf-btn" href={connectHref}>Connect</a> : <a class="pf-btn" href={pf.worldHref ?? '/world'}>Explore World</a>
        ) : rel?.state === 'connected' ? (
          <a class="pf-btn pf-btn--ghost" href="/account/connections">Connected</a>
        ) : rel?.state === 'sent' ? (
          <a class="pf-btn pf-btn--ghost" href="/account/connections">Request sent</a>
        ) : rel?.state === 'received' ? (
          <a class="pf-btn" href="/account/connections">Respond to request</a>
        ) : rel?.state === 'none' && p.openToCollab ? (
          <button class="pf-btn" type="button" data-connect-open>Connect</button>
        ) : (
          <a class="pf-btn pf-btn--ghost" href={pf.worldHref ?? '/world'}>Explore World</a>
        )}
        <button class="pf-btn pf-btn--ghost" type="button" data-copy={shareUrl}><span data-copy-label>Copy link</span></button>
      </div>
      <p class:list={['pf-avail', { 'is-on': p.openToCollab }]}>{p.openToCollab ? 'Open to collaborate' : 'Not taking new collaborations'}</p>

      {viewer && !isOwner && rel?.state === 'none' && p.openToCollab && (
        <form class="pf-connect" data-connect hidden novalidate>
          <h2>Connect with {p.displayName}</h2>
          <p>Say who you are and what you’d like to make together. If {firstName} accepts, you’ll both see each other’s email.</p>
          <input type="hidden" name="to" value={p.handle} />
          <label><span class="sr-only">Introduction</span>
            <textarea name="message" maxlength="600" rows="4" placeholder="Hi, I’m a producer in Atlanta working on an R&B EP. I’d love a topline on one track…"></textarea>
          </label>
          <div data-status class="pf-connect__status" role="status"></div>
          <div class="pf-connect__row"><button class="pf-btn" type="submit">Send request</button><button class="pf-btn pf-btn--ghost" type="button" data-connect-cancel>Cancel</button></div>
        </form>
      )}
    </div>

    {(pf.featured.length > 0 || isOwner) && (
      <section class="pf-work" aria-labelledby="pf-work-h">
        <h2 class="pf-label" id="pf-work-h">Featured</h2>
        {pf.featured.length === 0 ? (
          <p class="pf-empty">Your best work goes here. Add releases in <a href="/music" target="_top">Music</a>, or feature videos, photos and projects in <a href="/account/profile#featured" target="_top">Customize Your Profile</a>.</p>
        ) : (
          <ul class:list={['pf-grid', { 'pf-grid--one': pf.featured.length === 1 }]} role="list">
            {pf.featured.map((f, i) => {
              const inner = (
                <>
                  <span class:list={['pf-art', { 'pf-art--empty': !f.image }]}>
                    {f.image ? <img src={f.image} alt={`${f.title} artwork`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" width="1000" height="1000" /> : <span>{f.title}</span>}
                  </span>
                  <span class="pf-cap">{f.caption}</span>
                  {f.meta && <span class="pf-cap2">{f.meta}</span>}
                </>
              );
              return <li>{f.href ? <a class="pf-item" href={f.href} {...(f.external ? { target: '_blank', rel: 'noopener nofollow ugc' } : {})}>{inner}</a> : <div class="pf-item">{inner}</div>}</li>;
            })}
          </ul>
        )}
      </section>
    )}

    {pf.links.length > 0 && (
      <section class="pf-links" aria-labelledby="pf-links-h">
        <h2 class="pf-label" id="pf-links-h">Links</h2>
        <ul role="list">
          {pf.links.map((l) => (
            <li><a href={l.url} target="_blank" rel="noopener nofollow ugc"><span>{l.title}</span><small>{l.host}</small><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg></a></li>
          ))}
        </ul>
      </section>
    )}

    {((p.bio && !bioIsTagline) || pf.roles.length > 1 || p.genres.length > 0) && (
      <section class="pf-about" aria-labelledby="pf-about-h">
        <h2 class="pf-label" id="pf-about-h">About</h2>
        {p.bio && !bioIsTagline && <p class="pf-bio">{p.bio}</p>}
        <dl class="pf-facts">
          {pf.roles.length > 0 && <div><dt>Specialties</dt><dd>{pf.roles.join(' · ')}</dd></div>}
          {p.genres.length > 0 && <div><dt>Genres</dt><dd>{p.genres.join(' · ')}</dd></div>}
          {pf.where && <div><dt>Based in</dt><dd>{pf.worldHref ? <a href={pf.worldHref}>{pf.where}</a> : pf.where}</dd></div>}
        </dl>
      </section>
    )}

    {pf.credits.length > 0 && (
      <section class="pf-credits" aria-labelledby="pf-credits-h">
        <h2 class="pf-label" id="pf-credits-h">Credits</h2>
        <ul role="list">
          {pf.credits.map((c) => (
            <li>
              {c.href ? <a href={c.href} {...(c.source === 'self' ? { target: '_blank', rel: 'noopener nofollow ugc' } : {})}>{c.title}</a> : <span>{c.title}</span>}
              <small>{c.detail}</small>
              <em>{c.source === 'confirmed' ? 'Confirmed on Opus' : `Listed by ${firstName}`}</em>
            </li>
          ))}
        </ul>
      </section>
    )}

    <a class="pf-opus" href={viewer ? (pf.worldHref ?? '/world') : '/sign-up'}>
      {viewer ? <>Find more people on <span class="hl">World.</span></> : <>Make your own <span class="hl">Opus.</span></>}<svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <small>{viewer ? 'People, studios and sessions near you' : 'Your music, your work, one link'}</small>
    </a>

    <footer class="pf-foot">© {year} {p.displayName}{pf.whereShort && ` · ${pf.whereShort}`}<span aria-hidden="true"> · </span><a href="/">Opus</a></footer>
  </article>
  <div class="pf-toast" data-toast role="status" aria-live="polite"></div>
</PortfolioLayout>

<script>
  import { bindForm } from '@/scripts/form';

  const toast = document.querySelector<HTMLElement>('[data-toast]')!;
  let tt = 0;
  const say = (msg: string) => { toast.textContent = msg; toast.classList.add('is-on'); clearTimeout(tt); tt = window.setTimeout(() => toast.classList.remove('is-on'), 2200); };

  async function copy(url: string) {
    try { await navigator.clipboard.writeText(url); return true; } catch {
      const t = document.createElement('textarea'); t.value = url; t.setAttribute('readonly', ''); t.style.position = 'fixed'; t.style.opacity = '0';
      document.body.append(t); t.select(); const ok = document.execCommand('copy'); t.remove(); return ok;
    }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    const ok = await copy(b.dataset.copy!);
    const label = b.querySelector('[data-copy-label]');
    if (label && ok) { label.textContent = 'Copied'; setTimeout(() => (label.textContent = 'Copy link'), 1800); }
    say(ok ? 'Link copied' : b.dataset.copy!);
  }));
  // Share sheet on phones; copy on desktop.
  document.querySelector<HTMLButtonElement>('[data-share]')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const url = b.dataset.url!;
    if (navigator.share && matchMedia('(pointer: coarse)').matches) {
      try { await navigator.share({ title: b.dataset.title, url }); return; } catch { /* closed */ return; }
    }
    say((await copy(url)) ? 'Link copied' : url);
  });

  const form = document.querySelector<HTMLFormElement>('[data-connect]');
  const open = document.querySelector<HTMLButtonElement>('[data-connect-open]');
  const show = () => { if (form) { form.hidden = false; form.scrollIntoView({ block: 'center', behavior: 'smooth' }); form.querySelector('textarea')?.focus({ preventScroll: true }); } };
  open?.addEventListener('click', show);
  // Arriving from World (or after signing in) with ?connect=1 opens the introduction straight away.
  if (new URLSearchParams(location.search).get('connect') === '1' && open && form) show();
  document.querySelector('[data-connect-cancel]')?.addEventListener('click', () => { if (form) form.hidden = true; });
  if (form) bindForm(form, { url: '/api/connections', busyLabel: 'Sending…', onSuccess: () => location.replace(location.pathname) });

  document.querySelector<HTMLButtonElement>('[data-block]')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const on = b.dataset.block === 'on';
    if (on && !confirm('Block this member? They won’t be able to send you requests, and any connection between you is removed.')) return;
    const r = await fetch('/api/connections/block', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ handle: b.dataset.handle, on }) });
    if (r.ok) location.reload();
  });
</script>
