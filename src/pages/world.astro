---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SPECIALTIES } from '@/data/specialties';
import { GENRES } from '@/data/genres';
import { CITIES } from '@/data/cities';
import '@/styles/world.css';

---
<BaseLayout
  title="Opus World"
  description="Explore independent musicians, recording studios and music organizations on an interactive map of the world."
  hideFooter
>
  <div class="world" data-world>
    <h1 class="sr-only">Opus World</h1>

    <div class="world__map" data-map aria-label="Interactive map of Opus members. Use the list for keyboard navigation." role="region">
      <div class="world__loading" data-map-loading><span class="t-meta">Loading the world…</span></div>
      <p class="world__nogl" data-map-fallback hidden>
        Your browser can’t show the interactive map, so results are listed only. Everything else works the same.
      </p>
    </div>

    <aside class="world__panel" data-panel aria-label="Directory results">
      <button class="world__grip" type="button" data-sheet-toggle aria-expanded="false" aria-controls="world-results">
        <span class="sr-only">Show or hide results</span><i aria-hidden="true"></i>
      </button>

      <div class="wp__head">
        <form class="wp__search" data-city-form role="search" autocomplete="off">
          <label for="w-city" class="sr-only">Search a city, region or country</label>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4.3-4.3"/></svg>
          <input id="w-city" name="city" type="search" placeholder="Search a city or country" list="w-cities" />
          <datalist id="w-cities">{CITIES.map((c) => <option value={c.name}>{c.region ? `${c.region}, ` : ''}{c.countryName}</option>)}</datalist>
          <button type="submit">Go</button>
        </form>

        <div class="wp__kinds" role="radiogroup" aria-label="Listing type" data-kinds>
          <button type="button" role="radio" aria-checked="true" data-kind="">All</button>
          <button type="button" role="radio" aria-checked="false" data-kind="musician">Musicians</button>
          <button type="button" role="radio" aria-checked="false" data-kind="studio">Studios</button>
          <button type="button" role="radio" aria-checked="false" data-kind="organization">Organizations</button>
        </div>

        <div class="wp__filters">
          <label class="wp__field" data-only="musician">
            <span class="sr-only">Specialty</span>
            <select data-specialty>
              <option value="">All Specialties</option>
              {Object.entries(SPECIALTIES).map(([k, d]) => <option value={k}>{d.plural}</option>)}
            </select>
          </label>
          <label class="wp__field" data-only="musician">
            <span class="sr-only">Genre</span>
            <select data-genre>
              <option value="">All Genres</option>
              {GENRES.map((g) => <option value={g}>{g}</option>)}
            </select>
          </label>
          <label class="wp__field" data-only="studio" hidden>
            <span class="sr-only">Studio type</span>
            <select data-studio-type>
              <option value="">Any studio</option>
              <option value="commercial">Commercial studios</option>
              <option value="home">Home studios</option>
              <option value="remote">Remote services</option>
            </select>
          </label>
          <label class="wp__field wp__field--grow">
            <span class="sr-only">Search by name, specialty or genre</span>
            <input type="search" data-text placeholder="Search by specialty, name or genre" />
          </label>
          <label class="wp__toggle"><input type="checkbox" data-verified /> <span>Verified</span></label>
          <label class="wp__toggle" data-only="musician"><input type="checkbox" data-collab /> <span>Open to collab</span></label>
        </div>
      </div>

      <dl class="wp__stats" aria-label="Opus World statistics" data-stats hidden>
        <div><dt>Musicians</dt><dd data-stat="musicians">0</dd></div>
        <div><dt>Studios</dt><dd data-stat="studios">0</dd></div>
        <div><dt>Countries</dt><dd data-stat="countries">0</dd></div>
        <div><dt>Verified</dt><dd data-stat="verified">0</dd></div>
        <div><dt>Orgs</dt><dd data-stat="organizations">0</dd></div>
        <p class="wp__sample t-meta" data-sample-note hidden>Preview build · includes labeled sample listings</p>
      </dl>

      <div class="wp__bar">
        <p class="wp__count" data-count aria-live="polite">Loading members…</p>
        <label class="wp__sort"><span class="sr-only">Sort</span>
          <select data-sort>
            <option value="recommended">Recommended</option>
            <option value="name">Name A–Z</option>
            <option value="recent">Recently added</option>
            <option value="rate">Lowest hourly rate</option>
          </select>
        </label>
      </div>
      <label class="wp__inview"><input type="checkbox" data-inview checked /> Update results as I move the map</label>

      <div class="wp__results" id="world-results" data-results tabindex="-1">
        {[0, 1, 2, 3].map(() => <div class="wc wc--skeleton" aria-hidden="true"><span></span><span></span></div>)}
      </div>
      <div class="wp__empty" data-empty hidden>
        <p><b data-empty-title>No listings here yet.</b></p>
        <p data-empty-body>Try zooming out, clearing filters, or searching a nearby city. Opus is just opening, so new members appear here first.</p>
        <button type="button" data-clear>Clear filters</button>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  import { cardHtml, matches, isVerified, type WorldFilters } from '@/lib/world';
  import type { WorldStats } from '@/lib/world';
  import { findCity } from '@/data/cities';
  import { toSpecialty } from '@/data/specialties';
  import type { Listing } from '@/types/directory';
  import type { WorldMapApi } from '@/scripts/world-map';

  const root = document.querySelector<HTMLElement>('[data-world]')!;
  const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const results = $('[data-results]');
  const empty = $('[data-empty]');
  const count = $('[data-count]');
  const panel = $('[data-panel]');
  let ALL: Listing[] = [];
  let byId = new Map<string, Listing>();
  let loaded = false;

  const f: WorldFilters = { kinds: [], specialty: '', genre: '', openToCollab: false, studioType: '', verifiedOnly: false, text: '' };
  let sort = 'recommended';
  let inView = true;
  let active: string | null = null;
  let map: WorldMapApi | null = null;
  let cityLabel = '';

  // ---------- URL state ----------
  const params = new URLSearchParams(location.search);
  const t = params.get('type');
  if (t === 'musician' || t === 'studio' || t === 'organization') f.kinds = [t];
  f.text = params.get('q') ?? '';
  f.specialty = toSpecialty(params.get('specialty') ?? params.get('discipline')); // "discipline" kept for old links
  f.genre = params.get('genre') ?? '';
  f.openToCollab = params.get('collab') === '1';
  f.verifiedOnly = params.get('verified') === '1';
  ($<HTMLInputElement>('[data-text]')).value = f.text;
  ($<HTMLSelectElement>('[data-specialty]')).value = f.specialty ?? '';
  ($<HTMLSelectElement>('[data-genre]')).value = f.genre ?? '';
  ($<HTMLInputElement>('[data-collab]')).checked = !!f.openToCollab;
  ($<HTMLInputElement>('[data-verified]')).checked = f.verifiedOnly;

  function writeUrl() {
    const u = new URL(location.href);
    const set = (k: string, v?: string) => (v ? u.searchParams.set(k, v) : u.searchParams.delete(k));
    set('type', f.kinds[0]); set('q', f.text); set('specialty', f.specialty || ''); set('genre', f.genre); set('collab', f.openToCollab ? '1' : ''); set('verified', f.verifiedOnly ? '1' : ''); set('city', cityLabel);
    history.replaceState(null, '', u);
  }

  // ---------- Filtering + rendering ----------
  function visible(): Listing[] {
    let ls = ALL.filter((l) => matches(l, f));
    if (map && inView && map.getZoom() >= 4) {
      const b = map.getBounds();
      ls = ls.filter((l) => b.contains([l.location.lng, l.location.lat]));
    }
    const score = (l: Listing) => (isVerified(l) ? 0 : 1);
    ls.sort((a, b) => {
      if (sort === 'name') return a.name.localeCompare(b.name);
      if (sort === 'recent') return b.id.localeCompare(a.id);
      if (sort === 'rate') {
        const ra = a.kind === 'studio' ? a.hourlyRate?.amount ?? 1e9 : 1e9;
        const rb = b.kind === 'studio' ? b.hourlyRate?.amount ?? 1e9 : 1e9;
        return ra - rb;
      }
      // Recommended: verified first, then a fair mix of kinds (not paid placement).
      return score(a) - score(b) || a.id.localeCompare(b.id);
    });
    return ls;
  }

  function render(updateMap = true) {
    if (!loaded) return;
    const ls = visible();
    results.innerHTML = ls.map(cardHtml).join('');
    empty.hidden = ls.length > 0;
    const where = map && inView && map.getZoom() >= 4 ? (cityLabel ? `in ${cityLabel} area` : 'in this map area') : 'worldwide';
    count.textContent = ALL.length === 0 ? 'No members yet' : `${ls.length} result${ls.length === 1 ? '' : 's'} ${where}`;
    if (active) results.querySelector(`[data-id="${active}"]`)?.classList.add('is-active');
    if (updateMap) map?.setData(ALL.filter((l) => matches(l, f)));
    writeUrl();
  }

  // ---------- Controls ----------
  root.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((b) =>
    b.addEventListener('click', () => {
      root.querySelectorAll('[data-kind]').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
      const k = b.dataset.kind as WorldFilters['kinds'][number] | '';
      f.kinds = k ? [k] : [];
      root.querySelectorAll<HTMLElement>('[data-only]').forEach((el) => (el.hidden = !!k && el.dataset.only !== k));
      if (k && k !== 'musician') {
        f.specialty = ''; f.genre = ''; f.openToCollab = false;
        ($<HTMLSelectElement>('[data-specialty]')).value = ''; ($<HTMLSelectElement>('[data-genre]')).value = ''; ($<HTMLInputElement>('[data-collab]')).checked = false;
      }
      if (k !== 'studio') { f.studioType = ''; ($<HTMLSelectElement>('[data-studio-type]')).value = ''; }
      render();
    }),
  );
  if (f.kinds[0]) root.querySelector<HTMLButtonElement>(`[data-kind="${f.kinds[0]}"]`)?.click();

  $<HTMLSelectElement>('[data-specialty]').addEventListener('change', (e) => { f.specialty = toSpecialty((e.target as HTMLSelectElement).value); render(); });
  $<HTMLSelectElement>('[data-genre]').addEventListener('change', (e) => { f.genre = (e.target as HTMLSelectElement).value; render(); });
  $<HTMLInputElement>('[data-collab]').addEventListener('change', (e) => { f.openToCollab = (e.target as HTMLInputElement).checked; render(); });
  $<HTMLSelectElement>('[data-studio-type]').addEventListener('change', (e) => { f.studioType = (e.target as HTMLSelectElement).value as WorldFilters['studioType']; render(); });
  $<HTMLInputElement>('[data-verified]').addEventListener('change', (e) => { f.verifiedOnly = (e.target as HTMLInputElement).checked; render(); });
  $<HTMLSelectElement>('[data-sort]').addEventListener('change', (e) => { sort = (e.target as HTMLSelectElement).value; render(); });
  $<HTMLInputElement>('[data-inview]').addEventListener('change', (e) => { inView = (e.target as HTMLInputElement).checked; render(); });
  let tt = 0;
  $<HTMLInputElement>('[data-text]').addEventListener('input', (e) => { clearTimeout(tt); tt = window.setTimeout(() => { f.text = (e.target as HTMLInputElement).value; render(); }, 160); });
  $('[data-clear]').addEventListener('click', () => {
    f.kinds = []; f.specialty = ''; f.genre = ''; f.openToCollab = false; f.studioType = ''; f.verifiedOnly = false; f.text = '';
    ($<HTMLSelectElement>('[data-specialty]')).value = ''; ($<HTMLSelectElement>('[data-genre]')).value = ''; ($<HTMLInputElement>('[data-collab]')).checked = false;
    root.querySelector<HTMLButtonElement>('[data-kind=""]')?.click();
    ($<HTMLInputElement>('[data-verified]')).checked = false; ($<HTMLInputElement>('[data-text]')).value = '';
    render();
  });

  // City search → globe turns and zooms to the city; results follow the map.
  function goCity(q: string) {
    const c = findCity(q);
    if (!c) { count.textContent = `We couldn’t find “${q}”. Try a major city or country.`; return; }
    cityLabel = c.name;
    ($<HTMLInputElement>('#w-city')).value = c.name;
    if (map) map.flyToCity(c.lat, c.lng);
    else { f.text = c.name; render(); }
    setSheet(true);
  }
  $<HTMLFormElement>('[data-city-form]').addEventListener('submit', (e) => {
    e.preventDefault();
    goCity(($<HTMLInputElement>('#w-city')).value);
  });

  // ---------- Card ↔ marker linking ----------
  function select(id: string, fromMap: boolean) {
    active = id;
    results.querySelectorAll('.wc.is-active').forEach((x) => x.classList.remove('is-active'));
    const card = results.querySelector<HTMLElement>(`[data-id="${id}"]`);
    card?.classList.add('is-active');
    map?.setActive(id);
    if (fromMap) { setSheet(true); card?.scrollIntoView({ behavior: 'smooth', block: mobile.matches ? 'start' : 'nearest' }); card?.focus({ preventScroll: true }); }
    else { const l = byId.get(id); if (l && map) map.flyToListing(l); }
  }
  results.addEventListener('click', (e) => { const c = (e.target as Element).closest<HTMLElement>('.wc'); if (c) select(c.dataset.id!, false); });
  results.addEventListener('keydown', (e) => { if (e.key === 'Enter') { const c = (e.target as Element).closest<HTMLElement>('.wc'); if (c) select(c.dataset.id!, false); } });
  results.addEventListener('pointerover', (e) => { const c = (e.target as Element).closest<HTMLElement>('.wc'); map?.setHover(c?.dataset.id ?? null); });
  results.addEventListener('pointerleave', () => map?.setHover(null));

  // ---------- Mobile bottom sheet: drag between peek, half and full ----------
  type Sheet = 'peek' | 'half' | 'full';
  const toggle = $<HTMLButtonElement>('[data-sheet-toggle]');
  const mobile = matchMedia('(max-width: 860px)');
  let sheet: Sheet = 'peek';
  const peekPx = () => parseFloat(getComputedStyle(root).getPropertyValue('--peek')) || 136;
  const sheetY = (st: Sheet) => {
    const h = panel.offsetHeight;
    return st === 'full' ? 0 : st === 'half' ? Math.round(h * 0.45) : h - peekPx();
  };
  function setSheet(st: Sheet | boolean) {
    if (typeof st === 'boolean') st = st ? 'half' : 'peek';
    sheet = st;
    panel.dataset.sheet = st;
    panel.classList.toggle('is-open', st !== 'peek');
    toggle.setAttribute('aria-expanded', String(st !== 'peek'));
    if (mobile.matches) panel.style.setProperty('--sheet-y', `${sheetY(st)}px`);
    else panel.style.removeProperty('--sheet-y');
    if (st !== 'full') panel.scrollTop = 0;
  }
  toggle.addEventListener('click', (e) => {
    if (dragMoved) { e.preventDefault(); return; }
    setSheet(sheet === 'peek' ? 'half' : sheet === 'half' ? 'full' : 'peek');
  });
  // Drag the sheet by its grip, or from anywhere on it while it isn't fully open (like a maps app).
  // Taps on inputs and buttons still work normally.
  let dragStart = -1, dragBase = 0, dragMoved = false, lastY = 0, lastT = 0, vel = 0;
  panel.addEventListener('pointerdown', (e) => {
    if (!mobile.matches || e.button > 0) return;
    if (sheet === 'full' && !toggle.contains(e.target as Node)) return;
    dragStart = e.clientY; dragBase = sheetY(sheet); dragMoved = false; lastY = e.clientY; lastT = e.timeStamp; vel = 0;
  });
  window.addEventListener('pointermove', (e) => {
    if (dragStart < 0) return;
    const dy = e.clientY - dragStart;
    if (!dragMoved && Math.abs(dy) < 6) return;
    if (!dragMoved) { dragMoved = true; panel.classList.add('is-dragging'); (document.activeElement as HTMLElement | null)?.blur?.(); }
    const y = Math.max(0, Math.min(panel.offsetHeight - peekPx(), dragBase + dy));
    panel.style.setProperty('--sheet-y', `${y}px`);
    vel = (e.clientY - lastY) / Math.max(1, e.timeStamp - lastT); lastY = e.clientY; lastT = e.timeStamp;
  });
  const endDrag = () => {
    if (dragStart < 0) return;
    dragStart = -1;
    if (!dragMoved) return;
    panel.classList.remove('is-dragging');
    const y = parseFloat(panel.style.getPropertyValue('--sheet-y')) || 0;
    const order: Sheet[] = ['full', 'half', 'peek'];
    let next = order.reduce((a, b) => (Math.abs(sheetY(b) - y) < Math.abs(sheetY(a) - y) ? b : a));
    if (Math.abs(vel) > 0.5) { // a flick moves one step in its direction
      const i = order.indexOf(sheet);
      next = order[Math.max(0, Math.min(2, i + (vel > 0 ? 1 : -1)))]!;
    }
    setSheet(next);
    setTimeout(() => (dragMoved = false), 0);
  };
  // A drag that ends over a card must not also select it.
  panel.addEventListener('click', (e) => { if (dragMoved) { e.stopPropagation(); e.preventDefault(); } }, true);
  window.addEventListener('pointerup', endDrag);
  window.addEventListener('pointercancel', endDrag);
  // Scrolling the results from half height opens the sheet fully, so the list is never cut off.
  panel.addEventListener('wheel', (e) => { if (mobile.matches && sheet !== 'full' && e.deltaY > 0) setSheet('full'); }, { passive: true });
  let touchY = 0;
  // In full view, pulling down at the top of the list returns to half height.
  panel.addEventListener('touchmove', (e) => {
    if (mobile.matches && sheet === 'full' && panel.scrollTop <= 0 && (e.touches[0]?.clientY ?? 0) - touchY > 60) setSheet('half');
  }, { passive: true });
  panel.addEventListener('touchstart', (e) => { touchY = e.touches[0]?.clientY ?? 0; }, { passive: true });
  mobile.addEventListener('change', () => setSheet(sheet));
  addEventListener('resize', () => { if (mobile.matches) setSheet(sheet); });
  setSheet('peek');

  // ---------- Map boot (lazy, with fallback) ----------
  const host = $('[data-map]');
  const hasWebGL = () => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } };
  async function boot() {
    if (!hasWebGL()) { $('[data-map-loading]').remove(); $('[data-map-fallback]').hidden = false; root.classList.add('is-nomap'); render(); return; }
    try {
      const { mountWorldMap } = await import('@/scripts/world-map');
      map = await mountWorldMap(host, ALL.filter((l) => matches(l, f)), {
        onSelect: (id) => select(id, true),
        onMove: () => { if (inView) render(false); },
      }, { padBottom: mobile.matches ? peekPx() : 0 });
      root.classList.add('is-ready');
      $('[data-map-loading]').remove();
      const qc = params.get('city');
      render(false);
      if (qc) goCity(qc);
    } catch (err) {
      console.error('Map failed to load', err);
      $('[data-map-loading]').remove(); $('[data-map-fallback]').hidden = false; root.classList.add('is-nomap'); render();
    }
  }
  // ---------- Data: real published members from the directory API ----------
  async function load() {
    try {
      const r = await fetch('/api/world');
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const d = (await r.json()) as { listings: Listing[]; stats: WorldStats; includesSample: boolean };
      ALL = d.listings;
      byId = new Map(ALL.map((l) => [l.id, l]));
      const st = $('[data-stats]');
      for (const [k, v] of Object.entries(d.stats)) { const el = st.querySelector(`[data-stat="${k}"]`); if (el) el.textContent = String(v); }
      st.hidden = ALL.length === 0;
      $('[data-sample-note]').hidden = !d.includesSample;
      if (ALL.length === 0) {
        $('[data-empty-title]').textContent = 'Opus World is just opening.';
        $('[data-clear]').hidden = true;
        $('[data-empty-body]').innerHTML = 'Members appear here as soon as they publish a profile. <a class="link" href="/sign-up">Create yours</a> and be one of the first on the map.';
      }
    } catch (err) {
      console.error('Could not load Opus World', err);
      $('[data-empty-title]').textContent = 'We couldn’t load Opus World.';
      $('[data-empty-body]').textContent = 'Check your connection and refresh the page.';
    }
    loaded = true;
    render();
  }
  load().then(boot);
</script>
