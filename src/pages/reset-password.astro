---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/app.css';
export const prerender = false;
const token = Astro.url.searchParams.get('token') ?? '';
---
<BaseLayout title="Choose a new password" noindex>
  <section class="app app--center">
    <div class="app__wrap">
      <p class="t-meta app__kicker">Account</p>
      <h1 class="app__title">Choose a new password.</h1>
      {token ? (
        <form class="form" data-reset novalidate>
          <input type="hidden" name="token" value={token} />
          <label class="field"><span>New password</span>
            <input class="input" name="password" type="password" autocomplete="new-password" required minlength="10" />
            <small>At least 10 characters. Signing in with the new password signs you out on other devices.</small>
          </label>
          <div data-status class="form-status"></div>
          <button class="btn-app btn-app--block" type="submit">Save password</button>
        </form>
      ) : (
        <p class="app__lead">This link is missing its code. <a class="link" href="/forgot-password">Request a new reset link</a>.</p>
      )}
    </div>
  </section>
</BaseLayout>
<script>
  import { bindForm } from '@/scripts/form';
  const form = document.querySelector<HTMLFormElement>('[data-reset]');
  if (form) bindForm(form, { url: '/api/auth/reset', busyLabel: 'Saving…', onSuccess: () => { location.href = '/account?reset=1'; } });
</script>
