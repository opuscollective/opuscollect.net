---
/**
 * The musician directory now lives in Opus World. This page keeps old links working:
 * /directory?q=&discipline=&location= → /musicians&q=&specialty=&city=
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Musician Directory" noindex>
  <meta http-equiv="refresh" content="0; url=/musicians" slot="head" />
  <section class="container" style="padding-block: 160px 120px">
    <p>The directory has moved to <a href="/musicians">Opus World</a>.</p>
  </section>
</BaseLayout>
<script>
  const p = new URLSearchParams(location.search);
  const u = new URL('/world', location.origin);
  u.searchParams.set('type', 'musician');
  const q = p.get('q'); if (q) u.searchParams.set('q', q);
  const s = p.get('specialty') ?? p.get('discipline'); if (s) u.searchParams.set('specialty', s);
  const c = p.get('location') ?? p.get('city'); if (c) u.searchParams.set('city', c);
  location.replace(u);
</script>
