---
import { notFound } from '@/server/not-found';
/**
 * Old profile links (/m/<username>) now live at the root (/<username>).
 * Kept forever as a permanent redirect so links already shared keep working.
 */
export const prerender = false;
const handle = (Astro.params.handle ?? '').toLowerCase();
if (!/^[a-z0-9-]{1,40}$/.test(handle)) return notFound(Astro.locals.runtime.env, Astro.url);
return Astro.redirect(`/${handle}${Astro.url.search}`, 301);
---
