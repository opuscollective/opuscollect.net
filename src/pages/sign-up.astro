---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { readInvite } from '@/server/clans';
import '@/styles/app.css';
export const prerender = false;
const raw = Astro.url.searchParams.get('next') ?? '';
const next = /^\/(?!\/)[\w\-/?=&%.]*$/.test(raw) ? raw : '';
const setup = Astro.url.searchParams.get('setup');
// What the person is setting up decides where they land after the account exists. It never locks the account to a type.
const GOALS: Record<string, string> = { individual: '/start', group: '/clans/new' };
const goal = setup && setup in GOALS ? setup : '';
// An invite link: "Create account & join" carries the token here and the Worker adds the membership after sign-up.
const inviteToken = /^[\w-]{8,64}$/.test(Astro.url.searchParams.get('invite') ?? '') ? Astro.url.searchParams.get('invite')! : '';
const inviteClan = inviteToken ? await readInvite(Astro.locals.runtime.env.DB, inviteToken) : null;
const joining = !!inviteClan && Astro.url.searchParams.get('join') === '1';
const after = next || (goal ? GOALS[goal] : '/start');
if (Astro.locals.user) return Astro.redirect(inviteClan ? `/clans/invite/${inviteToken}` : next || (goal ? GOALS[goal] : '/account'));
const choosing = !next && !goal && !joining;
const signInHref = joining ? `/sign-in?invite=${inviteToken}&join=1` : after && after !== '/start' ? `/sign-in?next=${encodeURIComponent(after)}` : '/sign-in';
const OPTIONS = [
  { key: 'individual', title: 'Individual', line: 'Artists and professionals', href: '/sign-up?setup=individual' },
  { key: 'group', title: 'Group', line: 'Bands and collectives', href: '/sign-up?setup=group' },
  { key: 'label', title: 'Label', line: 'Labels and organizations', href: '', soon: true },
];
---
<BaseLayout title="Join Opus" description="Create your Opus account to build your profile and connect with musicians around the world." noindex assistant={false} messages={false}>
  <section class="app app--center">
    <div class="app__wrap su">
      {choosing ? (
        <>
          <h1 class="su__title">What are you setting up on Opus?</h1>
          <ul class="su__opts" role="list">
            {OPTIONS.map((o) => {
              const inner = (
                <>
                  <span class="su__ico" aria-hidden="true">
                    {o.key === 'individual' && <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="15" r="7.5"/><path d="M9 42c0-8.3 6.7-14 15-14s15 5.7 15 14"/></svg>}
                    {o.key === 'group' && <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="17" cy="16" r="6.5"/><circle cx="32" cy="18" r="5.5"/><path d="M4 41c0-7.5 5.8-12.5 13-12.5S30 33.500 30 41"/><path d="M30.500 29c6.500-.6 13.500 3.500 13.500 11.500"/></svg>}
                    {o.key === 'label' && <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M10 43V9.500L30 5v38"/><path d="M30 18l8 3v22"/><path d="M5 43h38"/><path d="M16 15h8M16 21h8M16 27h8M16 33h8M34 28h0M34 34h0" /></svg>}
                  </span>
                  <span class="su__txt"><b>{o.title}</b><small>{o.line}</small></span>
                  {o.soon && <span class="su__soon">Coming soon</span>}
                </>
              );
              return (
                <li>
                  {o.soon ? <div class="su__opt is-soon" aria-disabled="true">{inner}</div> : <a class="su__opt" href={o.href}>{inner}</a>}
                </li>
              );
            })}
          </ul>
          <p class="app__alt">Already a member? <a href="/sign-in">Sign in</a></p>
        </>
      ) : (
        <>
          <p class="t-meta app__kicker"><a class="link" href={joining ? `/clans/invite/${inviteToken}` : '/sign-up'}>← {joining ? 'Back' : 'Change'}</a></p>
          <h1 class="su__title">Create your account.</h1>
          <p class="su__lead">{joining ? `You’ll join ${inviteClan!.name} as soon as your account is ready.` : goal === 'group' ? 'One account, one email. Next, you’ll set up your group.' : 'Your name, what you do and where. It takes a minute.'}</p>

          <form class="form" data-signup data-next={after} data-invite={joining ? inviteToken : ''} novalidate>
            <label class="field"><span>Email</span>
              <input class="input" name="email" type="email" autocomplete="email" required inputmode="email" />
            </label>
            <label class="field"><span>Password</span>
              <input class="input" name="password" type="password" autocomplete="new-password" required minlength="10" />
              <small>At least 10 characters. A short phrase works well.</small>
            </label>
            <label class="field check"><input type="checkbox" name="agree" required />
              <span>I agree to the <a class="link" href="/legal#terms" target="_blank">Terms</a> and <a class="link" href="/legal#privacy" target="_blank">Privacy Policy</a>.</span>
            </label>
            <div data-status class="form-status"></div>
            <button class="btn-app btn-app--block" type="submit">Create account</button>
          </form>
          <p class="app__alt">Already a member? <a href={signInHref}>Sign in</a></p>
        </>
      )}
    </div>
  </section>
</BaseLayout>
<script>
  import { bindForm, values } from '@/scripts/form';
  const form = document.querySelector<HTMLFormElement>('[data-signup]');
  if (form) bindForm(form, {
    url: '/api/auth/register',
    body: (f) => ({ ...values(f), ...(form.dataset.invite ? { invite: form.dataset.invite, join: true } : {}) }),
    busyLabel: 'Creating account…',
    onSuccess: (d) => { location.href = (d.joined as { href?: string } | null)?.href || (form.dataset.invite ? `/clans/invite/${form.dataset.invite}` : form.dataset.next || '/start'); },
  });
</script>
<style>
  /* Account step: Recognition look. Thin display type, a blurred wash, hairline fields, a pill action. */
  .app--center:has([data-signup]) { position: relative; isolation: isolate; overflow: clip; padding-top: clamp(56px, 9vh, 112px); }
  .app--center:has([data-signup])::before { content: ''; position: absolute; z-index: -1; inset: -10% -10% auto; height: 560px; pointer-events: none;
    background: radial-gradient(48% 60% at 28% 20%, rgba(154,174,255,.22), transparent 70%), radial-gradient(40% 50% at 72% 10%, rgba(255,196,160,.16), transparent 70%); filter: blur(40px); }
  .su:has([data-signup]) { max-width: 480px; }
  .su:has([data-signup]) .su__title { font-weight: 300; font-size: clamp(2.4rem, 1.8rem + 2.6vw, 3.6rem); letter-spacing: -0.05em; }
  .su:has([data-signup]) .su__lead { font-weight: 300; color: var(--text-3); margin-bottom: 40px; }
  .su:has([data-signup]) .app__kicker { margin-bottom: 28px; }
  .su:has([data-signup]) .app__kicker a { text-transform: uppercase; letter-spacing: .14em; font-size: 11.5px; color: var(--text-3); text-decoration: none; }
  [data-signup] { display: flex; flex-direction: column; gap: 22px; }
  [data-signup] .field > span { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--text-3); }
  [data-signup] .input { background: transparent; border: 0; border-bottom: 1px solid var(--line-strong); border-radius: 0; padding-left: 0; padding-right: 0; min-height: 48px; font-size: 18px; font-weight: 300; box-shadow: none; }
  [data-signup] .input:focus { background: transparent; border-bottom-color: var(--accent); }
  [data-signup] .field small { font-size: 12.5px; }
  [data-signup] .check { flex-direction: row; align-items: center; gap: 12px; font-size: 13.5px; }
  [data-signup] .check > span { text-transform: none; letter-spacing: 0; font-size: 13.5px; color: var(--text-2); }
  [data-signup] .check input { margin: 0; }
  [data-signup] .btn-app--block { min-height: 54px; border-radius: 999px; font-weight: 400; font-size: 16px; }
  .su { max-width: 560px; }
  .app__wrap.su:has(.su__opts) { max-width: 980px; text-align: center; }
  .su__title { margin: 0; font-size: clamp(2rem, 1.5rem + 2.2vw, 3rem); line-height: 1.05; letter-spacing: -0.045em; font-weight: 500; text-wrap: balance; }
  .su__lead { margin: 14px 0 32px; font-size: 17px; line-height: 1.5; color: var(--text-2); }
  .su__opts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(10px, 1.6vw, 20px); margin: clamp(32px, 5vw, 56px) 0 0; padding: 0; list-style: none; }
  .su__opt { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px; height: 100%; min-height: clamp(200px, 22vw, 280px); padding: 32px 20px; border-radius: 20px; background: var(--surface); color: var(--text); box-shadow: var(--ds-elev-1, 0 0 0 1px var(--line-faint));
    transition: transform var(--m-card) var(--m-ease), box-shadow var(--m-card) var(--m-ease), background var(--m-hover) var(--m-ease); }
  a.su__opt:hover { transform: translateY(-3px); box-shadow: var(--ds-elev-2, 0 18px 40px -20px rgba(0,0,0,.4)); }
  a.su__opt:active { transform: translateY(-1px); }
  a.su__opt:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .su__ico { display: grid; place-items: center; width: 64px; height: 64px; color: var(--text); transition: transform var(--m-card) var(--m-ease); }
  .su__ico svg { width: 100%; height: 100%; }
  a.su__opt:hover .su__ico { transform: scale(1.06); }
  .su__txt { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .su__txt b { font-size: 24px; font-weight: 300; letter-spacing: -0.03em; }
  .su__txt small { font-size: 14px; line-height: 1.4; color: var(--text-3); }
  .su__opt.is-soon .su__ico, .su__opt.is-soon .su__txt { opacity: 0.45; }
  .su__soon { position: absolute; top: 14px; right: 14px; padding: 3px 9px; border-radius: 999px; font-size: 11.5px; font-weight: 500; color: var(--text-2); box-shadow: inset 0 0 0 1px var(--line); }
  @media (max-width: 720px) {
    .su__opts { grid-template-columns: 1fr; gap: 10px; }
    .su__opt { flex-direction: row; justify-content: flex-start; gap: 18px; min-height: 0; height: auto; padding: 18px 20px; text-align: left; }
    .su__ico { width: 44px; height: 44px; flex: none; }
    .su__soon { top: 50%; right: 16px; transform: translateY(-50%); }
  }
</style>
