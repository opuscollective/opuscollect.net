---
/**
 * The standalone Opus Collective page is retired. Opus Collective is a Group on Opus now: its catalog and artists
 * are seen inside the group's own page. If that group isn't created yet, visitors land on About.
 */
import { getClanByHandle } from '@/server/clans';
export const prerender = false;

const db = Astro.locals.runtime.env.DB;
// The handle opus-collective is reserved, so the group may carry a suffix: find it by name too.
const byName = await db.prepare("SELECT p.handle FROM profiles p JOIN clan_details d ON d.profile_id = p.id WHERE lower(p.display_name) = 'opus collective' AND p.status = 'published' ORDER BY p.created_at LIMIT 1").first<{ handle: string }>().catch(() => null);
const clan = await getClanByHandle(db, byName?.handle ?? 'opus-collective').catch(() => null);
return Astro.redirect(clan && clan.status === 'published' ? clan.href : '/about', 301);
---
