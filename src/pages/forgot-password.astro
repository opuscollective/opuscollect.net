---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/app.css';
export const prerender = false;
---
<BaseLayout title="Reset your password" noindex>
  <section class="app app--center">
    <div class="app__wrap">
      <p class="t-meta app__kicker">Account</p>
      <h1 class="app__title">Forgot your password?</h1>
      <p class="app__lead">Enter the email you signed up with. If it belongs to an Opus account, we’ll send a link to choose a new password.</p>
      <form class="form" data-forgot novalidate>
        <label class="field"><span>Email</span>
          <input class="input" name="email" type="email" autocomplete="email" required inputmode="email" />
        </label>
        <div data-status class="form-status"></div>
        <button class="btn-app btn-app--block" type="submit">Send reset link</button>
      </form>
      <p class="app__alt"><a href="/sign-in">Back to sign in</a></p>
    </div>
  </section>
</BaseLayout>
<script>
  import { bindForm, status } from '@/scripts/form';
  const form = document.querySelector<HTMLFormElement>('[data-forgot]')!;
  bindForm(form, {
    url: '/api/auth/forgot', busyLabel: 'Sending…',
    onSuccess: () => status(form, 'If that email has an Opus account, a reset link is on its way. It works for 1 hour. Check your spam folder if you don’t see it.', 'ok'),
  });
</script>
