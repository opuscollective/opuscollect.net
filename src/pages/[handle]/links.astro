---
/** The member's link-in-bio page: opuscollect.net/<handle>/links. One compact page for any social profile. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SPECIALTIES, allSpecialties } from '@/data/specialties';
import { canShowcase, showcasePicks } from '@/lib/showcase';
import { visibleLabel } from '@/data/places';
import { getPublicProfile, mediaUrl } from '@/server/profiles';
import { profileReleases } from '@/server/releases';
import { getPageConfig } from '@/server/page-config';
import { RELEASE_KINDS } from '@/data/music';
import FounderMark from '@/components/ui/FounderMark.astro';
import SocialRow from '@/components/profile/SocialRow.astro';
import { socialLabel } from '@/data/socials';
import VerifiedBadge from '@/components/ui/VerifiedBadge.astro';
import { memberStats } from '@/server/progress';
import { levelOf, points, resolveTitle } from '@/lib/progress';
import { pageStyle } from '@/lib/page-style';
import '@/styles/app.css';
import '@/styles/profile.css';
export const prerender = false;

const handle = Astro.params.handle ?? '';
const db = Astro.locals.runtime.env.DB;
const found = await getPublicProfile(db, handle, Astro.locals.user?.id ?? null);
if (!found) return Astro.redirect('/world');
const { profile: p, isOwner, ownerId } = found;
const page = await getPageConfig(Astro.locals.runtime.env.WAITLIST, p.id);
const record = await profileReleases(db, ownerId);
const featured = record.find((x) => x.id === showcasePicks(page, canShowcase(p.verification)).featured) ?? record[0] ?? null;
const roles = p.primarySpecialty ? allSpecialties(p.primarySpecialty, p.specialties).map((s) => SPECIALTIES[s].label) : [];
const where = visibleLabel(p.placeId, p.locationVisibility);
// Where people listen (and the website) stay full buttons; social profiles are the icon row.
const LISTEN = new Set(['spotify', 'appleMusic', 'soundcloud', 'youtube', 'bandcamp', 'audiomack', 'website']);
const socialOnly = Object.fromEntries(Object.entries(p.links).filter(([k]) => !LISTEN.has(k)));
const buttons = [...page.links, ...Object.entries(p.links).filter(([k, v]) => !!v && LISTEN.has(k)).map(([k, v]) => ({ label: socialLabel(k), url: v as string }))];
const photo = p.photoKey ? mediaUrl(p.photoKey) : null;
const founder = p.distinction === 'founder';
const look = pageStyle(page.accent, page.backdrop, p.distinction);
const stats = await memberStats(db, ownerId, p);
const lv = levelOf(points(stats));
const title = resolveTitle(page.title || (founder ? 'founder' : ''), stats, p.distinction);
const showLevel = !page.hide.includes('journey');
const hue = [...p.handle].reduce((a, c) => (a * 31 + c.charCodeAt(0)) % 360, 0);
---
<BaseLayout title={`${p.displayName} · Links`} description={page.tagline || `${p.displayName} on Opus.`} noindex={p.status !== 'published'} image={photo ?? undefined} hideFooter assistant={false} messages={false}>
  <main class:list={['lk', 'pf', { 'is-founder': founder }]} style={`--h:${hue};${look.css}`}>
    <div class="lk__bd pf-bd" data-backdrop={look.backdrop} aria-hidden="true"></div>
    <div class="lk__col">
      {isOwner && p.status !== 'published' && <p class="lk__draft">Draft preview. Publish your profile to share this link.</p>}
      <div class="lk__photo" style={photo ? `background-image:url(${photo})` : ''} role="img" aria-label={p.displayName}>{!photo && p.displayName.slice(0, 1).toUpperCase()}</div>
      <h1>{p.displayName}{p.verification === 'verified' && <VerifiedBadge size={18} />}</h1>
      {(title || founder || showLevel) && (
        <p class="lk__rank">
          {founder && <FounderMark />}
          {title && !(founder && title === 'Founder') && <span class="lk__title">{title}</span>}
          {showLevel && <span class="lk__lv">Level {lv.level}{title !== lv.name && ' · ' + lv.name}</span>}
        </p>
      )}
      <p class="lk__sub">{[roles[0], where].filter(Boolean).join(' · ')}</p>
      {page.tagline && <p class="lk__tag">{page.tagline}</p>}

      <div class="lk__soc"><SocialRow links={socialOnly} /></div>

      {featured && (
        <a class="lk__feat" href={`/r/${featured.id}`}>
          <span class="lk__cover" style={featured.coverKey ? `background-image:url(${mediaUrl(featured.coverKey)})` : ''}></span>
          <span><small>{featured.released ? 'Out now' : 'Coming soon'} · {RELEASE_KINDS[featured.kind]}</small><b>{featured.title}</b></span>
          <i aria-hidden="true">→</i>
        </a>
      )}
      <ul class="lk__btns" role="list">
        {buttons.map((b) => <li><a href={b.url} target="_blank" rel="noopener nofollow ugc">{b.label}</a></li>)}
        <li><a class="is-main" href={`/${p.handle}`}>See full profile on Opus</a></li>
      </ul>
      <p class="lk__foot"><a href="/">Opus Collective</a></p>
    </div>
  </main>
</BaseLayout>

<style>
  .lk { position: relative; min-height: calc(100vh - 56px); display: grid; justify-items: center; padding: 48px var(--gutter) 64px; overflow: hidden; }
  /* The member's backdrop as a band across the top; the photo sits on its lower edge, as on the profile. */
  .lk__bd { position: absolute; inset: 0 0 auto; height: 174px; }
  .lk__soc { margin-top: 16px; }
  .lk__soc:empty { display: none; }
  .lk__rank { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 10px; margin: 6px 0 4px; }
  .lk__title { display: inline-flex; align-items: center; height: 22px; padding: 0 10px; border-radius: 999px; font-size: 11px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--pf-ink); box-shadow: inset 0 0 0 1px hsl(var(--pf-h) var(--pf-s) 60% / .45); background: var(--pf-soft); }
  .lk__lv { font-size: 13px; color: var(--text-2); }
  .lk h1 { display: flex; align-items: center; gap: 8px; }
  .is-founder .lk__photo { box-shadow: 0 0 0 1px color-mix(in oklab, #c99a3c 70%, transparent); border: 4px solid var(--bg); }
  .lk__btns a:hover { box-shadow: inset 0 0 0 1px var(--pf-ink); }
  .lk__col { position: relative; width: min(460px, 100%); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; }
  .lk__photo { margin-top: 70px; width: 112px; height: 112px; border: 4px solid var(--bg); border-radius: 50%; display: grid; place-items: center; font-size: 44px; font-weight: 300; color: #fff; background: linear-gradient(145deg, hsl(var(--h) 45% 38%), hsl(calc(var(--h) + 50) 50% 22%)) center / cover; box-shadow: 0 24px 50px -24px rgba(0, 0, 0, .6); margin-bottom: 12px; }
  h1 { margin: 0; font-size: 34px; font-weight: 600; letter-spacing: -0.045em; }
  .lk__sub { margin: 0; font-size: 14px; color: var(--text-2); }
  .lk__tag { margin: 10px 0 0; font-size: 16px; color: var(--text-2); max-width: 36ch; }
  .lk__draft { margin: 0 0 20px; font-size: 13px; color: var(--text-2); }
  .lk__feat { display: flex; align-items: center; gap: 14px; width: 100%; margin-top: 26px; padding: 10px 16px 10px 10px; border-radius: 16px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); text-align: left; text-decoration: none; color: inherit; }
  .lk__feat > span:nth-child(2) { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .lk__feat small { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--text-3); }
  .lk__feat b { font-weight: 500; font-size: 17px; letter-spacing: -0.02em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lk__cover { width: 64px; height: 64px; border-radius: 8px; background: linear-gradient(135deg, hsl(var(--h) 45% 42%), hsl(calc(var(--h) + 50) 50% 20%)) center / cover; }
  .lk__btns { width: 100%; margin-top: 14px; display: grid; gap: 10px; }
  .lk__btns a { display: flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 20px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line-strong); color: var(--text); font-size: 15px; text-decoration: none; transition: background .15s; }
  .lk__btns a:hover { background: var(--surface-hover); }
  .lk__btns a.is-main { background: var(--text); color: var(--bg); box-shadow: none; font-weight: 500; }
  .lk__foot { margin: 28px 0 0; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }
  .lk__foot a { color: var(--text-3); text-decoration: none; }
</style>
