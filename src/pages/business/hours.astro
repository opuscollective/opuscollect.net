---
import BusinessShell from '@/components/business/BusinessShell.astro';
import { getClosedDays, getRules } from '@/server/business';
import { loadBusiness } from '@/server/business-page';
import { localDay } from '@/lib/booking-time';
import { HOLIDAY_NAMES, upcomingHolidays } from '@/lib/holidays';
import { zoneName } from '@/lib/place-tz';
export const prerender = false;

const ctx = await loadBusiness(Astro);
if ('redirect' in ctx) return ctx.redirect;
const { studio, pending, db } = ctx;
const [rules, closed] = await Promise.all([getRules(db, studio.id), getClosedDays(db, studio.id)]);
const today = localDay(Date.now(), studio.timezone);
const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const ORDER = [1, 2, 3, 4, 5, 6, 0];
const hhmm = (m: number) => `${String(Math.floor(m / 60) % 24).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
const upcomingClosed = closed.filter((c) => c.day >= today && c.note !== 'holiday');
const holidaysOn = closed.some((c) => c.note === 'holiday');
const holidays = upcomingHolidays(today);
// The holiday list is the United States calendar, so only US studios are offered the switch.
const country = studio.placeId ? (await db.prepare('SELECT country FROM places WHERE id = ?').bind(studio.placeId).first<{ country: string }>())?.country : null;
const usStudio = !country || country === 'US';
const several = ctx.studios.length > 1;
---
<BusinessShell title="Hours" section="hours" studio={studio} pending={pending}
  lead={`${several ? `Hours for ${studio.name}. Each of your studios keeps its own hours. ` : ''}When customers can request sessions, in ${zoneName(studio.timezone)}, taken from your studio’s city.`}>
  <form class="form hw" data-hours novalidate data-today={today} data-holidays={JSON.stringify(holidays)} data-init={JSON.stringify(ORDER.map((wd) => { const f = rules.find((x) => x.weekday === wd); return { wd, open: !!f, s: f?.start_min ?? 600, e: f ? (f.end_min || 1440) : 1080 }; }))}>
    <div class="panel">
      <div class="hw__head">
        <div><h2>Weekly hours</h2><p class="dim">Drag on a day to set when you’re open. Drag the ends to adjust.</p></div>
        <div class="hw__presets" role="group" aria-label="Quick set">
          <button type="button" class="chip" data-preset="wk-10-18">Weekdays 10–6</button>
          <button type="button" class="chip" data-preset="wk-12-20">Weekdays 12–8</button>
          <button type="button" class="chip" data-preset="all-10-18">Every day</button>
          <button type="button" class="chip" data-preset="eve">Evenings 5–11</button>
          <button type="button" class="chip chip--quiet" data-preset="clear">Clear</button>
        </div>
      </div>
      {studio.studioType === 'remote' && <p class="dim">Remote projects don’t book a time slot, so hours only matter if you also offer sessions.</p>}
      <div class="hw__scale" aria-hidden="true"><i></i><div><span style="left:0">12a</span><span style="left:25%">6a</span><span style="left:50%">12p</span><span style="left:75%">6p</span><span style="left:100%">12a</span></div></div>
      <div class="hw__rows">
        {ORDER.map((wd) => (
          <div class="hw__row" data-day={wd}>
            <button type="button" class="hw__day" data-toggle aria-label={`${DAYS[wd]}: open or closed`}><b>{DAYS[wd].slice(0, 3)}</b></button>
            <div class="hw__track" data-track role="group" aria-label={`${DAYS[wd]} hours`}>
              <div class="hw__bar" data-bar hidden>
                <span class="hw__h hw__h--l" data-h="l"></span><span class="hw__lab" data-lab></span><span class="hw__h hw__h--r" data-h="r"></span>
              </div>
              <span class="hw__hint" data-hint>Closed. Drag to open</span>
            </div>
            <span class="hw__sum" data-sum></span>
            <button type="button" class="hw__copy" data-copy title="Use these hours every day">All days</button>
            <input type="checkbox" data-open hidden /><input type="hidden" data-start /><input type="hidden" data-end />
          </div>
        ))}
      </div>
      <p class="dim hw__fine">Times snap to the half hour. Need a split shift or overnight hours? Reach out and we’ll add it.</p>
    </div>

    <div class="panel" style="margin-top:16px">
      <h2>Days off</h2>
      {usStudio ? (
        <label class="hh">
          <span class="hh__t"><b>Close on US holidays</b><small data-hol-text data-on={`Closed on ${HOLIDAY_NAMES.join(', ')}.`} data-off={`Open on holidays. Turn on to close on ${HOLIDAY_NAMES.join(', ')}.`}>{holidaysOn ? `Closed on ${HOLIDAY_NAMES.join(', ')}.` : `Open on holidays. Turn on to close on ${HOLIDAY_NAMES.join(', ')}.`}</small></span>
          <span class="sw"><input type="checkbox" role="switch" data-holidays-on checked={holidaysOn} aria-label="Close on US holidays" /><i aria-hidden="true"></i></span>
        </label>
      ) : (
        <>
          <input type="checkbox" data-holidays-on hidden />
          <p class="dim">Holidays differ by country, so close yours by tapping the dates below.</p>
        </>
      )}
      <p class="dim">Need another day off? Tap a date to close it, tap again to open it. No one can request a session on a closed date.</p>
      <div class="hc" data-cal>
        <div class="hc__nav"><button type="button" class="chip chip--quiet" data-cal-prev aria-label="Earlier month">‹</button><b data-cal-title></b><button type="button" class="chip chip--quiet" data-cal-next aria-label="Later month">›</button></div>
        <div class="hc__dow" aria-hidden="true"><span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span></div>
        <div class="hc__grid" data-cal-grid></div>
      </div>
      <ul class="closed-list" role="list" data-closed-list>
        {upcomingClosed.map((c) => <li data-closed={c.day}>{c.day}<button type="button" aria-label={`Remove ${c.day}`}>×</button></li>)}
      </ul>
    </div>

    <div class="hw__actions"><div data-status class="form-status hw__status"></div><button class="btn-app" type="submit">Save hours</button></div>
  </form>
</BusinessShell>

<script>
  import { bindForm, status } from '@/scripts/form';
  const form = document.querySelector<HTMLFormElement>('[data-hours]')!;
  type Day = { wd: number; open: boolean; s: number; e: number };
  const days: Day[] = JSON.parse(form.dataset.init!);
  const rows = new Map<number, HTMLElement>([...form.querySelectorAll<HTMLElement>('[data-day]')].map((r) => [Number(r.dataset.day), r]));
  const STEP = () => (form.querySelector<HTMLElement>('[data-track]')!.clientWidth < 420 ? 60 : 30);
  const hm = (m: number) => `${String(Math.floor(m / 60) % 24).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
  const nice = (m: number) => { const h = Math.floor(m / 60) % 24, mm = m % 60; const ap = h >= 12 && m !== 1440 ? 'PM' : 'AM'; const h12 = h % 12 || 12; return `${h12}${mm ? ':' + String(mm).padStart(2, '0') : ''} ${ap}`; };

  function paint(d: Day) {
    const row = rows.get(d.wd)!;
    const bar = row.querySelector<HTMLElement>('[data-bar]')!;
    row.classList.toggle('is-closed', !d.open);
    bar.hidden = !d.open;
    row.querySelector<HTMLElement>('[data-hint]')!.hidden = d.open;
    row.querySelector<HTMLElement>('[data-copy]')!.hidden = !d.open;
    if (d.open) {
      bar.style.left = `${(d.s / 1440) * 100}%`; bar.style.width = `${((d.e - d.s) / 1440) * 100}%`;
      row.querySelector<HTMLElement>('[data-lab]')!.textContent = `${nice(d.s)} – ${nice(d.e)}`;
    }
    row.querySelector<HTMLElement>('[data-sum]')!.textContent = d.open ? `${nice(d.s)} – ${nice(d.e)}` : 'Closed';
    row.querySelector<HTMLInputElement>('[data-open]')!.checked = d.open;
    row.querySelector<HTMLInputElement>('[data-start]')!.value = hm(d.s);
    row.querySelector<HTMLInputElement>('[data-end]')!.value = hm(d.e);
  }
  days.forEach(paint);

  const snap = (m: number) => Math.max(0, Math.min(1440, Math.round(m / STEP()) * STEP()));
  days.forEach((d) => {
    const row = rows.get(d.wd)!;
    const track = row.querySelector<HTMLElement>('[data-track]')!;
    const at = (e: PointerEvent) => { const r = track.getBoundingClientRect(); return snap(((e.clientX - r.left) / r.width) * 1440); };
    row.querySelector('[data-toggle]')!.addEventListener('click', () => { d.open = !d.open; if (d.open && d.e - d.s < 60) { d.s = 600; d.e = 1080; } paint(d); });
    row.querySelector('[data-copy]')!.addEventListener('click', () => { days.forEach((o) => { o.open = true; o.s = d.s; o.e = d.e; paint(o); }); });
    let mode: 'new' | 'l' | 'r' | 'move' | null = null, anchor = 0, startX = 0, orig = { s: 0, e: 0 }, moved = false;
    track.addEventListener('pointerdown', (e) => {
      const h = (e.target as HTMLElement).closest<HTMLElement>('[data-h]');
      const inBar = d.open && (e.target as HTMLElement).closest('[data-bar]');
      mode = h ? (h.dataset.h as 'l' | 'r') : inBar ? 'move' : 'new';
      anchor = at(e); startX = e.clientX; orig = { s: d.s, e: d.e }; moved = false;
      track.setPointerCapture(e.pointerId);
    });
    track.addEventListener('pointermove', (e) => {
      if (!mode) return;
      if (Math.abs(e.clientX - startX) > 3) moved = true;
      if (!moved) return;
      const p = at(e);
      if (mode === 'new') { d.open = true; d.s = Math.min(anchor, p); d.e = Math.max(anchor, p); if (d.e - d.s < STEP()) d.e = Math.min(1440, d.s + STEP()); }
      else if (mode === 'l') d.s = Math.min(p, d.e - STEP());
      else if (mode === 'r') d.e = Math.max(p, d.s + STEP());
      else { const len = orig.e - orig.s; const s = Math.max(0, Math.min(1440 - len, snap(orig.s + (p - anchor)))); d.s = s; d.e = s + len; }
      paint(d);
    });
    const end = () => {
      if (mode === 'new' && !moved) { d.open = true; d.s = Math.min(anchor, 1440 - 480); d.e = d.s + 480; paint(d); } // a tap opens an 8-hour block
      mode = null;
    };
    track.addEventListener('pointerup', end); track.addEventListener('pointercancel', () => { mode = null; });
  });

  const PRESETS: Record<string, (d: Day) => void> = {
    'wk-10-18': (d) => { const on = d.wd >= 1 && d.wd <= 5; d.open = on; if (on) { d.s = 600; d.e = 1080; } },
    'wk-12-20': (d) => { const on = d.wd >= 1 && d.wd <= 5; d.open = on; if (on) { d.s = 720; d.e = 1200; } },
    'all-10-18': (d) => { d.open = true; d.s = 600; d.e = 1080; },
    eve: (d) => { d.open = true; d.s = 1020; d.e = 1380; },
    clear: (d) => { d.open = false; },
  };
  form.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => days.forEach((d) => { PRESETS[b.dataset.preset!]!(d); paint(d); })));

  // Days off: tap dates on a calendar. The list below is the source of truth the form saves.
  const list = form.querySelector<HTMLUListElement>('[data-closed-list]')!;
  const grid = form.querySelector<HTMLElement>('[data-cal-grid]')!;
  const title = form.querySelector<HTMLElement>('[data-cal-title]')!;
  const today = form.dataset.today!;
  const hol = new Set((JSON.parse(form.dataset.holidays!) as { day: string }[]).map((h) => h.day));
  const holOn = form.querySelector<HTMLInputElement>('[data-holidays-on]')!;
  const holText = form.querySelector<HTMLElement>('[data-hol-text]');
  holOn.addEventListener('change', () => { if (holText) holText.textContent = (holOn.checked ? holText.dataset.on : holText.dataset.off) ?? ''; });
  holOn.addEventListener('change', () => cal());
  const [ty, tm] = today.split('-').map(Number) as [number, number];
  let off = 0;
  const closedSet = () => new Set([...list.querySelectorAll<HTMLElement>('li')].map((li) => li.dataset.closed!));
  const addClosed = (d: string) => {
    const li = document.createElement('li'); li.dataset.closed = d; li.textContent = d;
    const b = document.createElement('button'); b.type = 'button'; b.textContent = '×'; b.setAttribute('aria-label', `Remove ${d}`);
    b.addEventListener('click', () => { li.remove(); cal(); }); li.append(b);
    const after = [...list.querySelectorAll<HTMLElement>('li')].find((x) => x.dataset.closed! > d);
    list.insertBefore(li, after ?? null);
  };
  list.querySelectorAll<HTMLElement>('li').forEach((li) => li.querySelector('button')!.addEventListener('click', () => { li.remove(); cal(); }));
  function cal() {
    const first = new Date(Date.UTC(ty, tm - 1 + off, 1));
    title.textContent = first.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
    const lead = first.getUTCDay(), dim = new Date(Date.UTC(first.getUTCFullYear(), first.getUTCMonth() + 1, 0)).getUTCDate();
    const set = closedSet(); grid.textContent = '';
    for (let i = 0; i < lead; i++) grid.append(document.createElement('span'));
    for (let n = 1; n <= dim; n++) {
      const key = `${first.getUTCFullYear()}-${String(first.getUTCMonth() + 1).padStart(2, '0')}-${String(n).padStart(2, '0')}`;
      const b = document.createElement('button'); b.type = 'button'; b.textContent = String(n);
      b.disabled = key < today; b.classList.toggle('is-off', set.has(key)); b.classList.toggle('is-hol', hol.has(key)); if (hol.has(key) && holOn.checked && !set.has(key)) { b.classList.add('is-off', 'is-auto'); b.title = 'Closed for the holiday'; } b.classList.toggle('is-today', key === today);
      b.setAttribute('aria-pressed', String(set.has(key))); b.setAttribute('aria-label', `${key}${set.has(key) ? ', closed' : ''}`);
      b.addEventListener('click', () => { const l = list.querySelector<HTMLElement>(`[data-closed="${key}"]`); if (l) l.remove(); else addClosed(key); cal(); });
      grid.append(b);
    }
    form.querySelector<HTMLButtonElement>('[data-cal-prev]')!.disabled = off <= 0;
  }
  form.querySelector('[data-cal-prev]')!.addEventListener('click', () => { off = Math.max(0, off - 1); cal(); });
  form.querySelector('[data-cal-next]')!.addEventListener('click', () => { off = Math.min(11, off + 1); cal(); });
  cal();

  bindForm(form, {
    url: '/api/business/hours',
    body: (f) => ({
      rules: [...f.querySelectorAll<HTMLElement>('[data-day]')]
        .filter((r) => r.querySelector<HTMLInputElement>('[data-open]')!.checked)
        .map((r) => ({ weekday: Number(r.dataset.day), start: r.querySelector<HTMLInputElement>('[data-start]')!.value, end: r.querySelector<HTMLInputElement>('[data-end]')!.value })),
      closed: [...list.querySelectorAll<HTMLElement>('li')].map((li) => li.dataset.closed),
      holidays: holOn.checked,
    }),
    busyLabel: 'Saving…',
    onSuccess: () => status(form, 'Hours saved.', 'ok'),
  });
</script>
