---
import BusinessShell from '@/components/business/BusinessShell.astro';
import PlaceSelect from '@/components/business/PlaceSelect.astro';
import { STUDIO_TYPES } from '@/server/business';
import { loadBusiness } from '@/server/business-page';
import { GALLERY_MAX, listGallery, mediaUrl } from '@/server/profiles';
import { ZONE_NAMES, tzForPlace, zoneName } from '@/lib/place-tz';
export const prerender = false;

const ctx = await loadBusiness(Astro);
if ('redirect' in ctx) return ctx.redirect;
const { studio: s, pending } = ctx;
const isNew = Astro.url.searchParams.has('new');
const db = Astro.locals.runtime.env.DB;
const gallery = await listGallery(db, s.id);
const place = s.placeId ? await db.prepare('SELECT name, region, country, lat, lng FROM places WHERE id = ?').bind(s.placeId).first<{ name: string; region: string | null; country: string; lat: number; lng: number }>() : null;
// The zone comes from the studio's city. An owner whose clocks differ picks a zone by name, never from a list of cities.
const cityTz = tzForPlace(place);
const followsCity = !!cityTz && zoneName(cityTz) === zoneName(s.timezone);
const zoneListed = ZONE_NAMES.some(([, n]) => n === zoneName(s.timezone));
const STEPS = [['basics', 'Basics'], ['photos', 'Photos'], ['rules', 'Booking rules']] as const;
const asked = Astro.url.searchParams.get('step');
const step = STEPS.some(([k]) => k === asked) ? asked! : 'basics';
---
<BusinessShell title="Studio profile" section="studio" studio={s} pending={pending}
  lead={isNew ? 'Studio created. Add a description and a photo, then set up services and hours.' : 'What customers see on your booking page and in World.'}>
  {s.status === 'published' && <button slot="actions" type="button" class="btn-app btn-app--ghost" data-unpublish>Unpublish</button>}

  <div class="tabs st-steps" role="tablist" aria-label="Studio profile steps" data-steps data-step={step}>
    {STEPS.map(([k, label], i) => <button type="button" role="tab" id={`st-tab-${k}`} aria-controls={`st-${k}`} aria-selected={k === step ? 'true' : 'false'} data-step-to={k}>{i + 1}. {label}</button>)}
  </div>

  <form class="form" data-studio novalidate data-new={isNew ? '1' : ''}>
    <div id="st-basics" role="tabpanel" aria-labelledby="st-tab-basics" data-pane="basics" hidden={step !== 'basics'}>
    <div class="panel">
      <h2>Basics</h2>
      <label class="field"><span>Studio name *</span><input class="input" name="name" maxlength="80" required value={s.name} /></label>
      <label class="field"><span>Page address</span><input class="input" name="handle" maxlength="40" value={s.handle} pattern="[a-z0-9-]+" /><small>opuscollect.net/studios/<b data-handle-preview>{s.handle}</b></small></label>
      <details class="st-fold" open={!s.placeId}>
        <summary><span><b>{STUDIO_TYPES[s.studioType].label}</b>{place && <> · {place.name}{place.region && `, ${place.region}`}</>}</span><i>Change</i></summary>
        <fieldset class="field" style="border:0;padding:0;margin:0">
          <legend>Studio type *</legend>
          <div class="bk__svc" style="margin-top:8px">
            {Object.entries(STUDIO_TYPES).map(([k, v]) => (
              <label><input type="radio" name="studioType" value={k} checked={s.studioType === k} /><span><b>{v.label}</b><small>{v.hint}</small></span><span></span></label>
            ))}
          </div>
        </fieldset>
        <label class="field"><span>City *</span><PlaceSelect selected={s.placeId} required /><small>Shown publicly. World places you at the city’s centre, never at your address.</small></label>
      </details>
      <label class="field"><span>About the studio *</span><textarea class="textarea" name="bio" rows="6" maxlength="2000">{s.bio}</textarea><small>At least 40 characters. What you record, who you work with, what makes the room good.</small></label>
      <label class="field"><span>Equipment</span><textarea class="textarea" name="equipment" rows="5" placeholder="One item per line, e.g. Neumann U87">{s.equipment.join('\n')}</textarea></label>
      <div class="grid-2">
        <label class="field"><span>Website</span><input class="input" name="website" type="url" value={s.website} placeholder="https://" /></label>
        <label class="field"><span>Instagram</span><input class="input" name="instagram" type="url" value={s.instagram} placeholder="https://instagram.com/…" /></label>
      </div>
    </div>
    <div class="st-actions"><div data-status class="form-status st-actions__status"></div><button class="btn-app" type="submit" data-next={isNew ? 'photos' : 'basics'}>{isNew ? 'Save and add photos' : 'Save'}</button></div>
    </div>

    <div id="st-rules" role="tabpanel" aria-labelledby="st-tab-rules" data-pane="rules" hidden={step !== 'rules'}>
    <div class="panel">
      <h2>Private address</h2>
      <p class="dim">Only you can see this. It is never shown on your page or the map. You share it with a customer yourself once you accept their booking.</p>
      <label class="field"><span>Street address</span><textarea class="textarea" name="privateAddress" rows="2" maxlength="300">{s.privateAddress}</textarea></label>
    </div>

    <div class="panel" style="margin-top:16px">
      <h2>Booking rules</h2>
      <p class="dim">Every booking is a request you accept or decline. Instant booking will come with online payments.</p>
      <div class="grid-2">
        <label class="field"><span>Time zone</span>
          <select class="select" name="timezone">
            {cityTz && <option value="auto" selected={followsCity}>{zoneName(cityTz)} (from {place!.name})</option>}
            {!followsCity && !zoneListed && <option value={s.timezone} selected>{zoneName(s.timezone)}</option>}
            {ZONE_NAMES.filter(([, n]) => !cityTz || n !== zoneName(cityTz)).map(([id, n]) => <option value={id} selected={!followsCity && n === zoneName(s.timezone)}>{n}</option>)}
          </select>
          <small>Taken from your studio’s city. Change it only if your clocks differ.</small></label>
        <label class="field"><span>Minimum notice (hours)</span><input class="input" name="minNoticeHours" type="number" min="0" max="336" value={s.minNoticeHours} /></label>
        <label class="field"><span>How far ahead people can book (days)</span><input class="input" name="maxDaysAhead" type="number" min="1" max="365" value={s.maxDaysAhead} /></label>
      </div>
      <label class="field"><span>Booking policy</span><textarea class="textarea" name="bookingPolicy" rows="3" maxlength="1500" placeholder="E.g. guests allowed, what to bring, no smoking.">{s.bookingPolicy}</textarea></label>
      <label class="field"><span>Cancellation policy</span><textarea class="textarea" name="cancellationPolicy" rows="3" maxlength="1500" placeholder="E.g. free cancellation up to 48 hours before.">{s.cancellationPolicy}</textarea></label>
      <label class="check"><input type="checkbox" name="showOnMap" checked={s.showOnMap} /><span>Show the studio on the World map. Your city is shown, never your address. When off, you still appear in search results.</span></label>
    </div>

    <div class="st-actions"><div data-status-rules class="form-status st-actions__status"></div><button class="btn-app" type="submit" data-next={isNew ? 'done' : 'rules'}>{isNew ? 'Save and finish' : 'Save'}</button></div>
    </div>
  </form>

  <div id="st-photos" role="tabpanel" aria-labelledby="st-tab-photos" data-pane="photos" hidden={step !== 'photos'}>
  <div class="panel" id="photos">
    <h2>Photos</h2>
    <p class="dim">A main photo is required to publish. JPEG, PNG or WebP. Location data is removed from every photo before upload.</p>
    <div class="ph">
      <div class="ph__col">
        <div class="ph__img ph__img--photo" data-preview="photo" style={s.photoKey ? `background-image:url(${mediaUrl(s.photoKey)})` : ''}>{!s.photoKey && <span>No photo</span>}</div>
        <label class="btn-app btn-app--ghost file-btn">Upload photo<input type="file" accept="image/jpeg,image/png,image/webp,image/heic" data-upload="photo" /></label>
      </div>
      <div class="ph__col">
        <div class="ph__img ph__img--cover" data-preview="cover" style={s.coverKey ? `background-image:url(${mediaUrl(s.coverKey)})` : ''}>{!s.coverKey && <span>Optional cover image</span>}</div>
        <div class="row">
          <label class="btn-app btn-app--ghost file-btn">Upload cover<input type="file" accept="image/jpeg,image/png,image/webp" data-upload="cover" /></label>
          {s.coverKey && <button type="button" class="btn-app btn-app--ghost" data-remove-cover>Remove</button>}
        </div>
      </div>
    </div>
    <p class="dim" data-upload-status role="status"></p>
  </div>

  <div class="panel" style="margin-top:16px" id="gallery">
    <h2>Gallery</h2>
    <p class="dim">Up to {GALLERY_MAX} photos of the rooms, booth and gear. They appear in your World preview and booking page. Location data is removed before upload.</p>
    <ul class="gal" data-gallery data-max={GALLERY_MAX}>
      {gallery.map((g) => (
        <li data-gid={g.id}><img src={g.url} alt="" loading="lazy" /><button type="button" class="btn-app btn-app--ghost" data-gal-remove={g.id} aria-label="Remove photo">Remove</button></li>
      ))}
    </ul>
    <label class="btn-app btn-app--ghost file-btn" data-gal-add hidden={gallery.length >= GALLERY_MAX}>Add photos<input type="file" accept="image/jpeg,image/png,image/webp" multiple data-gal-input /></label>
    <p class="dim" data-gal-status role="status"></p>
  </div>
  <div class="st-actions"><span class="dim st-actions__status">Photos save as soon as they upload.</span><button class="btn-app" type="button" data-step-to="rules">Continue to booking rules</button></div>
  </div>
</BusinessShell>

<style>
  .st-steps { margin-bottom: 16px; }
  .st-fold { margin: 4px 0 18px; border: 1px solid var(--c-line); border-radius: var(--r-md); }
  .st-fold > summary { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 48px; padding: 0 14px; cursor: pointer; list-style: none; font-size: 14px; color: var(--c-fg-subtle); }
  .st-fold > summary::-webkit-details-marker { display: none; }
  .st-fold > summary b { color: var(--text); font-weight: 500; }
  .st-fold > summary i { font-style: normal; font-size: 13px; color: var(--c-fg-faint); text-decoration: underline; text-underline-offset: 3px; }
  .st-fold[open] > summary { border-bottom: 1px solid var(--c-line); }
  .st-fold[open] > summary i { display: none; }
  .st-fold > :not(summary) { margin: 14px; }
  /* Buttons sit on the left so the floating Messages and Ask Opus chips never cover them. */
  .st-actions { position: sticky; bottom: 0; z-index: 2; display: flex; flex-wrap: wrap; justify-content: flex-start; align-items: center; gap: 10px; padding: 14px 0; background: linear-gradient(to top, var(--c-bg) 70%, transparent); }
  .st-actions__status { flex: 1 1 240px; margin: 0; order: 2; }
</style>

<script>
  import { bindForm, values } from '@/scripts/form';
  import { prepareImage } from '@/scripts/image';
  const form = document.querySelector<HTMLFormElement>('[data-studio]')!;
  const handle = form.querySelector<HTMLInputElement>('[name="handle"]')!;
  handle.addEventListener('input', () => { document.querySelector('[data-handle-preview]')!.textContent = handle.value || '…'; });
  // Three steps on one page. The address keeps the step, so a reload or the Back button lands where you were.
  const steps = document.querySelector<HTMLElement>('[data-steps]')!;
  const isNew = form.dataset.new === '1';
  function show(step: string, push = true) {
    document.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== step));
    steps.querySelectorAll<HTMLElement>('[role=tab]').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.stepTo === step)));
    if (push) { const u = new URL(location.href); u.searchParams.set('step', step); u.searchParams.delete('saved'); history.replaceState(null, '', u); window.scrollTo({ top: 0 }); }
  }
  document.addEventListener('click', (e) => { const to = (e.target as HTMLElement).closest<HTMLElement>('[data-step-to]')?.dataset.stepTo; if (to) show(to); });
  let next = 'basics';
  form.querySelectorAll<HTMLButtonElement>('[type=submit]').forEach((b) => b.addEventListener('click', () => { next = b.dataset.next ?? 'basics'; }));
  bindForm(form, {
    url: '/api/business/studio',
    body: (f) => values(f),
    busyLabel: 'Saving…',
    onSuccess: () => { location.href = next === 'done' ? '/business' : `/business/studio?step=${next}&saved=1${isNew ? '&new=1' : ''}`; },
  });
  // The form reports problems in its first status line. When that line is on another step, repeat it where the owner is,
  // and open the step that holds the field to fix.
  const main = form.querySelector<HTMLElement>('[data-status]')!, mirror = form.querySelector<HTMLElement>('[data-status-rules]')!;
  new MutationObserver(() => {
    mirror.textContent = main.textContent; mirror.className = main.className.replace('form-status', 'form-status st-actions__status');
    const bad = form.querySelector<HTMLElement>('.field.has-error')?.closest<HTMLElement>('[data-pane]');
    if (bad?.hidden) show(bad.dataset.pane!);
  }).observe(main, { childList: true, characterData: true, subtree: true, attributes: true, attributeFilter: ['class'] });
  if (new URLSearchParams(location.search).has('saved')) {
    const box = document.querySelector<HTMLElement>('[data-pane]:not([hidden]) .st-actions__status');
    if (box) { box.className = 'form-status st-actions__status notice notice--ok'; box.textContent = isNew ? 'Saved. Next step.' : 'Saved.'; }
  }

  document.querySelector<HTMLButtonElement>('[data-unpublish]')?.addEventListener('click', async () => {
    if (!confirm('Unpublish your booking page? It disappears from World and the link stops taking requests. Existing bookings are kept.')) return;
    const r = await fetch('/api/business/publish', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ on: false }) });
    if (r.ok) location.href = '/business';
  });

  const up = document.querySelector<HTMLElement>('[data-upload-status]')!;
  document.querySelectorAll<HTMLInputElement>('[data-upload]').forEach((input) => input.addEventListener('change', async () => {
    const file = input.files?.[0];
    if (!file) return;
    const slot = input.dataset.upload as 'photo' | 'cover';
    up.textContent = 'Preparing image…';
    try {
      // Re-encoded in the browser: resized, orientation fixed, all metadata (including GPS) dropped.
      const blob = await prepareImage(file, slot === 'photo' ? 1200 : 2400, slot === 'photo' ? 'square' : 'free');
      up.textContent = 'Uploading…';
      const r = await fetch(`/api/business/image?slot=${slot}`, { method: 'POST', headers: { 'content-type': blob.type }, body: blob });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error ?? 'Upload failed.');
      const el = document.querySelector<HTMLElement>(`[data-preview="${slot}"]`)!;
      el.style.backgroundImage = `url(${d.url})`; el.textContent = '';
      up.textContent = slot === 'photo' ? 'Photo updated.' : 'Cover updated.';
    } catch (e) {
      up.textContent = e instanceof Error ? e.message : 'Upload failed.';
    } finally { input.value = ''; }
  }));
  // Gallery: add several at once, remove one at a time.
  const gal = document.querySelector<HTMLUListElement>('[data-gallery]')!;
  const galStatus = document.querySelector<HTMLElement>('[data-gal-status]')!;
  const galAdd = document.querySelector<HTMLElement>('[data-gal-add]')!;
  const GMAX = Number(gal.dataset.max) || 8;
  const syncGal = () => { galAdd.hidden = gal.children.length >= GMAX; };
  document.querySelector<HTMLInputElement>('[data-gal-input]')!.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const files = [...(input.files ?? [])].slice(0, GMAX - gal.children.length);
    for (const [i, file] of files.entries()) {
      galStatus.textContent = `Uploading ${i + 1} of ${files.length}…`;
      try {
        const blob = await prepareImage(file, 2000, 'free');
        const r = await fetch('/api/business/gallery', { method: 'POST', headers: { 'content-type': blob.type }, body: blob });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(d.error ?? 'Upload failed.');
        const li = document.createElement('li'); li.dataset.gid = d.id;
        li.innerHTML = `<img src="${d.url}" alt="" /><button type="button" class="btn-app btn-app--ghost" data-gal-remove="${d.id}" aria-label="Remove photo">Remove</button>`;
        gal.append(li);
      } catch (err) { galStatus.textContent = err instanceof Error ? err.message : 'Upload failed.'; input.value = ''; syncGal(); return; }
    }
    galStatus.textContent = files.length ? 'Gallery updated.' : '';
    input.value = ''; syncGal();
  });
  gal.addEventListener('click', async (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-gal-remove]')?.dataset.galRemove;
    if (!id) return;
    const r = await fetch(`/api/business/gallery?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
    if (r.ok) { gal.querySelector(`[data-gid="${id}"]`)?.remove(); galStatus.textContent = 'Photo removed.'; syncGal(); }
    else galStatus.textContent = 'Couldn’t remove that photo. Try again.';
  });

  document.querySelector<HTMLButtonElement>('[data-remove-cover]')?.addEventListener('click', async (e) => {
    const r = await fetch('/api/business/image?slot=cover', { method: 'DELETE' });
    if (r.ok) { const el = document.querySelector<HTMLElement>('[data-preview="cover"]')!; el.style.backgroundImage = ''; el.textContent = 'Optional cover image'; (e.target as HTMLElement).remove(); }
  });
</script>
