---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductNav from '@/components/product/ProductNav.astro';
const user = Astro.locals.user;
const addWork = user ? '/works?add=1' : '/sign-in?next=' + encodeURIComponent('/works?add=1');
const CITIES = ['Birmingham', 'Atlanta', 'Nashville', 'London', 'Lagos', 'Los Angeles'];
---
<BaseLayout title="Charts" description="Opus Charts: public, city-by-city rankings of independent artists, built only from real Opus activity. Coming soon." noindex>
  <ProductNav product="charts" />
  <article class="ch">
    <header class="ch__mast">
      <p class="ch__issue"><span>Opus Charts</span><span>Chart period: not yet published</span></p>
      <h1 class="ch__title">Every city<br />has a sound.</h1>
      <p class="ch__lead">Charts will rank independent artists city by city, from real, published Opus activity. No chart is live yet, so nothing on this page is a ranking.</p>
    </header>

    <section class="ch__feature" aria-labelledby="ch-no1">
      <div class="ch__no">01</div>
      <div class="ch__fbody">
        <p class="ch__label">No. 1 · Artist of the week</p>
        <h2 id="ch-no1">The first number one hasn’t been named.</h2>
        <p>When the first chart is published, the top artist and their artwork will be featured here, with their rank, movement and weeks on the chart. Artwork comes from the artist’s own releases on Opus.</p>
        <p class="ch__note">Placeholder. No artist is ranked.</p>
      </div>
    </section>

    <section class="ch__cols" aria-label="How to read a chart">
      <div>
        <h3>Rank</h3>
        <p>Where an artist stands this period, from 1 down.</p>
      </div>
      <div>
        <h3>Movement</h3>
        <p><b aria-hidden="true">▲ ▼ NEW</b> Up, down or new since the last chart.</p>
      </div>
      <div>
        <h3>Popularity</h3>
        <p>How much people engage with an artist’s published work on Opus.</p>
      </div>
      <div>
        <h3>Momentum</h3>
        <p>How fast that engagement is changing. A rising artist can lead Momentum before Popularity.</p>
      </div>
    </section>

    <section class="ch__rules">
      <h2>Honest by design</h2>
      <ul role="list">
        <li><b>No pay-to-rank.</b> Membership, payment and verification never change a position.</li>
        <li><b>Real activity only.</b> Charts count published works, credits and listens, never invented numbers.</li>
        <li><b>Methodology first.</b> Each chart will say exactly what it counts.</li>
      </ul>
    </section>

    <section class="ch__cities" aria-labelledby="ch-cities">
      <h2 id="ch-cities">Cities Charts will cover</h2>
      <p class="ch__citylist">{CITIES.map((c) => <span>{c}</span>)}</p>
    </section>

    <section class="ch__cta">
      <p>Charts are built from your work. Add your releases and credits so you’re ready when the first chart opens.</p>
      <div class="ch__btns">
        <a class="ch__btn ch__btn--go" href={addWork}>Add your work</a>
        <a class="ch__btn" href="/world">Explore World</a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .ch { max-width: 1120px; margin: 0 auto; padding: clamp(40px, 6vw, 88px) var(--gutter, 24px) 96px; }
  .ch__issue { display: flex; flex-wrap: wrap; gap: 6px 20px; align-items: center; margin: 0 0 clamp(20px, 3vw, 36px); padding-bottom: 14px; border-bottom: 2px solid var(--text);
    font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-2); }
  .ch__soon { margin-left: auto; padding: 3px 10px; border: 1px solid var(--line-strong); border-radius: var(--r-pill); }
  .ch__title { margin: 0; font-size: clamp(3.2rem, 1.4rem + 9vw, 9rem); font-weight: 600; letter-spacing: -0.06em; line-height: 0.9; }
  .ch__lead { margin: 24px 0 0; max-width: 46ch; font-size: clamp(1.1rem, 1rem + 0.5vw, 1.4rem); line-height: 1.45; color: var(--text-2); }
  .ch__feature { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 5vw, 72px); align-items: center; margin-top: clamp(48px, 7vw, 96px); padding: clamp(28px, 4vw, 56px) 0; border-block: 1px solid var(--line); }
  .ch__no { font-size: clamp(7rem, 4rem + 16vw, 17rem); font-weight: 600; letter-spacing: -0.08em; line-height: 0.8; color: transparent; -webkit-text-stroke: 1.5px var(--text-3); }
  .ch__label { margin: 0 0 12px; font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-3); }
  .ch__fbody h2 { margin: 0; font-size: clamp(1.6rem, 1.1rem + 1.8vw, 2.6rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.08; }
  .ch__fbody p { max-width: 52ch; margin: 14px 0 0; font-size: 16px; line-height: 1.55; color: var(--text-2); }
  .ch__fbody .ch__label { color: var(--text-3); margin-top: 0; }
  .ch__note { font-size: 13px !important; color: var(--text-3) !important; }
  .ch__cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; margin-top: clamp(40px, 5vw, 64px); }
  .ch__cols h3 { margin: 0 0 8px; font-size: 13px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); }
  .ch__cols p { margin: 0; font-size: 15px; line-height: 1.5; color: var(--text-2); }
  .ch__cols b { display: block; margin-bottom: 4px; font-size: 12px; letter-spacing: 0.06em; color: var(--text); }
  .ch__rules { margin-top: clamp(48px, 6vw, 88px); max-width: 720px; }
  .ch h2.x, .ch__rules h2, .ch__cities h2 { margin: 0 0 16px; font-size: 13px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); }
  .ch__rules ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .ch__rules li { font-size: clamp(1.05rem, 1rem + 0.3vw, 1.25rem); line-height: 1.45; color: var(--text-2); }
  .ch__rules b { color: var(--text); font-weight: 600; }
  .ch__cities { margin-top: clamp(48px, 6vw, 88px); }
  .ch__citylist { display: flex; flex-wrap: wrap; gap: 4px 28px; margin: 0; font-size: clamp(1.6rem, 1rem + 2.6vw, 3.2rem); font-weight: 500; letter-spacing: -0.045em; line-height: 1.15; color: var(--text-2); }
  .ch__cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px; margin-top: clamp(48px, 6vw, 88px); padding-top: 28px; border-top: 1px solid var(--line); }
  .ch__cta p { margin: 0; max-width: 48ch; font-size: 16px; line-height: 1.5; color: var(--text-2); }
  .ch__btns { display: flex; flex-wrap: wrap; gap: 10px; }
  .ch__btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 22px; border-radius: var(--r-pill); border: 1px solid var(--line-strong); color: var(--text); font-size: 15px; font-weight: 500; }
  .ch__btn--go { background: var(--text); color: var(--bg); border-color: var(--text); }
  .ch__btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (max-width: 860px) {
    .ch__feature { grid-template-columns: 1fr; gap: 16px; }
    .ch__cols { grid-template-columns: 1fr 1fr; gap: 24px; }
  }
  @media (max-width: 520px) { .ch__cols { grid-template-columns: 1fr; gap: 18px; } .ch__soon { margin-left: 0; } }
</style>
