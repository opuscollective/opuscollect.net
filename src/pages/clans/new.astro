---
/**
 * Create a group: a shared home for a band, collective, production crew or label.
 * Only the essentials here (type, name, city). Photo, bio and members are set up on the page itself.
 * Needs an account and a confirmed email. No individual profile needed: the creator owns the page and can add themselves as a member later.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlaceSelect from '@/components/business/PlaceSelect.astro';
import { GROUP_TYPES } from '@/server/clans';
import '@/styles/app.css';
import '@/styles/clans.css';
export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/sign-up?setup=group');
const preset = Astro.url.searchParams.get('type');
const CREATE_TYPES = Object.entries(GROUP_TYPES).filter(([k]) => k !== 'label'); // label pages aren't available yet
const type = preset && preset in GROUP_TYPES && preset !== 'label' ? preset : 'band';
---
<BaseLayout title="Create a group" description="A public page for your band, duo or collective." noindex assistant={false} messages={false}>
  <section class="app">
    <div class="app__wrap" style="margin-inline:auto;max-width:560px">
      <h1 class="cn__title">Set up your group.</h1>
      <p class="cn__lead">Start with a name. You’ll add the photo, bio and members on the page.</p>
      {!user.emailVerified ? (
        <div class="panel" style="margin-top:28px">
          <h2>Confirm your email first</h2>
          <p class="dim">We ask for a confirmed email before you create a public page. Check your inbox for the link, or resend it from your account.</p>
          <div class="row" style="margin-top:16px"><a class="btn-app" href="/account">Go to your account</a></div>
        </div>
      ) : (
        <form class="form" data-clan-form novalidate style="margin-top:28px">
          <fieldset class="field">
            <legend>What kind of group?</legend>
            <div class="cn__types">
              {CREATE_TYPES.map(([k, v]) => (
                <label class="cn__type"><input type="radio" name="groupType" value={k} checked={k === type} /><span><b>{v.label}</b></span></label>
              ))}
            </div>
          </fieldset>
          <label class="field"><span>Name</span><input class="input" name="name" maxlength="80" required autocomplete="off" /></label>
          <label class="field"><span>City <em class="cn__opt">Optional</em></span><PlaceSelect selected={null} /><small>Only the city is shown. It puts your group on World.</small></label>
          <div data-status class="form-status"></div>
          <button class="btn-app btn-app--block" type="submit">Create group</button>
        </form>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  import { bindForm, values } from '@/scripts/form';
  const form = document.querySelector<HTMLFormElement>('[data-clan-form]');
  if (form) bindForm(form, { url: '/api/clans', body: (f) => values(f), busyLabel: 'Creating…', onSuccess: (d) => { location.href = `${d.href}?setup=1`; } });
</script>
<style>
  .cn__title { margin: 0; font-size: clamp(2rem, 1.5rem + 2.2vw, 3rem); line-height: 1.05; letter-spacing: -0.045em; font-weight: 500; }
  .cn__lead { margin: 14px 0 0; font-size: 17px; line-height: 1.5; color: var(--text-2); }
  .cn__types { display: flex; flex-wrap: wrap; gap: 8px; border: 0; padding: 0; margin: 0; }
  .cn__type { position: relative; }
  .cn__type input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .cn__type span { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border: 1px solid var(--line); border-radius: var(--r-pill); font-size: 15px; color: var(--text-2); transition: border-color var(--m-control) var(--m-ease), background var(--m-control) var(--m-ease); }
  .cn__type b { font-weight: 500; }
  .cn__type input:checked + span { border-color: var(--text); color: var(--text); background: var(--surface); }
  .cn__type input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cn__opt { font-style: normal; font-size: 12px; color: var(--text-3); margin-left: 6px; }
</style>
