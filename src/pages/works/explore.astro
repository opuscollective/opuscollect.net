---
/**
 * Explore Works: every published work from a published profile, newest first, filterable by type.
 * Real records only. With none yet, it says so and points to the Opus Collective catalog.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductNav from '@/components/product/ProductNav.astro';
import AddWork from '@/components/works/AddWork.astro';
import WorkCard from '@/components/works/WorkCard.astro';
import { CATALOG } from '@/data/catalog';
import { RELEASE_KINDS } from '@/data/music';
import { listPublicWorks, type PublicWork } from '@/server/releases';
import '@/styles/product.css';
export const prerender = false;

const PER = 24;
const kindIn = Astro.url.searchParams.get('type');
const kind = kindIn && kindIn in RELEASE_KINDS ? kindIn : null;
const page = Math.max(1, Math.min(200, Number(Astro.url.searchParams.get('page')) || 1));
let res: { works: PublicWork[]; total: number } = { works: [], total: 0 };
let failed = false;
try { res = await listPublicWorks(Astro.locals.runtime.env.DB, { kind, limit: PER, offset: (page - 1) * PER }); } catch (e) { console.error('explore works', e); failed = true; }
const user = Astro.locals.user;
const profile = user ? await Astro.locals.runtime.env.DB.prepare("SELECT handle, status FROM profiles WHERE owner_user_id = ? AND kind = 'musician'").bind(user.id).first<{ handle: string; status: string }>() : null;
const PLURAL: Record<string, string> = { single: 'Singles', ep: 'EPs', album: 'Albums', mixtape: 'Mixtapes' };
const filters: [string | null, string][] = [[null, 'All'], ...Object.keys(RELEASE_KINDS).map((k) => [k, PLURAL[k]!] as [string, string])];
const href = (k: string | null, p = 1) => { const q = new URLSearchParams(); if (k) q.set('type', k); if (p > 1) q.set('page', String(p)); const s = q.toString(); return `/works/explore${s ? `?${s}` : ''}`; };
const more = page * PER < res.total;
const addHref = user ? '/works?add=1' : `/sign-in?next=${encodeURIComponent('/works?add=1')}`;
---
<BaseLayout title="Explore Works" description="Explore works published by Opus members: singles, EPs, albums and mixtapes, with the people who made them.">
  <ProductNav product="works" current="explore" />
  <section class="px-sec px-sec--tight">
    <div class="px-wrap">
      <div class="ex-head">
        <h1 class="px-title">Explore Works</h1>
        <p class="px-lead">Music published by Opus members, with credits confirmed by the people who made it.</p>
      </div>
      <nav class="ex-filter" aria-label="Type">
        {filters.map(([k, l]) => <a href={href(k)} aria-current={k === kind ? 'page' : undefined}>{l}</a>)}
        {!failed && <span class="ex-count" aria-live="polite">{res.total} {res.total === 1 ? 'work' : 'works'}</span>}
      </nav>

      {failed ? (
        <div class="px-state px-state--error"><h3>Works couldn’t be loaded just now.</h3><p>Please try again in a moment.</p><div class="px-ctas"><a class="px-btn px-btn--line px-btn--sm" href={href(kind, page)}>Try again</a></div></div>
      ) : res.works.length ? (
        <>
          <ul class="px-grid ex-grid" role="list">{res.works.map((w) => <li><WorkCard href={`/r/${w.id}`} title={w.title} by={w.artist} kind={w.kind} year={w.releaseDate?.slice(0, 4)} coverKey={w.coverKey} /></li>)}</ul>
          {(page > 1 || more) && (
            <nav class="ex-pages" aria-label="Pages">
              {page > 1 ? <a class="px-btn px-btn--line px-btn--sm" href={href(kind, page - 1)}>Newer</a> : <span></span>}
              {more && <a class="px-btn px-btn--line px-btn--sm" href={href(kind, page + 1)}>Older</a>}
            </nav>
          )}
        </>
      ) : (
        <div class="px-state">
          <h3>{kind ? `No ${PLURAL[kind]!.toLowerCase()} published yet.` : 'No member has published a work yet.'}</h3>
          <p>Works appear here as members publish them.{kind ? ' Try another type, or add yours.' : ' Add yours and it can be the first.'}</p>
          <div class="px-ctas"><a class="px-btn px-btn--go px-btn--sm" href={addHref} {...(user ? { 'data-add-work': '' } : {})}>Add Work</a>{kind && <a class="px-btn px-btn--line px-btn--sm" href={href(null)}>See all types</a>}</div>
        </div>
      )}
    </div>
  </section>

  <section class="px-sec px-sec--tight px-tone-cream ex-cat" aria-labelledby="ex-cat">
    <div class="px-wrap">
      <div class="px-rowhead">
        <div><h2 class="px-h3" id="ex-cat">From the Opus Collective catalog</h2><p class="ex-cat__sub">Releases by Collective artists.</p></div>
        <a class="px-btn px-btn--text" href="/releases">See the catalog</a>
      </div>
      <ul class="ex-cat__row" role="list">{CATALOG.slice(0, 6).map((c) => (
        <li><a class="ex-cat__item" href={c.href}><span class="px-art"><img src={c.cover} alt="" loading="lazy" decoding="async" /></span><b>{c.title}</b><small>{c.artist}</small></a></li>
      ))}</ul>
    </div>
  </section>
  {user && <AddWork profile={profile ?? null} />}
</BaseLayout>

<style>
  .ex-head { display: flex; flex-direction: column; gap: 14px; }
  .ex-filter { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 28px 0 24px; }
  .ex-filter a { display: inline-flex; align-items: center; height: 36px; padding: 0 16px; border: 1px solid var(--line); border-radius: var(--r-pill); font-size: 14px; color: var(--text-2);
    transition: border-color var(--m-hover) var(--m-ease), color var(--m-hover) var(--m-ease), background-color var(--m-hover) var(--m-ease); }
  .ex-filter a:hover { border-color: var(--line-strong); color: var(--text); }
  .ex-filter a[aria-current] { background: var(--text); border-color: var(--text); color: var(--bg); }
  .ex-filter a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ex-count { margin-left: auto; font-size: 13px; color: var(--text-3); }
  .ex-pages { display: flex; justify-content: space-between; margin-top: 36px; }
  .ex-cat__sub { margin: 6px 0 0; font-size: 14px; color: var(--text-2); }
  .ex-cat__row { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--px-gap); margin: 0; padding: 0; }
  .ex-cat__item { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .ex-cat__item .px-art { margin-bottom: 8px; }
  .ex-cat__item b { font-size: 14px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ex-cat__item small { font-size: 12px; color: var(--text-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 860px) { .ex-cat__row { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .ex-count { width: 100%; margin: 6px 0 0; } }
</style>
