---
/**
 * Explore Works: every published work from a published profile, newest first, filterable by type.
 * Real records only. Until members have published, the page shows the Opus Collective catalog as a labelled showcase
 * (art direction 2026-11-21); it never announces an empty directory.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductNav from '@/components/product/ProductNav.astro';
import AddWork from '@/components/works/AddWork.astro';
import WorkCard from '@/components/works/WorkCard.astro';
import { CATALOG } from '@/data/catalog';
import { RELEASE_KINDS } from '@/data/music';
import { listPublicWorks, type PublicWork } from '@/server/releases';
import WorksFloat from '@/components/works/WorksFloat.astro';
import '@/styles/product.css';
import '@/styles/works.css';
export const prerender = false;

const PER = 24;
const kindIn = Astro.url.searchParams.get('type');
const kind = kindIn && kindIn in RELEASE_KINDS ? kindIn : null;
const page = Math.max(1, Math.min(200, Number(Astro.url.searchParams.get('page')) || 1));
let res: { works: PublicWork[]; total: number } = { works: [], total: 0 };
let failed = false;
try { res = await listPublicWorks(Astro.locals.runtime.env.DB, { kind, limit: PER, offset: (page - 1) * PER }); } catch (e) { console.error('explore works', e); failed = true; }
const user = Astro.locals.user;
const profile = user ? await Astro.locals.runtime.env.DB.prepare("SELECT handle, status FROM profiles WHERE owner_user_id = ? AND kind = 'musician'").bind(user.id).first<{ handle: string; status: string }>() : null;
const PLURAL: Record<string, string> = { single: 'Singles', ep: 'EPs', album: 'Albums', mixtape: 'Mixtapes' };
const filters: [string | null, string][] = [[null, 'All'], ...Object.keys(RELEASE_KINDS).map((k) => [k, PLURAL[k]!] as [string, string])];
const href = (k: string | null, p = 1) => { const q = new URLSearchParams(); if (k) q.set('type', k); if (p > 1) q.set('page', String(p)); const s = q.toString(); return `/works/explore${s ? `?${s}` : ''}`; };
const more = page * PER < res.total;
const addHref = user ? '/works?add=1' : `/sign-in?next=${encodeURIComponent('/works?add=1')}`;
---
<BaseLayout title="Explore Works" description="Explore works published by Opus members: singles, EPs, albums and mixtapes, with the people who made them.">
  <ProductNav product="works" current="explore" />
  <div class="wk">
    <div class="wk-wrap">
      <div class="wk-bar">
        <h1>Explore</h1>
        <nav class="wk-chips" aria-label="Type">
          {filters.map(([k, l]) => <a href={href(k)} aria-current={k === kind ? 'page' : undefined}>{l}</a>)}
        </nav>
        {!failed && res.total > 0 && <span class="wk-bar__n" aria-live="polite">{res.total} {res.total === 1 ? 'work' : 'works'}</span>}
      </div>

      {failed && <div class="px-state px-state--error"><h3>Works couldn’t be loaded just now.</h3><p>Please try again in a moment.</p><div class="px-ctas"><a class="px-btn px-btn--line px-btn--sm" href={href(kind, page)}>Try again</a></div></div>}

      {res.works.length > 0 && (
        <>
          <ul class="wk-grid" role="list">{res.works.map((w) => <li><WorkCard href={`/r/${w.id}`} title={w.title} by={w.artist} kind={w.kind} year={w.releaseDate?.slice(0, 4)} coverKey={w.coverKey} /></li>)}</ul>
          {(page > 1 || more) && (
            <nav class="wk-pages" aria-label="Pages">
              {page > 1 ? <a class="px-btn px-btn--line px-btn--sm" href={href(kind, page - 1)}>Newer</a> : <span></span>}
              {more && <a class="px-btn px-btn--line px-btn--sm" href={href(kind, page + 1)}>Older</a>}
            </nav>
          )}
        </>
      )}
    </div>

    <section class="wk-show" aria-labelledby="wk-show">
      <div class="wk-wrap">
        <div class="wk-show__head">
          <h2 id="wk-show"><span class="wk-ex">Showcase</span> Opus Collective catalog</h2>
          <p>{res.works.length ? 'Releases by Collective artists.' : 'Releases by Collective artists. Member works appear here as they’re published.'}</p>
        </div>
        {res.works.length ? (
          <ul class="wk-mosaic wk-mosaic--row" role="list">{CATALOG.slice(0, 6).map((c) => (
            <li><a href={c.href}><span class="wk-art"><img src={c.cover} alt="" loading="lazy" decoding="async" /></span><span><b>{c.title}</b><small>{c.artist}</small></span></a></li>
          ))}</ul>
        ) : (
          <ul class="wk-mosaic" role="list">
            {CATALOG.map((c, i) => (
              <li><a href={c.href}><span class:list={['wk-art', i === 0 && 'wk-shadow']}><img src={c.cover} alt="" loading={i < 5 ? 'eager' : 'lazy'} decoding="async" /></span><span><b>{c.title}</b><small>{c.artist}</small></span></a></li>
            ))}
            <li>
              <button class="wk-add" type="button" {...(user ? { 'data-add-work': '' } : {})} data-href={user ? undefined : addHref}>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                <span>Your work here</span>
              </button>
            </li>
          </ul>
        )}
      </div>
    </section>
  </div>
  {user && <AddWork profile={profile ?? null} />}
  <WorksFloat />
</BaseLayout>

<script>
  // Signed-out visitors: the add tile signs in first and returns to the Add Work sheet.
  document.querySelectorAll<HTMLButtonElement>('.wk-add[data-href]').forEach((b) => b.addEventListener('click', () => { location.href = b.dataset.href!; }));
</script>
