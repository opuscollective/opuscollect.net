---
/**
 * A Clan's public page, shareable by URL: roster (accepted members only), selected Works and upcoming Events.
 * Admins see their tools on the same page: add band members (existing Opus members or an invite link), edit roles,
 * link Works and host an event as the group. Open spots and invitations are only ever rendered for admins.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlaceSelect from '@/components/business/PlaceSelect.astro';
import EventPoster from '@/components/events/EventPoster.astro';
import { clanAdmins, GROUP_TYPES, ROLE_SUGGESTIONS, clanWorks, eligibleWorks, getClanByHandle, isClanAdmin, roster } from '@/server/clans';
import { listHostedEvents } from '@/server/events';
import { getMyProfile } from '@/server/profiles';
import { RELEASE_KINDS } from '@/data/music';
import '@/styles/app.css';
import '@/styles/events.css';
import '@/styles/music.css';
import '@/styles/clans.css';
export const prerender = false;

const db = Astro.locals.runtime.env.DB;
const viewer = Astro.locals.user;
const clan = await getClanByHandle(db, Astro.params.handle ?? '');
const admin = clan ? await isClanAdmin(db, clan, viewer?.id) : false;
if (!clan || (clan.status !== 'published' && !admin)) {
  return new Response(`<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Not found · Opus</title><body style="margin:0;min-height:100vh;display:grid;place-items:center;background:#050506;color:#f2efea;font-family:system-ui,sans-serif;text-align:center"><div><p style="color:#8a858c;letter-spacing:.12em;font-size:12px;text-transform:uppercase">Opus</p><h1 style="font-weight:500">This page isn’t available.</h1><p style="color:#a39da5">The link may be wrong, or the page was taken down.</p><p><a href="/clans" style="color:#f2efea">Explore groups</a></p></div></body>`, { status: 404, headers: { 'content-type': 'text/html; charset=utf-8' } });
}
if (clan.handle !== Astro.params.handle) return Astro.redirect(clan.href, 301);

const [members, works, events] = await Promise.all([roster(db, clan, admin), clanWorks(db, clan.id), listHostedEvents(db, clan.id)]);
const active = members.filter((m) => m.status === 'active');
const pendingSpots = members.filter((m) => m.status === 'open' || m.status === 'invited' || m.status === 'declined');
const eligible = admin ? await eligibleWorks(db, clan.id) : [];
const myInvite = viewer && !admin ? await db.prepare("SELECT id, roles FROM clan_members WHERE clan_id = ? AND user_id = ? AND status = 'invited'").bind(clan.id, viewer.id).first<{ id: string; roles: string }>() : null;
const amMember = viewer ? !!(await db.prepare("SELECT 1 AS x FROM clan_members WHERE clan_id = ? AND user_id = ? AND status = 'active'").bind(clan.id, viewer.id).first()) : false;
const myProfile = admin && viewer ? await getMyProfile(db, viewer.id) : null;
const admins = admin ? await clanAdmins(db, clan) : [];
const isOwner = !!viewer && clan.ownerUserId === viewer.id;
const featured = works.find((w) => w.cover) ?? works[0] ?? null;
const T = GROUP_TYPES[clan.groupType];
const initials = (s: string) => s.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
const onRoster = !!viewer && active.some((m) => m.userId === viewer.id);
// Private to managers: what's still missing. Public sections with nothing in them simply don't render.
const todo = admin ? [
  !clan.photo && { key: 'photo', label: 'Add a photo' },
  !clan.bio && { key: 'bio', label: 'Write a short bio' },
  !onRoster && { key: 'members', label: myProfile ? 'Add yourself as a member' : 'Add members' },
  works.length === 0 && eligible.length > 0 && { key: 'works', label: 'Choose shared work' },
].filter(Boolean) as { key: string; label: string }[] : [];
const STATUS = { open: 'Invite link not used yet', invited: 'Invited, waiting for an answer', declined: 'Declined' } as Record<string, string>;
const desc = `${clan.name} · ${clan.typeLabel}${clan.place ? ` · ${clan.place}` : ''} on Opus.`;
---
<BaseLayout title={clan.name} description={desc} image={clan.photo ?? undefined}>
  <article class="cl" data-clan={clan.id}>
    {clan.isSample && <p class="notice notice--warn cl-sample"><b>Development data.</b> This group and its members are sample records for the preview build, not real people.</p>}
    {myInvite && (
      <div class="panel cl-invite" data-invite={myInvite.id}>
        <p><b>{clan.name} invited you to join</b>{JSON.parse(myInvite.roles).length ? ` as ${JSON.parse(myInvite.roles).join(', ')}` : ''}. Only you and the group’s managers can see this.</p>
        <div class="row"><button class="btn-app" type="button" data-respond="accept">Accept</button><button class="btn-app btn-app--ghost" type="button" data-respond="decline">Decline</button></div>
      </div>
    )}

    {admin && todo.length > 0 && (
      <aside class="cl-todo" aria-label="Finish your page">
        <p class="cl-todo__h"><b>Finish your page</b><span>Only you can see this</span></p>
        <ul role="list">
          {todo.map((t) => (
            <li>{t.key === 'photo'
              ? <label class="cl-todo__a">{t.label}<input type="file" accept="image/*" hidden data-photo /></label>
              : <button type="button" class="cl-todo__a" data-open={t.key === 'bio' ? 'edit' : t.key}>{t.label}</button>}</li>
          ))}
        </ul>
      </aside>
    )}

    <header class:list={['cl__open', { 'has-art': !!clan.photo }]}>
      {clan.photo && <div class="cl__art" style={`background-image:url(${clan.photo})`} role="img" aria-label={clan.name}></div>}
      <div class="cl__intro">
        <p class="cl__type">{[clan.typeLabel, clan.place].filter(Boolean).join(' · ')}</p>
        <h1 class="cl__name">{clan.name}</h1>
        {clan.bio && <p class="cl__bio">{clan.bio}</p>}
        {featured && (
          <a class="cl-feat" href={`/r/${featured.id}`}>
            <span class="cl-feat__cover" style={featured.cover ? `background-image:url(${featured.cover})` : ''}></span>
            <span class="cl-feat__txt"><small>{featured.released ? 'Latest' : 'Coming'}</small><b>{featured.title}</b></span>
            <span class="cl-feat__go">Listen</span>
          </a>
        )}
        <div class="cl__actions">
          {admin && <a class="btn-app btn-app--ghost" href="#manage" data-open="manage">Manage</a>}
          <button class="cl__quiet" type="button" data-share>Share</button>
          {amMember && <button class="cl__quiet" type="button" data-leave>Leave group</button>}
        </div>
      </div>
    </header>
    <p class="dim mu-err" data-page-status role="alert"></p>

    {active.length > 0 && (
      <section class="cl__sec" aria-labelledby="cl-roster">
        <h2 id="cl-roster">Members</h2>
        <ul class="cl-roster" role="list">
          {active.map((m) => {
            const inner = <>
              <span class="cl-m__ph" style={m.photo ? `background-image:url(${m.photo})` : ''}>{!m.photo && initials(m.name)}</span>
              <span class="cl-m__name">{m.name}</span>{m.roles.length > 0 && <span class="cl-m__roles">{m.roles.join(', ')}</span>}
            </>;
            return (
              <li>
                {m.handle && m.profilePublished ? <a class="cl-m" href={`/m/${m.handle}`}>{inner}</a> : <div class="cl-m">{inner}</div>}
                {admin && (m.isOwner ? <span class="cl-m__tag">Owner</span> : <button class="cl-m__tag" type="button" data-spot-remove={m.id}>Remove</button>)}
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {works.length > 0 && (
      <section class="cl__sec" aria-labelledby="cl-works">
        <h2 id="cl-works">Shared work</h2>
        <ul class="cl-works-grid" role="list">{works.map((w) => (
          <li><a class="cl-w" href={`/r/${w.id}`}>
            <span class="cl-w__cover" style={w.cover ? `background-image:url(${w.cover})` : ''}></span>
            <b>{w.title}</b>
            <small>{[RELEASE_KINDS[w.kind as keyof typeof RELEASE_KINDS], w.released ? w.releaseDate?.slice(0, 4) : 'Coming'].filter(Boolean).join(' · ')}</small>
          </a>{admin && <button type="button" class="cl-w__rm" data-unlink-work={w.id}>Remove from page</button>}</li>
        ))}</ul>
      </section>
    )}

    {events.length > 0 && (
      <section class="cl__sec" aria-labelledby="cl-events">
        <h2 id="cl-events">Upcoming</h2>
        <div class="ev-grid cl-ev">
          {events.map((e) => (
            <a class="ev-card" href={e.href}>
              <EventPoster image={e.image} startAt={e.startAt} timezone={e.timezone} category={e.categoryLabel} small />
              <span class="ev-card__body">
                <span class="ev-card__when">{e.when}</span>
                <span class="ev-card__title">{e.title}</span>
                <span class="ev-card__where">{e.venue}{e.place && ` · ${e.place.split(',')[0]}`}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    {admin && (
      <section class="cl-admin" id="manage" aria-label="Manage this group">
        <h2 class="cl-admin__h">Manage {clan.name}</h2>
        <nav class="cl-admin__nav" aria-label="Manage sections">
          <a href="#invite">Invites</a><a href="#admins">Admins</a><a href="#members">Members</a><a href="#works">Shared work</a><a href="#edit" data-open="edit">Edit page</a>
        </nav>
        <div class="panel" id="invite">
          <h2>Invite link</h2>
          <p class="dim">Anyone with this link can join as a member. They’ll see {clan.name} first, and can create an account along the way. Members never get admin access.</p>
          <div class="cl-link" style="margin-top:12px"><input class="input" readonly data-invite-url placeholder="Loading…" aria-label="Invite link" /><button class="btn-app" type="button" data-invite-copy>Copy link</button></div>
          <p style="margin:10px 0 0"><button type="button" class="link" style="background:none;border:0;font:inherit;color:var(--text-3);cursor:pointer" data-invite-renew>Replace link</button> <span class="dim" style="font-size:13px">The old link stops working.</span></p>
        </div>
        <div class="panel" id="admins">
          <h2>Admins</h2>
          <p class="dim">Admins can edit the page, the roster and invites. This is separate from the public member list: leaving the roster never removes admin access.</p>
          <ul class="cl-spots" role="list">
            {admins.map((a) => (
              <li class="cl-spot" data-admin={a.userId}>
                <div class="cl-spot__who"><b>{a.name}</b><small>{a.isOwner ? 'Owner' : 'Admin'}{a.userId === viewer?.id && ' · You'} · {a.onRoster ? 'Shown as a member' : 'Not on the public roster'}</small></div>
                {!a.isOwner && (isOwner || a.userId === viewer?.id) && <div class="cl-spot__acts"><button type="button" data-admin-remove>{a.userId === viewer?.id ? 'Step down' : 'Remove'}</button></div>}
              </li>
            ))}
          </ul>
          <form class="cl-add" data-admin-form novalidate style="margin-top:14px">
            <label class="field"><span>Add an admin</span><input class="input" name="handle" maxlength="60" autocomplete="off" placeholder="Their Opus username" /></label>
            <div data-status class="form-status field--wide"></div>
            <div class="row"><button class="btn-app btn-app--ghost" type="submit">Make admin</button></div>
          </form>
        </div>

        <div class="panel" id="members">
          <h2>{T.membersStep}</h2>
          <p class="dim">List each member with their role. If they’re on Opus, add their username and they’ll get an invitation in their account. If they’re new, you’ll get an invite link for their spot to send them. Nobody shows on the public page until they accept.</p>
          {!onRoster && (myProfile ? (
            <form class="cl-me" data-me-form novalidate>
              <p><b>Show yourself as a member</b><br /><span class="dim">You manage this group either way. This adds your own profile to the public roster.</span></p>
              <input class="input" name="roles" maxlength="120" placeholder={T.rolePlaceholder} aria-label="Your role" />
              <button class="btn-app btn-app--ghost" type="submit">Add me</button>
              <div data-status class="form-status"></div>
            </form>
          ) : <p class="dim cl-me">Want to appear as a member? <a class="link" href="/start">Create your profile</a> first. Managing the group doesn’t need one.</p>)}
          <form class="cl-add" data-add-form novalidate>
            <label class="field"><span>Display name *</span><input class="input" name="name" maxlength="80" autocomplete="off" placeholder="Their name" /></label>
            <label class="field"><span>Opus username</span><input class="input" name="handle" maxlength="60" autocomplete="off" placeholder="Leave empty if they’re new" /></label>
            <label class="field field--wide"><span>Role in the {clan.typeLabel.toLowerCase()}</span><input class="input" name="roles" maxlength="160" placeholder={T.rolePlaceholder} data-roles />
              <span class="cl-rolepick">{ROLE_SUGGESTIONS.map((r) => <button type="button" data-role={r}>{r}</button>)}</span>
              <small>One or more roles, separated by commas.</small>
            </label>
            <div data-status class="form-status field--wide"></div>
            <div class="row"><button class="btn-app" type="submit">Add to roster</button></div>
          </form>
          {pendingSpots.length > 0 && (
            <ul class="cl-spots" role="list" aria-label="Not public yet">
              {pendingSpots.map((m) => (
                <li class="cl-spot" data-spot={m.id}>
                  <div class="cl-spot__who"><b>{m.name}</b><small>{m.roles.join(', ') || 'No role yet'}{m.handle && ` · @${m.handle}`}</small><span class="cl-spot__st">{STATUS[m.status]}</span></div>
                  <div class="cl-spot__acts">
                    <button type="button" data-edit-roles={m.roles.join(', ')}>Edit role</button>
                    {m.status === 'open' && <button type="button" data-renew>New invite link</button>}
                    <button type="button" data-remove>{m.status === 'declined' ? 'Clear' : 'Withdraw'}</button>
                  </div>
                </li>
              ))}
            </ul>
          )}
          <p class="cl__empty" style="margin-top:14px">Only admins see this list. Spot links work once, for that spot.</p>
        </div>

        <div class="panel" id="works">
          <h2>Shared work</h2>
          <p class="dim">Pick the Works to show on the page. Any published Work by, or crediting, someone on the roster can be added.</p>
          {eligible.length ? (
            <div class="cl-works">{eligible.map((w) => (
              <label><input type="checkbox" data-link-work={w.id} /> {w.title} <small>{[w.artist, RELEASE_KINDS[w.kind as keyof typeof RELEASE_KINDS], w.releaseDate?.slice(0, 4)].filter(Boolean).join(' · ')}</small></label>
            ))}</div>
          ) : <p class="cl__empty" style="margin-top:12px">Nothing to add yet. Published Works from members show here.</p>}
        </div>

        <details class="panel" id="edit">
          <summary style="cursor:pointer;font-size:18px;font-weight:500">Edit details</summary>
          <form class="form" data-edit-form novalidate style="margin-top:18px">
            <label class="field"><span>{clan.groupType === 'band' ? 'Band name' : 'Name'}</span><input class="input" name="name" maxlength="80" value={clan.name} /></label>
            <label class="field"><span>Type</span><select class="select" name="groupType">{Object.entries(GROUP_TYPES).map(([k, v]) => <option value={k} selected={k === clan.groupType}>{v.label}</option>)}</select></label>
            <label class="field"><span>City</span><PlaceSelect selected={clan.placeId} /></label>
            <label class="field"><span>Short bio</span><textarea class="textarea" name="bio" maxlength="600" rows="4">{clan.bio}</textarea></label>
            <div class="field"><span>Photo</span><label class="btn-app btn-app--ghost" style="align-self:flex-start">Change photo<input type="file" accept="image/*" hidden data-photo /></label></div>
            <div data-status class="form-status"></div>
            <div class="row"><button class="btn-app" type="submit">Save</button></div>
          </form>
        </details>
      </section>
    )}

  </article>
</BaseLayout>

<script>
  import { bindForm, status, values } from '@/scripts/form';
  import { prepareImage } from '@/scripts/image';
  const root = document.querySelector<HTMLElement>('[data-clan]')!;
  const id = root.dataset.clan!;
  const pageStatus = root.querySelector<HTMLElement>('[data-page-status]')!;
  const say = (m: string) => { pageStatus.textContent = m; };
  async function act(body: Record<string, unknown>, url = `/api/clans/${id}`) {
    const r = await fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body), credentials: 'same-origin' });
    const d = await r.json().catch(() => ({})) as Record<string, unknown>;
    if (!r.ok) throw new Error(String(d.error ?? 'Something went wrong. Please try again.'));
    return d;
  }
  const reload = () => location.reload();

  root.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', (ev) => {
    const t = document.getElementById(b.dataset.open!);
    if (!t) return;
    ev.preventDefault();
    if (t instanceof HTMLDetailsElement) t.open = true;
    t.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  const inviteUrl = root.querySelector<HTMLInputElement>('[data-invite-url]');
  if (inviteUrl) {
    const load = async (renew: boolean) => { try { inviteUrl.value = String((await act({ action: 'invite-link', renew })).link); } catch (e) { say((e as Error).message); } };
    load(false);
    const copy = root.querySelector<HTMLButtonElement>('[data-invite-copy]')!;
    copy.addEventListener('click', async () => {
      if (!inviteUrl.value) return;
      try { await navigator.clipboard.writeText(inviteUrl.value); } catch { inviteUrl.select(); document.execCommand('copy'); }
      copy.textContent = 'Copied'; setTimeout(() => { copy.textContent = 'Copy link'; }, 2000);
    });
    root.querySelector('[data-invite-renew]')?.addEventListener('click', () => { if (confirm('Replace the invite link? The current one will stop working.')) load(true); });
  }
  const adminForm = root.querySelector<HTMLFormElement>('[data-admin-form]');
  if (adminForm) bindForm(adminForm, { url: `/api/clans/${id}`, body: (f) => ({ action: 'admin-add', ...values(f) }), busyLabel: 'Adding…', onSuccess: reload });
  root.querySelectorAll<HTMLElement>('[data-admin]').forEach((li) => li.querySelector('[data-admin-remove]')?.addEventListener('click', async (ev) => {
    const self = (ev.currentTarget as HTMLElement).textContent === 'Step down';
    if (!confirm(self ? 'Step down as admin? You’ll no longer be able to manage this group.' : 'Remove this admin? They’ll stay on the roster if they’re a member.')) return;
    try { await act({ action: 'admin-remove', userId: li.dataset.admin }); if (self) location.href = '/clans/mine'; else reload(); } catch (e) { say((e as Error).message); }
  }));
  const me = root.querySelector<HTMLFormElement>('[data-me-form]');
  if (me) bindForm(me, { url: `/api/clans/${id}`, body: (f) => ({ action: 'add-me', ...values(f) }), busyLabel: 'Adding…', onSuccess: reload });
  root.querySelector('[data-share]')?.addEventListener('click', async () => {
    const url = location.origin + location.pathname;
    try { if (navigator.share) await navigator.share({ title: document.title, url }); else { await navigator.clipboard.writeText(url); say('Link copied.'); } } catch { /* dismissed */ }
  });
  root.querySelectorAll<HTMLButtonElement>('[data-respond]').forEach((b) => b.addEventListener('click', async () => {
    try { await act({ spotId: b.closest<HTMLElement>('[data-invite]')!.dataset.invite, action: b.dataset.respond }, '/api/clans/respond'); reload(); } catch (e) { say((e as Error).message); }
  }));
  root.querySelector('[data-leave]')?.addEventListener('click', async () => {
    if (!confirm('Leave this group? You’ll come off its member list right away. Your profile and credits stay as they are.')) return;
    try { await act({ action: 'leave' }); reload(); } catch (e) { say((e as Error).message); }
  });

  const add = root.querySelector<HTMLFormElement>('[data-add-form]');
  if (add) {
    const roles = add.querySelector<HTMLInputElement>('[data-roles]')!;
    add.querySelectorAll<HTMLButtonElement>('[data-role]').forEach((b) => b.addEventListener('click', () => {
      const cur = roles.value.split(',').map((s) => s.trim()).filter(Boolean);
      if (!cur.some((c) => c.toLowerCase() === b.dataset.role!.toLowerCase())) cur.push(b.dataset.role!);
      roles.value = cur.join(', ');
    }));
    bindForm(add, {
      url: `/api/clans/${id}`,
      body: (f) => ({ action: 'add-spot', ...values(f) }),
      busyLabel: 'Adding…',
      onSuccess: (d) => {
        if (d.link) {
          // Show the invite link once, ready to send. It is not stored anywhere readable.
          const box = document.createElement('div');
          box.className = 'notice notice--ok field--wide';
          box.innerHTML = '<b></b><div class="cl-link" style="margin-top:10px"><input class="input" readonly /><button class="btn-app" type="button">Copy</button></div><p style="margin:8px 0 0;font-size:13px">Send this to them. It works once, for this spot. Their spot stays private until they accept.</p>';
          box.querySelector('b')!.textContent = `Invite link for ${String(d.name)}`;
          const inp = box.querySelector('input')!; inp.value = String(d.link);
          box.querySelector('button')!.addEventListener('click', async () => { inp.select(); try { await navigator.clipboard.writeText(inp.value); } catch { document.execCommand('copy'); } box.querySelector('button')!.textContent = 'Copied'; });
          add.querySelector('.form-status')!.replaceWith(box);
          add.reset();
          box.insertAdjacentHTML('afterend', '<div class="row field--wide"><button class="btn-app btn-app--ghost" type="button" data-done>Done</button></div>');
          add.querySelector('[data-done]')!.addEventListener('click', reload);
        } else reload();
      },
    });
  }
  root.querySelectorAll<HTMLElement>('[data-spot]').forEach((li) => {
    const spotId = li.dataset.spot;
    li.querySelector('[data-remove]')?.addEventListener('click', async () => { try { await act({ action: 'remove-spot', spotId }); reload(); } catch (e) { say((e as Error).message); } });
    li.querySelector<HTMLElement>('[data-edit-roles]')?.addEventListener('click', async (ev) => {
      const v = prompt('Role in the group (comma separated)', (ev.currentTarget as HTMLElement).dataset.editRoles ?? '');
      if (v === null) return;
      try { await act({ action: 'edit-spot', spotId, roles: v }); reload(); } catch (e) { say((e as Error).message); }
    });
    li.querySelector('[data-renew]')?.addEventListener('click', async () => {
      try {
        const d = await act({ action: 'renew-link', spotId });
        const row = document.createElement('div'); row.className = 'cl-link';
        row.innerHTML = '<input class="input" readonly /><button class="btn-app" type="button">Copy</button>';
        const inp = row.querySelector('input')!; inp.value = String(d.link);
        row.querySelector('button')!.addEventListener('click', async () => { try { await navigator.clipboard.writeText(inp.value); } catch { inp.select(); document.execCommand('copy'); } row.querySelector('button')!.textContent = 'Copied'; });
        li.append(row);
      } catch (e) { say((e as Error).message); }
    });
  });
  root.querySelectorAll<HTMLButtonElement>('[data-spot-remove]').forEach((b) => b.addEventListener('click', async () => {
    if (!confirm('Remove this member from the roster? Their own profile and Works are not affected.')) return;
    try { await act({ action: 'remove-spot', spotId: b.dataset.spotRemove }); reload(); } catch (e) { say((e as Error).message); }
  }));
  root.querySelectorAll<HTMLInputElement>('[data-link-work]').forEach((c) => c.addEventListener('change', async () => {
    try { await act({ action: c.checked ? 'link-work' : 'unlink-work', releaseId: c.dataset.linkWork }); } catch (e) { c.checked = !c.checked; say((e as Error).message); }
  }));
  root.querySelectorAll<HTMLButtonElement>('[data-unlink-work]').forEach((b) => b.addEventListener('click', async () => {
    try { await act({ action: 'unlink-work', releaseId: b.dataset.unlinkWork }); reload(); } catch (e) { say((e as Error).message); }
  }));
  const edit = root.querySelector<HTMLFormElement>('[data-edit-form]');
  if (edit) {
    bindForm(edit, { url: `/api/clans/${id}`, body: (f) => ({ action: 'update', ...values(f) }), busyLabel: 'Saving…', onSuccess: reload });
  }
  root.querySelectorAll<HTMLInputElement>('[data-photo]').forEach((inp) => inp.addEventListener('change', async (e) => {
    const f = (e.target as HTMLInputElement).files?.[0];
    if (!f) return;
    try {
      const blob = await prepareImage(f, 1600, 'free');
      const r = await fetch(`/api/clans/${id}/image`, { method: 'POST', headers: { 'content-type': 'image/jpeg' }, body: blob, credentials: 'same-origin' });
      if (!r.ok) throw new Error(String(((await r.json().catch(() => ({}))) as { error?: string }).error ?? 'Upload failed.'));
      reload();
    } catch (err) { say((err as Error).message); }
  }));
</script>
