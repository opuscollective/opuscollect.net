---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { verifyEmail } from '@/server/auth';
import { getMyStudio } from '@/server/business';
import { getMyProfile } from '@/server/profiles';
import { EMAIL_CONFIRM_REQUIRED } from '@/lib/features';
import '@/styles/app.css';
export const prerender = false;
const token = Astro.url.searchParams.get('token') ?? '';
const env = Astro.locals.runtime.env;
const ok = token ? await verifyEmail(env, token) : false;
// Continue where they were: a studio owner with no member profile goes to the studio dashboard, everyone else to their profile.
const me = Astro.locals.user;
let dest = { href: '/account/profile', label: 'Continue to your profile' };
if (ok && me) {
  const [studio, profile] = await Promise.all([getMyStudio(env.DB, me.id).catch(() => null), getMyProfile(env.DB, me.id).catch(() => null)]);
  if (studio && !profile) dest = { href: '/business', label: 'Continue to your studio' };
  else if (!profile) dest = { href: '/start', label: 'Set up your profile' };
}
---
<BaseLayout title={ok ? 'Email confirmed' : 'Confirm your email'} noindex>
  <section class="app app--center">
    <div class="app__wrap">
      <p class="t-meta app__kicker">Account</p>
      {ok ? (
        <>
          <h1 class="app__title">Your email is confirmed.</h1>
          <p class="app__lead">{EMAIL_CONFIRM_REQUIRED ? 'You can now publish and connect with other members.' : 'Your account is secured.'}</p>
          <p class="app__alt"><a class="btn-app" href={me ? dest.href : '/sign-in?next=/account'}>{me ? dest.label : 'Sign in to continue'}</a></p>
        </>
      ) : (
        <>
          <h1 class="app__title">This link didn’t work.</h1>
          <p class="app__lead">It may have expired (links last 24 hours) or already been used. Sign in and send a new one from your account page.</p>
          <p class="app__alt"><a class="btn-app" href="/account">Go to your account</a></p>
        </>
      )}
    </div>
  </section>
</BaseLayout>
