---
/**
 * Events: the product page. Upcoming public events from members, Collective gatherings, and Create an event.
 * Real events only; with none yet, it says so.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import EventPoster from '@/components/events/EventPoster.astro';
import ProductNav from '@/components/product/ProductNav.astro';
import { myEvents, ROLE_LABEL, type MyEvent } from '@/server/events';
import { listPublicEvents } from '@/server/events';
import { EVENTS } from '@/data/events';
import { listFollows, type FollowedCity } from '@/server/cities';
import '@/styles/app.css';
import '@/styles/events.css';
import '@/styles/product.css';
export const prerender = false;

let events: Awaited<ReturnType<typeof listPublicEvents>> = [];
let failed = false;
try { events = await listPublicEvents(Astro.locals.runtime.env.DB, { limit: 24 }); } catch (e) { console.error('events', e); failed = true; }
const user = Astro.locals.user;
// Followed cities lead: events there first, then everything (shown once each). Following never adds anything to My Future.
let myCities: FollowedCity[] = [];
let mine: typeof events = [];
if (user && !failed) {
  try {
    myCities = await listFollows(Astro.locals.runtime.env, user.id);
    if (myCities.length) mine = await listPublicEvents(Astro.locals.runtime.env.DB, { metroIds: myCities.map((c) => c.id), limit: 12 });
  } catch (e) { console.error('events: my cities', e); }
}
const mineIds = new Set(mine.map((e) => e.id));
const rest = events.filter((e) => !mineIds.has(e.id));
// Returning members: what they're hosting, playing or saved, first.
let next: MyEvent[] = [];
if (user) { try { next = (await myEvents(Astro.locals.runtime.env.DB, user.id)).filter((m) => m.event.startAt >= Date.now() - 3 * 3600_000).slice(0, 3); } catch (e) { console.error('events: mine', e); } }
const createHref = user ? '/events/new' : '/sign-in?next=/events/new';
const cityNames = myCities.map((c) => c.name);
const cityList = cityNames.length <= 2 ? cityNames.join(' and ') : `${cityNames.slice(0, -1).join(', ')} and ${cityNames.at(-1)}`;
---
<BaseLayout title="Events" description="Events on Opus. Make something happen: shows, sessions, workshops and listening parties from Opus members.">
  <ProductNav product="events" current="overview" />

  {next.length > 0 && (
    <section class="px-sec px-sec--tight" aria-labelledby="ev-next">
      <div class="px-wrap">
        <div class="px-rowhead">
          <h1 class="px-h3" id="ev-next">Your next events</h1>
          <a class="px-btn px-btn--text" href="/events/mine">All your events</a>
        </div>
        <div class="ev-grid ev-grid--3">
          {next.map(({ event: e, role }) => (
            <a class="ev-card" href={e.href}>
              <EventPoster image={e.image} startAt={e.startAt} timezone={e.timezone} category={e.categoryLabel} small />
              <span class="ev-card__body">
                <span class="ev-card__when">{e.when} · {ROLE_LABEL[role]}</span>
                <span class="ev-card__title">{e.title}</span>
                <span class="ev-card__where">{e.venue} · {e.place.split(',')[0]}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="px-tone-ink evh" aria-labelledby="evh-title">
    <div class="px-wrap evh__in">
      <div class="evh__copy">
        <p class="px-kicker">Events</p>
        {next.length ? <h2 class="px-display" id="evh-title">Make something happen.</h2> : <h1 class="px-display" id="evh-title">Make something happen.</h1>}
        <p class="px-lead">Shows, open mics, showcases, workshops and listening parties, created by Opus members. Feature the artists on your lineup; they’re listed once they accept.</p>
        <div class="px-ctas">
          <a class="px-btn px-btn--go" href={createHref}>Create Event</a>
          <a class="px-btn px-btn--line" href="#upcoming">See what’s coming</a>
        </div>
        <p class="evh__note">Opus doesn’t sell tickets. Save events to My Future to keep track.</p>
      </div>
      <a class="evh__wall" href="/community" aria-label="Opus Collective community programs">
        <img class="evh__a" src="/images/event-opus-sessions.jpg" alt="" width="1600" height="1600" decoding="async" fetchpriority="high" />
        <img class="evh__b" src="/images/event-king-of-the-hill.jpg" alt="" width="1600" height="640" decoding="async" />
        <img class="evh__c" src="/images/event-feedback-wednesday.jpg" alt="" width="1600" height="640" decoding="async" />
        <span class="evh__cap">Opus Collective community programs →</span>
      </a>
    </div>
  </section>

  <section class="px-sec px-sec--tight" id="upcoming">
    <div class="px-wrap">
      {myCities.length > 0 && (
        <div class="ev-block">
          <div class="px-rowhead">
            <div><h2 class="px-h3">In your cities</h2><p class="ev-sub">{cityList} · <a class="link" href="/future?tab=our&place=mine">See them in Our Future</a></p></div>
          </div>
          {mine.length === 0 ? <div class="px-state"><h3>No public events in your cities yet.</h3><p>When members create events there, they show here first.</p><div class="px-ctas"><a class="px-btn px-btn--go px-btn--sm" href={createHref}>Create one</a></div></div> : (
            <div class="ev-grid">
              {mine.map((e) => (
                <a class="ev-card" href={e.href}>
                  <EventPoster image={e.image} startAt={e.startAt} timezone={e.timezone} category={e.categoryLabel} small />
                  <span class="ev-card__body">
                    <span class="ev-card__when">{e.when}</span>
                    <span class="ev-card__title">{e.title}</span>
                    <span class="ev-card__where">{e.venue} · {e.place.split(',')[0]}</span>
                    <span class="ev-card__where">by {e.organizer.name}</span>
                  </span>
                </a>
              ))}
            </div>
          )}
        </div>
      )}

      <div class="ev-block">
        <div class="px-rowhead"><h2 class="px-h3">{myCities.length ? 'Everywhere' : 'Coming up'}</h2><a class="px-btn px-btn--text" href="/future?tab=our">Our Future</a></div>
        {failed ? <div class="px-state px-state--error"><h3>Events couldn’t be loaded just now.</h3><p>Please try again in a moment.</p></div>
          : rest.length === 0 && events.length === 0 ? (
          <div class="px-state">
            <h3>No member events yet</h3>
            <p>Be the first. Create an event and it shows here and in Our Future.</p>
            <div class="px-ctas"><a class="px-btn px-btn--go px-btn--sm" href={createHref}>Create Event</a></div>
          </div>
        ) : rest.length === 0 ? (
          <p class="ev-sub">Every upcoming event right now is in your cities.</p>
        ) : (
          <div class="ev-grid">
            {rest.map((e) => (
              <a class="ev-card" href={e.href}>
                <EventPoster image={e.image} startAt={e.startAt} timezone={e.timezone} category={e.categoryLabel} small />
                <span class="ev-card__body">
                  <span class="ev-card__when">{e.when}</span>
                  <span class="ev-card__title">{e.title}</span>
                  <span class="ev-card__where">{e.venue} · {e.place.split(',')[0]}</span>
                  <span class="ev-card__where">by {e.organizer.name}</span>
                </span>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="px-sec px-sec--tight px-tone-cream" aria-labelledby="ev-oc">
    <div class="px-wrap">
      <div class="px-rowhead"><h2 class="px-h3" id="ev-oc">From the Opus Collective</h2><a class="px-btn px-btn--text" href="/summit">The Summit</a></div>
      <ul class="ev-oc" role="list">
        {EVENTS.map((e) => <li><a href={e.href}><b>{e.title}</b><span>{e.place}</span><em>{e.when}</em></a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .evh__in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: center; padding-block: clamp(56px, 8vw, 112px); }
  .evh__copy { display: flex; flex-direction: column; gap: 20px; }
  .evh__copy .px-ctas { margin-top: 10px; }
  .evh__note { margin: 0; font-size: 14px; color: var(--text-3); }
  .evh__wall { position: relative; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-template-rows: auto auto; gap: 6px; }
  .evh__wall img { width: 100%; height: 100%; object-fit: cover; border-radius: 2px; transition: transform var(--m-card) var(--m-ease); }
  .evh__a { grid-column: 1 / 4; grid-row: 1 / 3; aspect-ratio: 1; }
  .evh__b { grid-column: 4 / 7; grid-row: 1; aspect-ratio: 5 / 3.4; }
  .evh__c { grid-column: 4 / 7; grid-row: 2; aspect-ratio: 5 / 3.4; }
  .evh__cap { position: absolute; left: 0; top: calc(100% + 10px); font-size: 13px; color: var(--text-3); transition: color var(--m-hover) var(--m-ease); }
  .evh__wall:hover .evh__cap { color: var(--text); }
  .evh__wall:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 860px) { .evh__in { grid-template-columns: 1fr; padding-bottom: 80px; } }
  .ev-block + .ev-block { margin-top: clamp(40px, 5vw, 64px); }
  .ev-sub { margin: 6px 0 0; font-size: 14px; color: var(--text-2); }
  .ev-block .ev-grid { margin-top: 0; }
  .ev-grid--3 { grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); margin-top: 0; }
  .ev-oc { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 3px; margin: 0; padding: 0; }
  .ev-oc a { display: flex; flex-direction: column; gap: 4px; padding: 20px; background: var(--surface); transition: background-color var(--m-hover) var(--m-ease); }
  .ev-oc a:hover { background: #fff; }
  .ev-oc b { font-size: 17px; font-weight: 500; }
  .ev-oc span { font-size: 14px; color: var(--text-2); }
  .ev-oc em { font-style: normal; font-size: 13px; color: var(--text-3); }
</style>
