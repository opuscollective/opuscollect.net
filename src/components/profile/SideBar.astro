---
/**
 * The profile's app bar (Bogo's sketch, 2026-11-26): World, Connections, Messages.
 * Desktop: a slim bar on the right edge. Phones: a tab bar along the bottom, where thumbs already expect one.
 * Badges are the header's own real counts (see SiteHeader's unread script); zero shows nothing.
 * The site header stays as it is; this sits beside it.
 */
interface Props { signedIn: boolean; next: string }
const { signedIn, next } = Astro.props;
const gate = (href: string) => (signedIn ? href : '/sign-in?next=' + encodeURIComponent(href));
---
<nav class="psb" aria-label="Opus">
  <a class="psb__i" href="/world">
    <span class="psb__ic"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.5 3.9 5.500 3.900 9s-1.300 6.500-3.900 9c-2.600-2.500-3.900-5.500-3.900-9S9.400 5.500 12 3Z"/></svg></span>
    <span class="psb__l">World</span>
  </a>
  <a class="psb__i" href={gate('/network')}>
    <span class="psb__ic"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.800"/><path d="M4.500 20.500c.9-3.900 3.800-6 7.500-6s6.600 2.100 7.500 6"/></svg>
      {signedIn && <b class="psb__b" data-hdr-req hidden></b>}
    </span>
    <span class="psb__l">Connections</span>
  </a>
  <a class="psb__i" href={signedIn ? '/network?messages=1' : gate(next)} data-open-messages={signedIn ? 'private' : undefined}>
    <span class="psb__ic"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.600 7.100L4 20.500l1.500-4.600A8 8 0 1 1 21 12z"/><path d="M8.600 12h.01M12 12h.01M15.400 12h.01" stroke-width="2"/></svg>
      {signedIn && <b class="psb__b" data-hdr-msg hidden></b>}
    </span>
    <span class="psb__l">Messages</span>
  </a>
</nav>

<style is:global>
  :root { --psb-w: 84px; --psb-h: 60px; }
  .psb { position: fixed; z-index: 44; display: flex; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(18px) saturate(1.2); -webkit-backdrop-filter: blur(18px) saturate(1.2); }
  .psb__i { display: flex; flex-direction: column; align-items: center; gap: 5px; color: var(--text-2); text-decoration: none; transition: color var(--dur) var(--ease), background var(--dur) var(--ease); }
  .psb__i:hover { color: var(--text); }
  .psb__i:focus-visible { outline: 2px solid var(--c-accent); outline-offset: -3px; }
  .psb__ic { position: relative; display: grid; place-items: center; }
  .psb__l { font-size: 11px; font-weight: 500; letter-spacing: 0; line-height: 1; }
  .psb__b { position: absolute; top: -6px; right: -10px; display: grid; place-items: center; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px; background: var(--c-verified, #2f80ff); color: #fff; font-size: 11px; font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; box-shadow: 0 0 0 2px var(--bg); }
  .psb__b[hidden] { display: none; }

  /* Desktop: the right edge, under the header, full height. */
  @media (min-width: 861px) {
    .psb { top: var(--hdr-h); right: 0; bottom: 0; width: var(--psb-w); flex-direction: column; align-items: stretch; gap: 6px; padding: 28px 8px; border-left: 1px solid var(--line); }
    .psb__i { padding: 14px 0 12px; border-radius: 14px; }
    .psb__i:hover { background: var(--surface-hover); }
    body:has(.psb) main, body:has(.psb) footer { margin-right: var(--psb-w); }
    /* Messages lives in the bar here, so the floating one steps aside; the Opus chip moves clear of the bar. */
    body:has(.psb) .om-launch { display: none; }
    body:has(.psb) .oa-launch { right: calc(var(--psb-w) + 16px); }
    body:has(.psb) .oa, body:has(.psb) .om { right: calc(var(--psb-w) + 16px); }
  }
  /* Phones: a tab bar along the bottom. */
  @media (max-width: 860px) {
    .psb { background: var(--bg); backdrop-filter: none; -webkit-backdrop-filter: none; left: 0; right: 0; bottom: 0; height: calc(var(--psb-h) + env(safe-area-inset-bottom)); padding: 0 8px env(safe-area-inset-bottom); border-top: 1px solid var(--line); }
    .psb__i { flex: 1; justify-content: center; gap: 4px; min-height: 44px; }
    .psb__ic svg { width: 24px; height: 24px; }
    .psb__l { font-size: 10.5px; }
    body:has(.psb) footer { padding-bottom: calc(var(--psb-h) + env(safe-area-inset-bottom)); }
    body:has(.psb) .om-launch { display: none; }
    body:has(.psb) .oa-launch { bottom: calc(var(--psb-h) + 12px + env(safe-area-inset-bottom)); }
    .om-open .psb { display: none; }
  }
</style>
