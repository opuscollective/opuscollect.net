---
/**
 * Level and achievements on a profile. Every number comes from recorded activity (src/server/progress.ts).
 * Visitors see what the member earned; the member also sees what is closest next.
 */
import { GROUP_LABEL, achievements, levelOf, nextUp, points, type AchievementGroup, type Stats } from '@/lib/progress';
interface Props { stats: Stats; pins: string[]; isOwner: boolean; firstName: string }
const { stats, pins, isOwner, firstName } = Astro.props;
const lv = levelOf(points(stats));
const all = achievements(stats);
const earned = all.filter((a) => a.earned).sort((a, b) => (pins.includes(b.id) ? 1 : 0) - (pins.includes(a.id) ? 1 : 0) || b.tier - a.tier);
const top = earned.slice(0, 4), rest = earned.slice(4);
const next = isOwner ? nextUp(all, 3) : [];
const ICON: Record<AchievementGroup, string> = {
  work: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 6.2a2.8 2.8 0 1 1 0 5.6 2.8 2.8 0 0 1 0-5.6Z',
  credits: 'M5 4h14v16H5zM8.5 9h7M8.5 12.5h7M8.5 16h4',
  people: 'M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2.5 19c.6-3 2.7-4.6 5.5-4.6S12.900 16 13.500 19M13 14.700c.9-.2 1.900-.3 3-.3 2.800 0 4.900 1.600 5.500 4.600',
  live: 'M3 12h2.500M7.500 7.500v9M12 4v16M16.500 7.500v9M18.500 12H21',
  standing: 'M12 3l2.600 5.600 6.100.700-4.500 4.200 1.200 6L12 16.500 6.600 19.500l1.200-6L3.300 9.300l6.100-.700z',
};
const stat = [
  { n: stats.works, l: stats.works === 1 ? 'Work' : 'Works' },
  { n: stats.creditsEarned, l: stats.creditsEarned === 1 ? 'Credit' : 'Credits' },
  { n: stats.connections, l: stats.connections === 1 ? 'Connection' : 'Connections' },
];
---
<div class="jr">
  <section class="jr__card jr__level" aria-label={'Level ' + lv.level + ', ' + lv.name}>
    <div class="jr__top">
      <span class="jr__num" style={'--p:' + lv.progress} aria-hidden="true"><b>{lv.level}</b></span>
      <span class="jr__who"><small>Level {lv.level}</small><b>{lv.name}</b></span>
    </div>
    {lv.next !== null ? (
      <>
        <div class="jr__bar" role="progressbar" aria-valuemin={0} aria-valuemax={100} aria-valuenow={Math.round(lv.progress * 100)} aria-label={'Progress to ' + lv.nextName}><i style={'width:' + Math.max(3, Math.round(lv.progress * 100)) + '%'}></i></div>
        <p class="jr__to"><span>{lv.points.toLocaleString('en-US')} / {lv.next.toLocaleString('en-US')}</span><span>Next: {lv.nextName}</span></p>
      </>
    ) : <p class="jr__to"><span>Highest level</span></p>}
    <dl class="jr__stats">{stat.map((s) => <div><dd>{s.n.toLocaleString('en-US')}</dd><dt>{s.l}</dt></div>)}</dl>
    <p class="jr__fine">Earned from real work on Opus: works, confirmed credits and connections. Never bought.</p>
  </section>

  {(earned.length > 0 || isOwner) && (
    <section class="jr__card">
      <h2 class="jr__h">Achievements <span>{earned.length} of {all.length}</span></h2>
      {earned.length > 0 ? (
        <ul class="jr__list" role="list">{top.map((a) => (
          <li><span class={'jr__medal t' + a.tier} aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={ICON[a.group]} /></svg></span><span><b>{a.name}</b><small>{a.how}</small></span></li>
        ))}</ul>
      ) : <p class="jr__none">Nothing yet. Your first work or your first connection starts it.</p>}
      {rest.length > 0 && (
        <details class="jr__more">
          <summary>{rest.length} more</summary>
          <ul class="jr__list" role="list">{rest.map((a) => (
            <li><span class={'jr__medal t' + a.tier} aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={ICON[a.group]} /></svg></span><span><b>{a.name}</b><small>{a.how}</small></span></li>
          ))}</ul>
        </details>
      )}
      {next.length > 0 && (
        <>
          <h3 class="jr__sub">Next for {firstName} <span>Only you see this</span></h3>
          <ul class="jr__list jr__list--next" role="list">{next.map((a) => (
            <li><span class="jr__medal is-locked" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={ICON[a.group]} /></svg></span><span><b>{a.name}{a.title && <i>Unlocks the title “{a.title}”</i>}</b><small>{a.how} · {a.have} of {a.need}</small></span></li>
          ))}</ul>
          <p class="jr__fine"><a class="link" href="/account/page#look">Choose your title and showcase</a></p>
        </>
      )}
    </section>
  )}
</div>

<style>
  .jr { display: flex; flex-direction: column; gap: 14px; }
  .jr__card { padding: 22px; border-radius: 20px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  .jr__level { background: linear-gradient(160deg, var(--pf-soft), transparent 60%), var(--surface); }
  .jr__top { display: flex; align-items: center; gap: 14px; }
  .jr__num { --p: 0; position: relative; flex: none; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: conic-gradient(var(--pf-ink) calc(var(--p) * 360deg), var(--line-strong) 0); }
  .jr__num::before { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--surface); }
  .jr__num b { position: relative; font-size: 22px; font-weight: 300; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .jr__who { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .jr__who small { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); }
  .jr__who b { font-size: 24px; font-weight: 300; letter-spacing: -0.035em; line-height: 1.1; }
  .jr__bar { height: 4px; margin-top: 18px; border-radius: 4px; background: var(--line-strong); overflow: hidden; }
  .jr__bar i { display: block; height: 100%; border-radius: 4px; background: var(--pf-ink); }
  .jr__to { display: flex; justify-content: space-between; gap: 12px; margin: 8px 0 0; font-size: 12.5px; color: var(--text-3); font-variant-numeric: tabular-nums; }
  .jr__stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 20px 0 0; padding-top: 16px; border-top: 1px solid var(--line); }
  .jr__stats div + div { padding-left: 14px; border-left: 1px solid var(--line); }
  .jr__stats dd { margin: 0; font-size: 26px; font-weight: 300; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .jr__stats dt { margin-top: 2px; font-size: 12.5px; color: var(--text-3); }
  .jr__fine { margin: 14px 0 0; font-size: 12px; line-height: 1.5; color: var(--text-3); }
  .jr__h { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 0 0 14px; font-size: 16px; font-weight: 500; letter-spacing: -0.02em; }
  .jr__h span, .jr__sub span { font-size: 12.5px; font-weight: 400; color: var(--text-3); letter-spacing: 0; }
  .jr__sub { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 18px 0 12px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 13px; font-weight: 500; }
  .jr__list { display: grid; gap: 12px; }
  .jr__list li { display: flex; align-items: center; gap: 12px; }
  .jr__list li > span:last-child { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .jr__list b { font-size: 14px; font-weight: 500; letter-spacing: -0.01em; }
  .jr__list b i { display: block; font-style: normal; font-weight: 400; font-size: 12.5px; color: var(--pf-ink); }
  .jr__list small { font-size: 12.5px; color: var(--text-3); line-height: 1.35; }
  .jr__medal { flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 12px; color: var(--pf-ink); background: var(--pf-soft); box-shadow: inset 0 0 0 1px hsl(var(--pf-h) var(--pf-s) 60% / .28); }
  /* Higher tiers read as more solid; the shape never changes. */
  .jr__medal.t2 { box-shadow: inset 0 0 0 1.5px var(--pf-ink); }
  .jr__medal.t3 { color: var(--bg); background: var(--pf-ink); box-shadow: none; }
  .jr__medal.is-locked { color: var(--text-3); background: none; box-shadow: inset 0 0 0 1px var(--line-strong); border-style: dashed; }
  .jr__none { margin: 0; font-size: 14px; color: var(--text-2); line-height: 1.5; }
  .jr__more { margin-top: 12px; }
  .jr__more summary { cursor: pointer; font-size: 13px; color: var(--text-2); list-style: none; }
  .jr__more summary::-webkit-details-marker { display: none; }
  .jr__more summary:hover { color: var(--text); }
  .jr__more[open] summary { margin-bottom: 12px; }
</style>
