---
/** Start a release or add a past one. Used in setup (/start) and on /account/releases. Wired up by src/scripts/releases.ts. */
import { SPECIALTIES } from '@/data/specialties';
import { RELEASE_KINDS, KIND_LABEL } from '@/server/releases';
interface Props { submitLabel?: string; defaultRole?: string }
const { submitLabel = 'Save release', defaultRole = '' } = Astro.props;
---
<form class="form rf" data-release-form novalidate>
  <input type="hidden" name="id" />
  <fieldset class="rf__stage">
    <legend class="sr-only">Is it out yet?</legend>
    <label><input type="radio" name="stage" value="in_progress" checked /><span><b>I’m working on it</b><small>Start a release</small></span></label>
    <label><input type="radio" name="stage" value="released" /><span><b>It’s already out</b><small>Add it to your resume</small></span></label>
  </fieldset>
  <div class="grid-2">
    <label class="field"><span>Title *</span><input class="input" name="title" maxlength="120" required placeholder="A working title is fine" /></label>
    <label class="field"><span>Type</span>
      <select class="select" name="kind">{RELEASE_KINDS.map((k) => <option value={k}>{KIND_LABEL[k]}</option>)}</select>
    </label>
  </div>
  <div class="grid-2">
    <label class="field"><span>Your role</span><input class="input" name="role" maxlength="80" list="rf-roles" value={defaultRole} placeholder="Producer, songwriter…" />
      <datalist id="rf-roles">{Object.values(SPECIALTIES).map((s) => <option value={s.label} />)}</datalist>
    </label>
    <label class="field"><span>Artist</span><input class="input" name="artist" maxlength="120" placeholder="Leave empty if it’s your own" /></label>
  </div>
  <div class="grid-2">
    <label class="field"><span data-date-label>Target date</span><input class="input" name="releaseDate" maxlength="10" placeholder="2026-12 or 2026-12-05" inputmode="numeric" /><small>Year, month, or exact day.</small></label>
    <label class="field"><span>Link</span><input class="input" name="link" maxlength="500" placeholder="Spotify, SoundCloud, YouTube…" inputmode="url" /></label>
  </div>
  <label class="field"><span>A line about it</span><textarea class="textarea" name="notes" maxlength="280" rows="2" placeholder="What it is, who’s on it, what you still need"></textarea></label>
  <label class="check rf__check"><input type="checkbox" name="showOnProfile" checked /><span>Show on my profile. Turn this off to keep it private to you.</span></label>
  <div data-status class="form-status"></div>
  <div class="row">
    <button class="btn-app" type="submit">{submitLabel}</button>
    <button class="btn-app btn-app--ghost" type="button" data-release-cancel hidden>Cancel</button>
  </div>
</form>

<style>
  .rf__stage { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; border: 0; padding: 0; margin: 0; }
  .rf__stage label { position: relative; display: block; cursor: pointer; }
  .rf__stage input { position: absolute; opacity: 0; }
  .rf__stage span { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); transition: border-color var(--dur) var(--ease); }
  .rf__stage b { font-weight: 500; color: var(--text); }
  .rf__stage small { font-size: 13px; color: var(--text-3); }
  .rf__stage input:checked + span { border-color: var(--text); box-shadow: inset 0 0 0 1px var(--text); }
  .rf__stage input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (max-width: 560px) { .rf__stage { grid-template-columns: 1fr; } }
</style>
