---
import Icon from './Icon.astro';
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'inverse';
  size?: 'md' | 'lg';
  arrow?: 'right' | 'external' | false;
  class?: string;
}
const { href, variant = 'primary', size = 'md', arrow = false, class: cls } = Astro.props;
const external = /^https?:\/\//.test(href);
---
<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, cls]}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
>
  <span><slot /></span>
  {arrow && <Icon name={arrow === 'external' || external ? 'arrow-up-right' : 'arrow-right'} size={16} class="btn__icon" />}
</a>

<style>
  .btn {
    --btn-h: 48px;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-height: var(--btn-h); padding: 0 24px; border-radius: var(--r-pill);
    font-size: 15px; font-weight: 500; letter-spacing: -0.01em; white-space: nowrap;
    border: 1px solid transparent;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease), border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .btn--lg { --btn-h: 56px; padding: 0 30px; font-size: 16px; }
  :global(.btn__icon) { transition: transform var(--dur) var(--ease); }
  .btn:hover :global(.btn__icon) { transform: translateX(3px); }
  .btn:active { transform: scale(0.98); }

  .btn--primary { background: var(--c-white); color: var(--c-black); }
  .btn--primary:hover { background: var(--text-2); }
  .btn--secondary { border-color: var(--line-strong); color: var(--c-white); }
  .btn--secondary:hover { border-color: var(--c-white); background: var(--surface-hover); }
  .btn--ghost { padding-inline: 0; min-height: 44px; color: inherit; }
  .btn--ghost:hover span { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .btn--inverse { background: var(--c-black); color: var(--c-white); }
  .btn--inverse:hover { background: var(--surface-hover); }
</style>
