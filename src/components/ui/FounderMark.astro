---
/**
 * Founder mark. Shown only for an account whose profile has distinction = 'founder' (migration 0016).
 * It is granted on the account, never earned, applied for or bought.
 */
import OpusMark from './OpusMark.astro';
interface Props { label?: boolean; size?: number }
const { label = true, size = 13 } = Astro.props;
---
<span class="fmark" title="Founder of Opus"><OpusMark size={size} />{label ? <span>Founder</span> : <span class="sr-only">Founder of Opus</span>}</span>

<style>
  .fmark { display: inline-flex; align-items: center; gap: 6px; height: 22px; padding: 0 9px 0 8px; border-radius: 999px; font-size: 11px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; line-height: 1; white-space: nowrap;
    color: #2a1f05; background: linear-gradient(135deg, #f3dc9a, #c99a3c 55%, #ecd08a); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .35), 0 6px 18px -8px rgba(201, 154, 60, .8); }
</style>
