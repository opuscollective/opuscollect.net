---
/**
 * Opus Verified mark. A monochrome seal with a check.
 * NOTE: new brand element proposed in Phase 1; pending Bogo's approval.
 */
interface Props { size?: number; label?: boolean; tone?: 'light' | 'dark' }
const { size = 16, label = false, tone = 'light' } = Astro.props;
---
<span class:list={['vbadge', `vbadge--${tone}`]} title="Opus Verified">
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
    <path class="vbadge__seal" d="M12 1.8l2.3 1.7 2.85-.2.9 2.7 2.35 1.6-.9 2.73.9 2.73-2.35 1.6-.9 2.7-2.85-.2L12 22.2l-2.3-1.7-2.85.2-.9-2.7-2.35-1.6.9-2.73-.9-2.73 2.35-1.6.9-2.7 2.85.2z" />
    <path class="vbadge__check" d="M8 12.2l2.6 2.6L16.2 9" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  {label ? <span class="vbadge__text">Opus Verified</span> : <span class="sr-only">Opus Verified</span>}
</span>

<style>
  .vbadge { display: inline-flex; align-items: center; gap: 6px; line-height: 1; }
  .vbadge--light .vbadge__seal { fill: var(--c-white); }
  .vbadge--light .vbadge__check { stroke: var(--c-black); }
  .vbadge--dark .vbadge__seal { fill: var(--c-paper-ink); }
  .vbadge--dark .vbadge__check { stroke: var(--c-paper); }
  .vbadge__text { font-size: 13px; font-weight: 500; letter-spacing: -0.005em; }
</style>
