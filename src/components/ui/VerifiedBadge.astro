---
/**
 * Opus Verified mark. A blue seal with a white check (Bogo, 2026-11-14).
 * Scalloped seal (12 soft lobes) with a check. Refined 2026-11-10 after Bogo's feedback on the old star shape.
 */
interface Props { size?: number; label?: boolean; tone?: 'light' | 'dark' }
const { size = 16, label = false, tone = 'light' } = Astro.props;
---
<span class:list={['vbadge', `vbadge--${tone}`]} title="Opus Verified">
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
    <path class="vbadge__seal" d="M14.54 2.53A4.2 4.2 0 0 1 18.93 5.07A4.2 4.2 0 0 1 21.47 9.46A4.2 4.2 0 0 1 21.47 14.54A4.2 4.2 0 0 1 18.93 18.93A4.2 4.2 0 0 1 14.54 21.47A4.2 4.2 0 0 1 9.46 21.47A4.2 4.2 0 0 1 5.07 18.93A4.2 4.2 0 0 1 2.53 14.54A4.2 4.2 0 0 1 2.53 9.46A4.2 4.2 0 0 1 5.07 5.07A4.2 4.2 0 0 1 9.46 2.53A4.2 4.2 0 0 1 14.54 2.53Z" />
    <path class="vbadge__check" d="M8.4 12.3l2.4 2.4 4.9-5" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  {label ? <span class="vbadge__text">Opus Verified</span> : <span class="sr-only">Opus Verified</span>}
</span>

<style>
  .vbadge { display: inline-flex; align-items: center; gap: 6px; line-height: 1; }
  /* Same blue seal on every surface; tone is kept for callers but no longer changes the colour. */
  .vbadge__seal { fill: var(--c-verified); }
  .vbadge__check { stroke: var(--c-verified-ink); }
  .vbadge__text { font-size: 13px; font-weight: 500; letter-spacing: -0.005em; }
</style>
