---
/**
 * The Opus monogram (OC) as a vector, traced from the official mark (public/images/oc-logo.png)
 * so it stays sharp at any size and density. Its thin horizontals are thickened slightly at small
 * sizes (optical sizing) so the mark reads cleanly at 16 to 24px.
 */
interface Props { size?: number; class?: string; title?: string }
const { size = 20, class: cls, title } = Astro.props;
// Optical sizing: about 1/40 of the mark's height extra weight at launcher sizes, none when large.
const weight = size <= 28 ? Math.round(14 - (size - 16) * 0.35) : 0;
