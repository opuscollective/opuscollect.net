---
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import { SPECIALTIES } from '@/data/specialties';
const entries = Object.entries(SPECIALTIES);
---
<section class="section network" aria-labelledby="network-title">
  <div class="container">
    <SectionHeader index="02" label="Discover your network" tag={`${entries.length} specialties`} />
    <div class="network__layout">
      <div class="network__intro">
        <h2 id="network-title" class="t-h1" data-reveal>Every role<br /><span class="dim">behind the record.</span></h2>
        <p class="t-lead" data-reveal style="--d:.1s">
          A song takes more than one person. Opus maps the whole team so you can find the artist, producer, engineer or writer your next project needs, wherever they are.
        </p>
      </div>
      <ol class="network__list" role="list">
        {entries.map(([key, d], i) => (
          <li data-reveal style={`--d:${i * 0.06}s`}>
            <a href={`/world?type=musician&specialty=${key}`} class="network__row">
              <span class="network__num t-meta">{String(i + 1).padStart(2, '0')}</span>
              <span class="network__name">{d.plural}</span>
              <span class="network__blurb">{d.blurb}</span>
              <span class="network__go" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .network__layout { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: clamp(40px, 6vw, 112px); margin-top: clamp(32px, 4vw, 56px); }
  .network__intro { display: flex; flex-direction: column; gap: 28px; position: sticky; top: 120px; align-self: start; }
  .network__list { margin: 0; border-top: 1px solid var(--c-ink-600); }
  .network__list li { border-bottom: 1px solid var(--c-ink-600); }
  .network__row {
    position: relative; display: grid; grid-template-columns: 48px minmax(0, 1fr) 44px; grid-template-areas: 'num name go' '. blurb go';
    align-items: center; column-gap: 16px; row-gap: 6px; padding: clamp(22px, 2.4vw, 34px) 0;
    transition: padding var(--dur) var(--ease);
  }
  .network__row::before { content: ''; position: absolute; inset: 0 -16px; background: var(--c-ink-900); border-radius: var(--r-sm); opacity: 0; z-index: -1; transition: opacity var(--dur) var(--ease); }
  .network__num { grid-area: num; color: var(--c-fg-ghost); }
  .network__name { grid-area: name; font-size: clamp(28px, 1.6rem + 1.6vw, 52px); font-weight: 500; letter-spacing: -0.045em; line-height: 1.05; transition: transform var(--dur) var(--ease); }
  .network__blurb { grid-area: blurb; font-size: 15px; color: var(--c-fg-faint); max-width: 46ch; }
  .network__go { grid-area: go; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--c-ink-500); color: var(--c-fg-muted); transition: background var(--dur) var(--ease), color var(--dur) var(--ease), border-color var(--dur), transform var(--dur) var(--ease); }
  .network__row:hover::before { opacity: 1; }
  .network__row:hover .network__name { transform: translateX(8px); }
  .network__row:hover .network__go { background: var(--c-white); color: var(--c-black); border-color: var(--c-white); transform: rotate(-45deg); }
  @media (max-width: 960px) {
    .network__layout { grid-template-columns: 1fr; }
    .network__intro { position: static; }
  }
  /* Phones: eleven full-width rows become a compact two-column grid of tappable specialties. */
  @media (max-width: 600px) {
    .network__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; border-top: 0; }
    .network__list li { border-bottom: 0; }
    .network__row { display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; gap: 18px; min-height: 96px; padding: 14px; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); }
    .network__row::before, .network__blurb, .network__go { display: none; }
    .network__name { font-size: 19px; letter-spacing: -0.03em; }
    .network__row:hover .network__name { transform: none; }
  }
  @media (max-width: 520px) { .network__row { grid-template-columns: 32px minmax(0, 1fr) 40px; column-gap: 10px; } .network__go { width: 40px; height: 40px; } }
</style>
