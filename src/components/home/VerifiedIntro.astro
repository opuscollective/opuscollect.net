---
import SectionHeader from '../ui/SectionHeader.astro';
import VerifiedBadge from '../ui/VerifiedBadge.astro';
import Button from '../ui/Button.astro';
---
<section class="section section--paper vintro on-paper" aria-labelledby="verified-title">
  <div class="container">
    <SectionHeader index="02" label="Opus Verified" tag="Recognition" tone="paper" />
    <div class="vintro__grid">
      <div class="vintro__statement">
        <div class="vintro__seal" data-reveal aria-hidden="true"><VerifiedBadge size={52} tone="dark" /></div>
        <h2 id="verified-title" class="t-display" data-reveal style="--d:.05s">Earned.<br /><span class="vintro__muted">Never bought.</span></h2>
      </div>
      <div class="vintro__side" data-reveal style="--d:.1s">
        <p class="t-lead">Recognition for real, checkable achievements. It can’t be purchased, and no membership grants it.</p>
        <Button href="/verified" variant="inverse" arrow="right">How verification works</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .vintro__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: end; gap: 32px clamp(48px, 7vw, 128px); margin-top: clamp(32px, 4vw, 56px); }
  .vintro__statement { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .vintro__statement .t-display { font-size: clamp(3rem, 1.4rem + 5.4vw, 6.75rem); }
  .vintro__muted { color: var(--c-paper-faint); }
  .vintro__side { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .vintro__side .t-lead { max-width: 420px; }
  @media (max-width: 860px) { .vintro__grid { grid-template-columns: 1fr; } }
</style>
