---
/** Opus Verified in one statement and one link. The full explanation lives on /verified. */
import VerifiedBadge from '../ui/VerifiedBadge.astro';
import Icon from '../ui/Icon.astro';
---
<section class="section section--paper vintro on-paper" aria-labelledby="verified-title">
  <div class="container vintro__inner">
    <div class="vintro__seal" data-reveal aria-hidden="true"><VerifiedBadge size={48} tone="dark" /></div>
    <h2 id="verified-title" class="t-display" data-reveal style="--d:.05s">Earned.<br /><span class="vintro__muted">Never bought.</span></h2>
    <a class="vintro__link" href="/verified" data-reveal style="--d:.1s">How Opus Verified works <Icon name="arrow-right" size={16} /></a>
  </div>
</section>

<style>
  .vintro.section { padding-top: var(--section-y); }
  .vintro__inner { display: flex; flex-direction: column; align-items: flex-start; gap: clamp(24px, 3vw, 36px); }
  .vintro .t-display { font-size: clamp(3rem, 1.4rem + 5.4vw, 6.75rem); }
  .vintro__muted { color: var(--c-paper-faint); }
  .vintro__link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 16px; font-weight: 500; border-bottom: 1px solid currentColor; }
  .vintro__link:hover { opacity: 0.7; }
</style>
