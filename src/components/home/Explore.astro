---
/**
 * Homepage discovery: one photo and three ways into Opus World.
 * The specialties, studio types and organization categories stay available as filters on /world.
 */
import Icon from '../ui/Icon.astro';
const ROUTES = [
  { label: 'Musicians', sub: 'Artists, producers, engineers, songwriters', href: '/musicians' },
  { label: 'Services', sub: 'Studios and the people who run them', href: '/studios' },
  { label: 'Organizations', sub: 'Labels, management, collectives', href: '/organizations' },
];
---
<section class="section explore" aria-labelledby="explore-title">
  <div class="container explore__grid">
    <a class="explore__photo tone-dark" href="/studios" tabindex="-1" aria-hidden="true" data-reveal>
      <img src="/images/studio-control-room.jpg" alt="" loading="lazy" decoding="async" width="2000" height="1334" />
    </a>
    <div class="explore__body">
      <h2 id="explore-title" class="t-h1" data-reveal>Find your people.</h2>
      <ul class="explore__list" role="list">
        {ROUTES.map((r, i) => (
          <li data-reveal style={`--d:${(i + 1) * 0.06}s`}>
            <a href={r.href}>
              <span class="explore__name">{r.label}</span>
              <span class="explore__sub">{r.sub}</span>
              <span class="explore__arrow" aria-hidden="true"><Icon name="arrow-right" size={22} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .explore__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: clamp(32px, 6vw, 112px); }
  .explore__photo { display: block; aspect-ratio: 4 / 5; border-radius: var(--r-lg); overflow: hidden; background: #111113; }
  .explore__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 40% 55%; transition: transform 1.4s var(--ease); }
  .explore__photo:hover img { transform: scale(1.03); }
  .explore__body { display: flex; flex-direction: column; gap: clamp(28px, 3.5vw, 48px); }
  .explore__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .explore__list a { position: relative; display: flex; flex-direction: column; gap: 6px; padding: clamp(22px, 2.4vw, 32px) 56px clamp(22px, 2.4vw, 32px) 0; border-bottom: 1px solid var(--line); }
  .explore__name { font-size: clamp(30px, 1.2rem + 2.2vw, 52px); font-weight: 500; letter-spacing: -0.05em; line-height: 1; transition: transform var(--dur) var(--ease); }
  .explore__sub { font-size: 15px; color: var(--text-3); }
  .explore__arrow { position: absolute; right: 0; top: 50%; transform: translateY(-50%); display: flex; opacity: 0.35; transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease); }
  .explore__list a:hover .explore__arrow, .explore__list a:focus-visible .explore__arrow { opacity: 1; transform: translate(4px, -50%); }
  .explore__list a:hover .explore__name { transform: translateX(6px); }
  @media (max-width: 860px) {
    .explore__grid { grid-template-columns: 1fr; }
    .explore__photo { aspect-ratio: 3 / 2; order: 2; }
  }
</style>
