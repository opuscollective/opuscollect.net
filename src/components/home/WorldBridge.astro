---
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
const ROWS = [
  { k: 'Musicians', d: 'Recording artists, producers, audio engineers and songwriters.', href: '/world?type=musician' },
  { k: 'Studios', d: 'Commercial facilities and home studios run by independent engineers.', href: '/world?type=studio' },
  { k: 'Organizations', d: 'Labels, management, collectives and marketing agencies.', href: '/world?type=organization' },
];
const STEPS = ['Search a city', 'See who’s there on the map', 'Open a profile', 'Plan the session'];
---
<section class="section bridge" aria-labelledby="bridge-title">
  <div class="container">
    <SectionHeader index="01" label="Opus World" tag="Discovery" />
    <div class="bridge__top">
      <h2 id="bridge-title" class="t-h1" data-reveal>One map.<br /><span class="dim">Every role in music.</span></h2>
      <p class="t-lead" data-reveal style="--d:.1s">Search any city and the globe brings you there. Musicians, studios and organizations appear on the map and in the list together, so finding your next session takes minutes.</p>
    </div>
    <ul class="bridge__rows" role="list">
      {ROWS.map((r, i) => (
        <li data-reveal style={`--d:${i * 0.06}s`}><a href={r.href}><span class="t-meta">{String(i + 1).padStart(2, '0')}</span><b>{r.k}</b><span class="bridge__d">{r.d}</span><span class="bridge__go" aria-hidden="true">→</span></a></li>
      ))}
    </ul>
    <ol class="bridge__steps" role="list" data-reveal>
      {STEPS.map((s, i) => <li><span class="t-meta">{String(i + 1).padStart(2, '0')}</span>{s}{i === 3 && <em> · coming with Opus Sessions</em>}</li>)}
    </ol>
    <div data-reveal><Button href="/world" arrow="right">Open Opus World</Button></div>
  </div>
</section>
<style>
  .bridge__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px 64px; margin-top: clamp(32px, 4vw, 56px); }
  .bridge__top .t-lead { max-width: 460px; }
  .bridge__rows { margin: clamp(40px, 5vw, 64px) 0 0; border-top: 1px solid var(--c-ink-600); }
  .bridge__rows li { border-bottom: 1px solid var(--c-ink-600); }
  .bridge__rows a { display: grid; grid-template-columns: 48px minmax(140px, 1fr) minmax(0, 1.4fr) 32px; align-items: center; gap: 16px; padding: 26px 0; transition: padding var(--dur) var(--ease); }
  .bridge__rows .t-meta { color: var(--c-fg-ghost); }
  .bridge__rows b { font-size: clamp(26px, 1.4rem + 1.4vw, 44px); font-weight: 500; letter-spacing: -0.045em; }
  .bridge__d { color: var(--c-fg-faint); font-size: 15px; }
  .bridge__go { color: var(--c-fg-ghost); transition: transform var(--dur) var(--ease), color var(--dur); }
  .bridge__rows a:hover { padding-left: 8px; }
  .bridge__rows a:hover .bridge__go { color: var(--c-accent); transform: translateX(4px); }
  .bridge__steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 40px 0; padding: 0; }
  .bridge__steps li { display: flex; flex-direction: column; gap: 8px; padding-top: 14px; border-top: 1px solid var(--c-accent-dim); font-weight: 500; letter-spacing: -0.01em; }
  .bridge__steps .t-meta { color: var(--c-accent); }
  .bridge__steps em { font-style: normal; color: var(--c-fg-ghost); font-weight: 400; font-size: 13px; }
  @media (max-width: 760px) { .bridge__rows a { grid-template-columns: 32px 1fr 24px; } .bridge__d { grid-column: 2; } .bridge__go { grid-row: 1; grid-column: 3; } .bridge__steps { grid-template-columns: 1fr 1fr; } }
</style>
