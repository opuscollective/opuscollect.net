---
import SearchBar from '../directory/SearchBar.astro';
import { DISCIPLINES } from '@/data/disciplines';
// Shortcut filters only. They do not claim members exist in these cities yet.
const CITIES = ['Birmingham', 'Atlanta', 'Los Angeles', 'New York', 'London', 'Lagos', 'Toronto'];
---
<section class="dsearch" aria-labelledby="dsearch-title">
  <div class="container">
    <div class="dsearch__head" data-reveal>
      <h2 id="dsearch-title" class="t-h2">Find your next collaborator.</h2>
      <p class="t-lead">Search independent musicians by name, discipline and city. Public profiles, no account needed.</p>
    </div>
    <div data-reveal style="--d:.1s">
      <SearchBar id="home-search" />
    </div>
    <div class="dsearch__quick" data-reveal style="--d:.2s">
      <div class="dsearch__group">
        <span class="t-meta dsearch__label">Disciplines</span>
        <ul role="list">
          {Object.entries(DISCIPLINES).map(([k, d]) => <li><a href={`/directory?discipline=${k}`}>{d.plural}</a></li>)}
        </ul>
      </div>
      <div class="dsearch__group">
        <span class="t-meta dsearch__label">Cities</span>
        <ul role="list">
          {CITIES.map((c) => <li><a href={`/directory?location=${encodeURIComponent(c)}`}>{c}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .dsearch { padding-block: clamp(40px, 6vw, 88px) clamp(56px, 7vw, 104px); }
  .dsearch__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 48px; margin-bottom: clamp(28px, 3vw, 40px); }
  .dsearch__head .t-lead { max-width: 420px; }
  .dsearch__quick { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 48px; margin-top: 28px; }
  .dsearch__group { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .dsearch__label { color: var(--c-fg-ghost); }
  .dsearch__group ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .dsearch__group a {
    display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border-radius: var(--r-pill);
    border: 1px solid var(--c-ink-600); font-size: 14px; color: var(--c-fg-muted);
    transition: border-color var(--dur), color var(--dur), background var(--dur);
  }
  .dsearch__group a:hover { border-color: var(--c-white); color: var(--c-white); background: rgba(255,255,255,.04); }
  @media (max-width: 760px) { .dsearch__quick { grid-template-columns: 1fr; } }
</style>
