---
/**
 * The Opus ecosystem on the homepage, continuing the hero's dark canvas (World is the hero itself).
 * A strict two-column gallery: two equal columns, one gap, one card height, one radius.
 *   Collective (full width, directly below the hero)
 *   Studios  | Works
 *   Events   | Venues
 *   Airplay  | Charts
 *   Opus Verified (a slim strip on the same outer edges)
 * Every card shares one composition: a text zone (title, line, action, centered) above a visual zone whose visual is
 * centered on the card. Layout is Grid and Flexbox; nothing is placed by hand-tuned offsets.
 * Only real destinations. Products in development say so. Every visual except the Works covers is drawn, so no card
 * is a busy photograph. No invented releases, events, rankings or numbers.
 */
import VerifiedBadge from '../ui/VerifiedBadge.astro';

const CITIES = ['Birmingham', 'Atlanta', 'Nashville', 'London', 'Lagos', 'Los Angeles'];
const OPACITY = [0.92, 0.74, 0.56, 0.42, 0.3, 0.2];

/* Studios console: two banks of six channels mirrored around a master section on the centerline (x = 300). */
const BANK = [0.56, 0.72, 0.44, 0.82, 0.6, 0.5];
const CHANNELS = [
  ...BANK.map((h, i) => ({ x: 52 + i * 36, h })),
  ...BANK.map((h, i) => ({ x: 548 - i * 36, h })),
];
const MASTER = [282, 318];
const METER = [0, 1, 2, 3, 4, 5, 6, 7];

/* Airplay: a signal mirrored around its middle bar. */
const HALF = [0.22, 0.34, 0.28, 0.46, 0.38, 0.58, 0.5, 0.72, 0.64, 0.86];
const BARS = [...HALF, 1, ...HALF.slice().reverse()];

/* Collective: a deliberate network. One center, a ring of six, a ring of twelve, each ring joined to the next. */
const ring = (n: number, r: number, offset = 0) =>
  Array.from({ length: n }, (_, k) => {
    const a = ((-90 + offset + (k * 360) / n) * Math.PI) / 180;
    return [200 + r * Math.cos(a), 200 + r * Math.sin(a)] as [number, number];
  });
const R1 = ring(6, 78);
const R2 = ring(12, 156);
const SEGS: [[number, number], [number, number]][] = [
  ...R1.map((p) => [[200, 200], p] as [[number, number], [number, number]]),
  ...R1.map((p, i) => [p, R1[(i + 1) % 6]!] as [[number, number], [number, number]]),
  ...R1.flatMap((p, i) => [[p, R2[2 * i]!], [p, R2[(2 * i + 1) % 12]!], [p, R2[(2 * i + 11) % 12]!]] as [[number, number], [number, number]][]),
];
---
<section class="pt tone-dark" aria-label="What you can do on Opus">
  <div class="pt__grid">

    <article class="tile tile--dark tile--collective tone-dark" aria-labelledby="pt-collective" data-reveal>
      <div class="tile__text">
        <h2 class="tile__name" id="pt-collective">Opus Collective</h2>
        <p class="tile__line">Beyond the platform. The people, the gatherings and the culture behind Opus.</p>
        <div class="tile__actions"><a class="tile__btn tile__btn--go tile__link" href="/collective">Explore the Collective</a></div>
      </div>
      <!-- Abstract connections: a center, two rings, each joined to the next. Not a map and not real members. -->
      <div class="tile__media" aria-hidden="true">
        <svg class="web" viewBox="0 0 400 400">
          <g class="web__rings"><circle cx="200" cy="200" r="78" /><circle cx="200" cy="200" r="156" /><circle cx="200" cy="200" r="194" /></g>
          <g class="web__lines">{SEGS.map(([a, b]) => <line x1={a[0].toFixed(1)} y1={a[1].toFixed(1)} x2={b[0].toFixed(1)} y2={b[1].toFixed(1)} />)}</g>
          <g class="web__nodes">
            {R2.map(([x, y]) => <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="3" />)}
            {R1.map(([x, y]) => <circle class="web__mid" cx={x.toFixed(1)} cy={y.toFixed(1)} r="4.5" />)}
            <circle class="web__core" cx="200" cy="200" r="7" />
          </g>
        </svg>
      </div>
    </article>

    <article class="tile tile--dark tile--studios tone-dark" aria-labelledby="pt-studios" data-reveal>
      <div class="tile__text">
        <h2 class="tile__name" id="pt-studios">Studios</h2>
        <p class="tile__line">Picture your next session. Browse real rooms and rates, then send a booking request.</p>
        <div class="tile__actions">
          <a class="tile__btn tile__btn--go tile__link" href="/studios">Find a studio</a>
          <a class="tile__btn tile__btn--sub" href="/business">List your studio</a>
        </div>
      </div>
      <!-- A real control room, supplied by Opus Collective. -->
      <div class="tile__media room">
        <img src="/images/studio-control-room-1400.jpg" alt="A recording studio control room with monitors, a console and guitars" loading="lazy" decoding="async" width="1400" height="934" />
      </div>
    </article>

    <article class="tile tile--cream tile--works" aria-labelledby="pt-works" data-reveal style="--d:0.08s">
      <div class="tile__text">
        <h2 class="tile__name" id="pt-works">Works</h2>
        <p class="tile__line"><strong class="tile__lead">Start your résumé.</strong> Add your releases and credits to your Opus profile, all in one place.</p>
        <div class="tile__actions"><a class="tile__btn tile__btn--go tile__link" href="/works">Start your résumé</a></div>
      </div>
      <!-- Real releases from the Opus Collective catalog: Amazing and Scenic by Bogo, luciaism by NUGGET!. -->
      <div class="tile__media covers" aria-hidden="true">
        <img class="covers__side covers__l" src="/images/releases/card/amazing-900.jpg" alt="" loading="lazy" decoding="async" width="900" height="900" />
        <img class="covers__c" src="/images/releases/card/scenic-900.jpg" alt="" loading="lazy" decoding="async" width="900" height="900" />
        <img class="covers__side covers__r" src="/images/releases/card/luciaism-900.jpg" alt="" loading="lazy" decoding="async" width="900" height="900" />
      </div>
    </article>

    <article class="tile tile--white tile--events" aria-labelledby="pt-events" data-reveal>
      <div class="tile__text">
        <h2 class="tile__name" id="pt-events">Events</h2>
        <p class="tile__line">Make something happen.</p>
        <div class="tile__actions"><a class="tile__btn tile__btn--go tile__link" href="/events">Explore Events</a></div>
      </div>
      <!-- Three date tiles: a sense of what's ahead, not real dates or events. -->
      <div class="tile__media dates" aria-hidden="true">
        <span class="date date--side date--a"><small>Fri</small><b>12</b></span>
        <span class="date date--b"><small>Sat</small><b>13</b><i></i></span>
        <span class="date date--side date--c"><small>Sun</small><b>14</b></span>
      </div>
    </article>

    <article class="tile tile--dark tile--venues tone-dark" aria-labelledby="pt-venues" data-reveal style="--d:0.08s">
      <span class="tile__soon">Coming soon</span>
      <div class="tile__text">
        <h2 class="tile__name" id="pt-venues">Venues</h2>
        <p class="tile__line">Find the room that fits your sound. Venue pages are on the way.</p>
        <div class="tile__actions"><a class="tile__btn tile__btn--go tile__link" href="/venues">Explore venues</a></div>
      </div>
      <!-- A drawn stage: one light, one floor, on the card's centerline. -->
      <div class="tile__media stage" aria-hidden="true">
        <span class="stage__beam"></span>
        <span class="stage__spot"></span>
        <span class="stage__floor"></span>
      </div>
    </article>

    <article class="tile tile--ink tile--airplay tone-dark" aria-labelledby="pt-airplay" data-reveal>
      <span class="tile__soon">Coming soon</span>
      <div class="tile__text">
        <h2 class="tile__name" id="pt-airplay">Airplay</h2>
        <p class="tile__line">Get your music heard.</p>
        <div class="tile__actions"><a class="tile__btn tile__btn--go tile__link" href="/airplay">See What’s Coming</a></div>
      </div>
      <!-- A drawn signal, not audio data. -->
      <div class="tile__media wave" aria-hidden="true">
        <span class="wave__bars">{BARS.map((h, i) => <span style={`--h:${h};--i:${i}`}></span>)}</span>
      </div>
    </article>

    <article class="tile tile--paper tile--charts" aria-labelledby="pt-charts" data-reveal style="--d:0.08s">
      <span class="tile__soon">Coming soon</span>
      <div class="tile__text">
        <h2 class="tile__name" id="pt-charts">Charts</h2>
        <p class="tile__line">Every city has a sound. Rankings built from real activity, never bought.</p>
        <div class="tile__actions"><a class="tile__btn tile__btn--go tile__link" href="/charts">View charts</a></div>
      </div>
      <!-- Decorative city names, not rankings. -->
      <div class="tile__media">
        <ul class="cities" role="list" aria-label="Cities Charts will cover">
          {CITIES.map((c, i) => <li style={`--o:${OPACITY[i]};--i:${i}`}>{c}</li>)}
        </ul>
      </div>
    </article>

    <article class="vstrip tone-dark" aria-labelledby="pt-verified" data-reveal>
      <span class="vstrip__seal" aria-hidden="true"><VerifiedBadge size={44} tone="light" /></span>
      <p class="vstrip__text"><span class="vstrip__name" id="pt-verified">Opus Verified.</span> Earned. Never bought.</p>
      <a class="tile__btn vstrip__btn" href="/verified">Learn About Verification</a>
    </article>

  </div>
</section>

<style>
  /* One geometry for the whole gallery. Cards and the strip share one radius; inner pieces (covers, date tiles,
     console) are barely rounded; buttons and badges stay pills. */
  .pt { --gap: 12px; --r-card: 6px; --r-inner: 3px; padding: 4px 12px 12px; background: var(--bg); }
  /* The grid continues the hero's dark canvas: on desktop the hero frame's bottom corners close here, after the last row. */
  @media (min-width: 1000px) {
    .pt { margin: 0 12px; padding: 4px 12px 12px; border-radius: 0 0 28px 28px; }
  }
  .pt__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); max-width: 1480px; margin: 0 auto; }

  /* Card: a text zone, then a visual zone that takes the rest. Every product card has the same height. */
  .tile { --pad: clamp(40px, 4.2vw, 60px); --card-h: clamp(560px, 44vw, 680px);
    position: relative; isolation: isolate; overflow: hidden; display: grid; grid-template-rows: auto minmax(0, 1fr); justify-items: center;
    height: var(--card-h); padding: var(--pad) 24px; text-align: center; border-radius: var(--r-card); container-type: inline-size;
    transition: transform var(--m-card) var(--m-ease), box-shadow var(--m-card) var(--m-ease); }
  @media (hover: hover) { .tile:hover { transform: translateY(-2px); box-shadow: 0 30px 60px -38px rgba(0, 0, 0, 0.55); } }
  :global(html:not([data-motion='fluid'])) .tile, :global(html:not([data-motion='fluid'])) .tile:hover { transform: none; transition: none; }
  .tile--dark { background: #0d0d0f; color: #f4f2ee; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06); }
  .tile--cream { background: #efe9df; color: #141416; }
  .tile--paper { background: #f8f6f1; color: #141416; box-shadow: inset 0 0 0 1px #e3ddd3; }
  .tile--white { background: #f5f3ef; color: #141416; }
  .tile--ink { background: #0a0f1a; color: #f4f2ee; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06); }
  @media (hover: hover) {
    .tile--dark:hover, .tile--ink:hover { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06), 0 30px 60px -38px rgba(0, 0, 0, 0.55); }
    .tile--paper:hover { box-shadow: inset 0 0 0 1px #e3ddd3, 0 30px 60px -38px rgba(0, 0, 0, 0.55); }
  }
  .tile__lead { display: block; font-weight: 600; }
  .tile__btn--sub { position: relative; z-index: 4; border-color: rgba(244, 242, 238, 0.32); color: inherit; }
  .tile__btn--sub:hover { border-color: currentColor; opacity: 1; }
  /* Studios: a real room, wide, centered under the words. */
  .room { align-self: stretch; width: 100%; max-width: 560px; min-height: 0; margin-top: clamp(20px, 2.4vw, 32px); border-radius: var(--r-inner); overflow: hidden; }
  .room img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 55%; filter: saturate(0.9); }
  .tile__kicker { margin: 0 0 2px; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.7; }

  .tile__text { z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .tile__name { margin: 0; font-size: clamp(2.2rem, 1.4rem + 2vw, 3.4rem); font-weight: 500; letter-spacing: -0.045em; line-height: 1.02; }
  .tile__line { margin: 0; max-width: 30ch; font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem); letter-spacing: -0.02em; opacity: 0.78; text-wrap: balance; }
  .tile__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 10px; }
  .tile__btn { display: inline-flex; align-items: center; height: 42px; padding: 0 20px; border-radius: var(--r-pill); border: 1px solid currentColor; font-size: 15px; font-weight: 500; white-space: nowrap;
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease); }
  .tile__btn:hover { opacity: 0.84; }
  .tile__btn:focus-visible { outline: 2px solid #2997ff; outline-offset: 3px; }
  /* The filled button takes the opposite of the tile's surface. */
  .tile--dark .tile__btn--go { background: #f4f2ee; color: #0d0d0f; border-color: #f4f2ee; }
  .tile--ink .tile__btn--go { background: #f4f2ee; color: #0a0f1a; border-color: #f4f2ee; }
  .tile--cream .tile__btn--go, .tile--paper .tile__btn--go, .tile--white .tile__btn--go { background: #141416; color: #f4f2ee; border-color: #141416; }

  .tile__soon { position: absolute; top: 20px; right: 20px; z-index: 3; padding: 4px 10px; border: 1px solid currentColor; border-radius: var(--r-pill);
    font-size: 11px; font-weight: 500; line-height: 16px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.6; }

  /* The visual zone: the same top spacing on every card, and its visual centered on the card both ways. */
  .tile__media { width: 100%; min-height: 0; margin-top: clamp(28px, 3vw, 40px); display: flex; align-items: center; justify-content: center; }

  /* The whole card is the link: the action's hit area stretches over the card. */
  .tile__link::after { content: ''; position: absolute; inset: 0; z-index: 3; }
  .tile { cursor: pointer; }
  .tile:has(.tile__link:focus-visible) { outline: 2px solid #2997ff; outline-offset: 3px; }
  .tile__link:focus-visible { outline: none; }

  /* Studios: a symmetric console under one soft light. */
  .desk { background: radial-gradient(50% 50% at 50% 60%, rgba(255, 236, 205, 0.09), transparent 70%); }
  .desk__svg { width: min(100%, 560px); max-height: 100%; height: auto; display: block; }
  .desk__cap { transition: transform calc(var(--m-card) * 1.4) var(--m-ease); transition-delay: calc(var(--i) * 25ms); }
  @media (hover: hover) { :global(html[data-motion='fluid']) .tile--studios:hover .desk__cap { transform: translateY(-6px); } }

  /* Works: three real covers, mirrored around Scenic in the middle. */
  .covers img { display: block; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: var(--r-inner); transition: transform calc(var(--m-card) * 1.4) var(--m-ease); }
  .covers__c { position: relative; z-index: 2; width: min(42cqw, 280px); box-shadow: 0 40px 80px -30px rgba(120, 40, 70, 0.5), 0 24px 50px -22px rgba(20, 16, 12, 0.6); }
  .covers__side { width: min(34cqw, 226px); box-shadow: 0 28px 60px -24px rgba(20, 16, 12, 0.55); }
  .covers__l { margin-right: max(-14cqw, -94px); transform: rotate(-6deg); }
  .covers__r { margin-left: max(-14cqw, -94px); transform: rotate(6deg); }
  @media (hover: hover) {
    .tile--works:hover .covers__l { transform: translateX(-6px) rotate(-8deg); }
    .tile--works:hover .covers__r { transform: translateX(6px) rotate(8deg); }
    .tile--works:hover .covers__c { transform: translateY(-4px); }
  }

  /* Events: three date tiles, mirrored around the one in front. */
  .date { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; flex: none;
    width: min(30cqw, 160px); aspect-ratio: 1; border-radius: var(--r-inner); background: #fff; color: #141416;
    box-shadow: 0 1px 0 rgba(20, 16, 12, 0.04), 0 24px 50px -24px rgba(20, 16, 12, 0.35), 0 0 0 1px rgba(20, 16, 12, 0.06); transition: transform calc(var(--m-card) * 1.4) var(--m-ease); }
  .date--b { z-index: 2; }
  .date--side { width: min(24cqw, 128px); opacity: .72; }
  .date--a { margin-right: max(-4cqw, -22px); transform: rotate(-5deg); }
  .date--c { margin-left: max(-4cqw, -22px); transform: rotate(5deg); }
  .date small { font-size: clamp(11px, 2.4cqw, 13px); letter-spacing: 0.1em; text-transform: uppercase; color: #8b867f; }
  .date b { font-size: clamp(32px, 8cqw, 54px); font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  .date--side b { font-size: clamp(26px, 6.4cqw, 42px); }
  .date i { position: absolute; top: 10px; right: 10px; width: 8px; height: 8px; border-radius: 50%; background: #0071e3; }
  @media (hover: hover) {
    .tile--events:hover .date--a { transform: translateX(-6px) rotate(-7deg); }
    .tile--events:hover .date--c { transform: translateX(6px) rotate(7deg); }
    .tile--events:hover .date--b { transform: translateY(-4px); }
  }

  /* Venues: one light on an empty stage, on the same centerline as the words. On hover the light comes up. */
  .stage { flex-direction: column; justify-content: flex-end; margin-top: 0; }
  .stage__beam { flex: 1; width: min(64cqw, 420px); max-height: 300px;
    background: linear-gradient(180deg, rgba(255, 244, 222, 0.30), rgba(255, 244, 222, 0.04)); clip-path: polygon(45% 0, 55% 0, 100% 100%, 0 100%); opacity: 0.85; transition: opacity calc(var(--m-card) * 1.4) var(--m-ease); }
  .stage__spot { width: min(64cqw, 420px); height: 44px; margin-top: -22px; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 244, 222, 0.55), rgba(255, 244, 222, 0.08) 70%, transparent); transition: transform calc(var(--m-card) * 1.4) var(--m-ease), opacity calc(var(--m-card) * 1.4) var(--m-ease); opacity: 0.8; }
  .stage__floor { width: min(84cqw, 560px); height: 1px; margin-top: -22px; background: linear-gradient(90deg, transparent, rgba(244, 242, 238, 0.4), transparent); }
  .stage__floor { margin-bottom: 22px; }
  @media (hover: hover) {
    .tile--venues:hover .stage__beam { opacity: 1; }
    .tile--venues:hover .stage__spot { opacity: 1; transform: scale(1.06); }
  }

  /* Airplay: a mirrored signal. On hover it moves. */
  .wave__bars { display: flex; align-items: center; justify-content: center; gap: clamp(4px, 1cqw, 8px); height: min(34cqw, 200px); }
  .wave__bars span { width: clamp(4px, 1cqw, 7px); height: calc(var(--h) * 100%); border-radius: 2px; background: linear-gradient(180deg, #2997ff, rgba(41, 151, 255, 0.25)); }
  @media (hover: hover) {
    :global(html[data-motion='fluid']) .tile--airplay:hover .wave__bars span { animation: pt-wave 1.1s ease-in-out infinite alternate; animation-delay: calc(var(--i) * -90ms); }
  }
  @keyframes pt-wave { from { transform: scaleY(1); } to { transform: scaleY(0.35); } }

  /* Charts: city names fading out, like a sound trailing off. Not a ranking: no numbers, no rules. */
  .cities { display: flex; flex-direction: column; align-items: center; gap: 0; margin: 0; padding: 0; list-style: none;
    font-size: clamp(1.6rem, 6.2cqw, 3rem); font-weight: 500; letter-spacing: -0.045em; line-height: 1.08; }
  .cities li { opacity: var(--o); }

  /* Collective: full width. Its inner grid splits on the gallery's centerline: words in the left column, the network
     centered in the right. */
  .tile--collective { grid-column: 1 / -1; grid-template-rows: none; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gap); align-items: center;
    height: auto; min-height: clamp(460px, 34vw, 560px); padding: var(--pad); text-align: left;
    background: radial-gradient(40% 80% at 75% 50%, rgba(41, 151, 255, 0.10), transparent 70%), #0b0b0d; }
  .tile--collective .tile__text { justify-self: stretch; align-items: flex-start; max-width: 520px; }
  .tile--collective .tile__actions { justify-content: flex-start; }
  .tile--collective .tile__line { max-width: 34ch; }
  .tile--collective .tile__media { margin: 0; height: 100%; }
  .web { width: min(100%, 400px); max-height: 100%; aspect-ratio: 1; display: block; }
  .web__rings circle { fill: none; stroke: rgba(244, 242, 238, 0.06); }
  .web__lines line { stroke: rgba(244, 242, 238, 0.12); stroke-width: 1; transition: stroke var(--m-card) var(--m-ease); }
  .web__nodes circle { fill: rgba(244, 242, 238, 0.7); }
  .web__nodes .web__mid { fill: rgba(244, 242, 238, 0.92); }
  .web__nodes .web__core { fill: #2997ff; }
  @media (hover: hover) { .tile--collective:hover .web__lines line { stroke: rgba(244, 242, 238, 0.26); } }

  /* Opus Verified: one slim line on the same outer edges, seal, statement and the way in. */
  .vstrip { grid-column: 1 / -1; display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 14px 22px; padding: 26px 28px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1); border-radius: var(--r-card); color: #f4f2ee; text-align: center; }
  .vstrip__seal { display: inline-flex; }
  .vstrip__text { margin: 0; font-size: clamp(1.15rem, 0.95rem + 0.8vw, 1.75rem); font-weight: 500; letter-spacing: -0.03em; color: rgba(244, 242, 238, 0.72); }
  .vstrip__name { color: #f4f2ee; }
  .vstrip__btn { color: #f4f2ee; border-color: rgba(244, 242, 238, 0.32); }
  .vstrip__btn:hover { opacity: 1; border-color: rgba(244, 242, 238, 0.6); }
  .vstrip__seal :global(svg) { display: block; }

  /* Motion: quiet, one idea per tile. Fully visible without JS; global reduced-motion turns it off. */
  :global(.js) .cities li { transform: translateY(6px); transition: transform calc(var(--m-card) * 1.4) var(--m-ease); transition-delay: calc(0.2s + var(--i) * 0.07s); }
  :global(.js) .tile--charts.is-in .cities li { transform: none; }

  /* Tablets and phones: one column, every card the same width and height, the same gap between them. */
  @media (max-width: 900px) {
    .pt__grid { grid-template-columns: minmax(0, 1fr); }
