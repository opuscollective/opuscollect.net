---
/**
 * Opus Collective on the homepage: one photograph, one statement, one way in.
 * Programs, events and the Discord live on /collective.
 */
import Icon from '../ui/Icon.astro';
---
<section class="collective tone-dark" aria-labelledby="collective-title">
  <div class="collective__media" aria-hidden="true">
    <img src="/images/scenic-room.jpg" alt="" loading="lazy" decoding="async" width="1600" height="2400" />
  </div>
  <div class="container collective__inner">
    <p class="t-meta collective__kicker" data-reveal>Opus Collective</p>
    <h2 id="collective-title" class="collective__title" data-reveal style="--d:.05s">Beyond the platform.</h2>
    <p class="collective__copy" data-reveal style="--d:.1s">A collective of artists, minds, and visionaries shaping what’s next.</p>
    <a class="collective__link" href="/collective" data-reveal style="--d:.15s">Explore the Collective <Icon name="arrow-right" size={16} /></a>
  </div>
</section>

<style>
  .collective { position: relative; isolation: isolate; overflow: hidden; background: var(--bg); color: var(--text);
    min-height: clamp(560px, 82vh, 880px); display: flex; align-items: flex-end; padding-block: clamp(72px, 10vw, 144px); }
  /* A real creator's room, in monochrome so it sits inside the charcoal palette. */
  .collective__media { position: absolute; inset: 0 0 0 auto; width: min(62%, 980px); z-index: -2; }
  .collective__media img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; filter: grayscale(1) contrast(1.08) brightness(0.82); }
  .collective::before { content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, var(--bg) 38%, color-mix(in srgb, var(--bg) 55%, transparent) 62%, transparent 100%), linear-gradient(0deg, var(--bg), transparent 30%); }
  .collective__inner { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .collective__kicker { color: var(--text-3); }
  .collective__title { font-size: clamp(3rem, 1.2rem + 6vw, 7.5rem); line-height: 0.92; letter-spacing: -0.06em; font-weight: 500; max-width: 8ch; }
  .collective__copy { max-width: 30ch; font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem); line-height: 1.4; letter-spacing: -0.015em; color: var(--text-2); }
  .collective__link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin-top: 12px; font-size: 16px; font-weight: 500; border-bottom: 1px solid currentColor; }
  .collective__link:hover { opacity: 0.7; }
  @media (max-width: 760px) {
    .collective { flex-direction: column; align-items: stretch; min-height: 0; padding-top: 0; }
    .collective__media { position: relative; inset: auto; width: 100%; aspect-ratio: 4 / 5; max-height: 70vh; }
    .collective::before { background: linear-gradient(0deg, var(--bg) 30%, transparent 55%); }
    .collective__inner { margin-top: -96px; }
  }
</style>
