---
/** Events and community programs as a row of pictures. Details live on /events and /community. */
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
const CARDS = [
  { title: 'The Opus Summit', kicker: 'Summer 2027', href: '/events#summit', image: '/images/summit-resort.jpg', alt: 'Aerial view of a resort pool lit up at night', photo: true },
  { title: 'Collective Call', kicker: 'In the Discord', href: '/community', image: '/images/event-collective-call.jpg', alt: 'Collective Call graphic' },
  { title: 'Feedback Wednesday', kicker: 'In the Discord', href: '/community', image: '/images/event-feedback-wednesday.jpg', alt: 'Feedback Wednesday graphic' },
  { title: 'Live Music Reviews', kicker: 'In the Discord', href: '/community', image: '/images/event-live-reviews.jpg', alt: 'Live Music Reviews graphic' },
];
---
<section class="section events" aria-labelledby="events-title">
  <div class="container">
    <SectionHeader index="03" label="Opus Collective" tag="In the room" />
    <div class="events__top">
      <h2 id="events-title" class="t-h2" data-reveal>From the server <span class="dim">to the same room.</span></h2>
      <a href="/events" class="events__all" data-reveal>All events <Icon name="arrow-right" size={16} /></a>
    </div>
    <ul class="events__row" role="list">
    {CARDS.map((c, i) => (
      <li data-reveal style={`--d:${i * 0.06}s`}>
        <a href={c.href} class="events__card">
          <span class:list={['events__img', { 'events__img--photo': c.photo }]}><img src={c.image} alt={c.alt} loading="lazy" decoding="async" /></span>
          <span class="t-meta events__kicker">{c.kicker}</span>
          <span class="events__title">{c.title}</span>
        </a>
      </li>
    ))}
    </ul>
  </div>
</section>

<style>
  .events__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px 24px; margin-top: clamp(28px, 3.5vw, 48px); }
  .events__top h2 { max-width: 18ch; }
  .events__all { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 15px; font-weight: 500; }
  .events__all:hover { text-decoration: underline; text-underline-offset: 6px; }
  .events__row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin: clamp(24px, 3vw, 40px) 0 0; padding: 0; list-style: none; }
  .events__card { display: flex; flex-direction: column; gap: 8px; }
  .events__img { display: block; aspect-ratio: 4 / 3; border-radius: var(--r-lg); overflow: hidden; background: #0b0b0c; }
  .events__img img { width: 100%; height: 100%; object-fit: contain; transition: transform 1.2s var(--ease); }
  .events__img--photo img { object-fit: cover; }
  .events__card:hover img { transform: scale(1.04); }
  .events__kicker { margin-top: 6px; color: var(--text-3); }
  .events__title { font-size: 18px; font-weight: 500; letter-spacing: -0.02em; }
  /* Phones: one swipeable row. */
  @media (max-width: 760px) {
    .events__row { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 72%; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; gap: 10px; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); }
    .events__row::-webkit-scrollbar { display: none; }
    .events__row li { scroll-snap-align: start; }
  }
</style>
