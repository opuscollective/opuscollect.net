---
import { CITIES } from '@/data/cities';

// Fallback links when WebGL is unavailable. Plain city names only; live counts come from /api/world.
const topCities = CITIES.slice(0, 8);
---
<section class="hero tone-dark" aria-labelledby="hero-title">
  <div class="hero__globe" data-hero-globe>
    <div class="hero__loading" data-globe-loading aria-hidden="true"><span></span></div>
    <!-- Accessible fallback, shown when WebGL is not available -->
    <nav class="hero__fallback" data-globe-fallback hidden aria-label="Browse by city">
      <p class="t-meta">Browse by city</p>
      <ul role="list">{topCities.map((c) => <li><a href={`/world?city=${encodeURIComponent(c.name)}`}>{c.name}</a></li>)}</ul>
    </nav>
  </div>
  <div class="hero__fade" aria-hidden="true"></div>

  <div class="container hero__inner">
    <h1 id="hero-title" class="hero__title">
      <span class="hero__line"><span class="hero-in" style="--i:1">The future of</span></span>
      <span class="hero__line"><span class="hero-in" style="--i:2">music is</span></span>
      <span class="hero__line"><span class="hero-in" style="--i:3">independent.</span></span>
    </h1>

    <div class="opus-entry hero-in" style="--i:5">
      <p class="opus-entry__kicker t-meta">Your vision starts here</p>
      <form class="opus-entry__form" action="/world" method="get" role="search" data-hero-search autocomplete="off">
        <label for="opus-q" class="opus-entry__q">What are you trying to accomplish?</label>
        <div class="hsearch">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4.3-4.3"/></svg>
          <input id="opus-q" name="q" type="text" placeholder="Describe what you need: a producer in Birmingham, a studio in London…" />
          <button type="submit">Go</button>
        </div>
      </form>
      <p class="hsearch__result t-meta" data-hero-result aria-live="polite"></p>
    </div>

  </div>
</section>

<script>
  import { findCity } from '@/data/cities';
  type CityPoint = { city: string; country: string; lat: number; lng: number; count: number };

  const host = document.querySelector<HTMLElement>('[data-hero-globe]');
  const form = document.querySelector<HTMLFormElement>('[data-hero-search]');
  const result = document.querySelector<HTMLElement>('[data-hero-result]');
  let api: { flyTo: (lat: number, lng: number) => void } | null = null;

  const hasWebGL = () => {
    try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; }
  };
  const fail = () => {
    host?.querySelector('[data-globe-loading]')?.remove();
    const fb = host?.querySelector<HTMLElement>('[data-globe-fallback]');
    if (fb) fb.hidden = false;
  };

  async function boot() {
    if (!host) return;
    if (!hasWebGL()) return fail();
    const points: CityPoint[] = await summary;
    try {
      const { mountHeroGlobe } = await import('@/scripts/hero-globe');
      api = await mountHeroGlobe(host, points, {
        onSelect: (p) => { location.href = `/world?city=${encodeURIComponent(p.city)}`; },
      });
      host.classList.add('is-ready');
      host.querySelector('[data-globe-loading]')?.remove();
    } catch (err) {
      console.error('Globe failed to load', err);
      fail();
    }
  }

  // Real member counts by city (aggregated to the metro, never exact locations).
  const summary: Promise<CityPoint[]> = fetch('/api/world?summary=1')
    .then((r) => (r.ok ? r.json() : Promise.reject(new Error(`HTTP ${r.status}`))))
    .then((d: { cities: CityPoint[] }) => {
      return d.cities;
    })
    .catch((err) => { console.error('Could not load member counts', err); return []; });

  // Load the globe once the hero is visible and the main thread is idle.
  if (host) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        const idle = (window as any).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
        idle(boot);
      }
    });
    io.observe(host);
  }

  // A city name on its own rotates the globe to it, then offers to open it in Opus World.
  form?.addEventListener('submit', (e) => {
    const q = (form.elements.namedItem('q') as HTMLInputElement).value.trim();
    const c = findCity(q);
    if (!c) return; // Not just a city name: submit to /world as a keyword search (honest empty state if nothing matches).
    e.preventDefault();
    // Phones: the globe sits below the entry, out of view, so open the city in Opus World directly.
    if (matchMedia('(max-width: 900px)').matches) { location.href = `/world?city=${encodeURIComponent(c.name)}`; return; }
    if (api) api.flyTo(c.lat, c.lng);
    if (result) {
      result.innerHTML = `<a href="/world?city=${encodeURIComponent(c.name)}">Open ${c.name} in Opus World →</a>`;
    }
    if (!api) location.href = `/world?city=${encodeURIComponent(c.name)}`;
  });
</script>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: max(100svh, 720px); display: flex; align-items: center;
    padding-top: 96px; padding-bottom: 64px;
    background: radial-gradient(80% 60% at 75% 45%, color-mix(in srgb, var(--accent) 5%, var(--bg)) 0%, var(--bg) 70%);
  }
  /* Edge-to-edge globe on the right; bleeds off the page edge */
  .hero__globe {
    position: absolute; z-index: 0; top: 50%; right: -18vw;
    width: min(1100px, 82vw); aspect-ratio: 1; transform: translateY(-50%);
    cursor: grab; touch-action: none;
  }
  .hero__globe:active { cursor: grabbing; }
  .hero__globe :global(canvas) { outline: none; }
  .hero__globe { opacity: 0; transition: opacity 1.4s var(--ease); }
  .hero__globe.is-ready, .hero__globe:has([data-globe-fallback]:not([hidden])) { opacity: 1; }
  .hero__globe:has([data-globe-loading]) { opacity: 1; }
  .hero__loading { position: absolute; inset: 12%; display: grid; place-items: center; }
  .hero__loading span { width: 100%; aspect-ratio: 1; border-radius: 50%; border: 1px solid var(--line); box-shadow: inset 0 0 120px color-mix(in srgb, var(--accent) 5%, transparent); animation: breathe 2.4s ease-in-out infinite; }
  @keyframes breathe { 50% { border-color: var(--line-strong); } }
  .hero__fallback { position: absolute; inset: 20% 15%; display: flex; flex-direction: column; justify-content: center; gap: 16px; }
  .hero__fallback ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .hero__fallback a { display: inline-flex; gap: 8px; padding: 8px 12px; border: 1px solid var(--c-ink-600); border-radius: var(--r-sm); font-size: 14px; }

  /* Keeps type legible where it overlaps the globe */
  .hero__fade { position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg, var(--c-bg) 0%, color-mix(in srgb, var(--bg) 85%, transparent) 30%, transparent 58%), linear-gradient(0deg, var(--c-bg) 0%, transparent 18%); }

  .hero__inner { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; pointer-events: none; }
  .hero__inner > * { pointer-events: auto; }
  .hero__title { font-size: clamp(2.75rem, 1rem + 6.2vw, 7.25rem); line-height: 0.92; letter-spacing: -0.06em; font-weight: 500; max-width: 9.5ch; }
  .hero__line { display: block; overflow: hidden; padding-bottom: 0.05em; }
  .hero__line > span { display: inline-block; }

  .opus-entry { display: flex; flex-direction: column; gap: 12px; width: min(100%, 520px); margin-top: 8px; padding-top: 24px; border-top: 1px solid var(--c-line); }
  .opus-entry__kicker { color: var(--accent); }
  .opus-entry__form { display: flex; flex-direction: column; gap: 14px; }
  .opus-entry__q { font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem); line-height: 1.15; letter-spacing: -0.035em; font-weight: 500; color: var(--text); }
  .hsearch { display: flex; align-items: center; gap: 12px; width: 100%; height: 56px; padding: 0 6px 0 18px;
    background: color-mix(in srgb, var(--surface) 80%, transparent); border: 1px solid var(--c-ink-600); border-radius: var(--r-md); backdrop-filter: blur(12px); color: var(--c-fg-faint);
    transition: border-color var(--dur) var(--ease); }
  .hsearch:focus-within { border-color: var(--c-accent); }
  .hsearch input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: var(--c-white); font-size: 16px; }
  .hsearch input::placeholder { color: var(--text-3); }
  .hsearch button { height: 44px; padding: 0 18px; border: 0; border-radius: var(--r-sm); background: var(--c-white); color: var(--c-black); font-weight: 500; }
  .hsearch__result:empty { display: none; }
  .hsearch__result { margin-top: -4px; color: var(--c-accent); }
  .hsearch__result :global(a:hover) { text-decoration: underline; }

  .js .hero-in { opacity: 0; transform: translateY(0.5em); animation: hero-in 1.1s var(--ease) forwards; animation-delay: calc(var(--i) * 80ms + 120ms); }
  .js .hero__line .hero-in { transform: translateY(105%); }
  @keyframes hero-in { to { opacity: 1; transform: none; } }

  :global(.gl-tip) { padding: 8px 10px; background: var(--glass); border: 1px solid var(--line-strong); border-radius: 6px; font: 13px var(--font-sans); color: var(--text); display: flex; flex-direction: column; gap: 2px; }
  :global(.gl-tip span) { color: var(--text-3); font-size: 12px; }

  /* Phones and small tablets: brand statement and the Opus entry come first, then the globe.
     .hero__inner dissolves (display: contents) so its children and the one globe instance share a single
     column and can be reordered without moving or duplicating any markup. */
  @media (max-width: 900px) {
    .hero { flex-direction: column; align-items: stretch; gap: 20px; min-height: auto; padding: 88px var(--gutter) 40px; }
    .hero__inner { display: contents; }
    .hero__title { order: 1; font-size: clamp(2.75rem, 12vw, 3.75rem); max-width: none; }
    .opus-entry { order: 2; width: 100%; max-width: 560px; margin-top: 4px; padding-top: 20px; }
    .hero__globe { order: 3; position: relative; top: auto; right: auto; transform: none; width: min(100%, 420px); aspect-ratio: 1; margin: 0 auto -8px; align-self: center; overflow: hidden; touch-action: pan-y; }
    .hero__fade { display: none; }
  }
</style>
