---
import { CITIES, citySlug } from '@/data/cities';
import Icon from '../ui/Icon.astro';

// Fallback links when WebGL is unavailable. Plain city names only; live counts come from /api/world.
const topCities = CITIES.slice(0, 8);
---
<section class="hero tone-dark" aria-labelledby="hero-title" data-hero>
  <div class="hero__globe" data-hero-globe>
    <div class="hero__loading" data-globe-loading aria-hidden="true"><span></span></div>
  </div>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="container hero__stage" data-hero-stage>
    <h1 id="hero-title" class="hero__title">
      <span class="hero__line"><span class="hero-in" style="--i:1">The future of music</span></span>
      <span class="hero__line"><span class="hero-in" style="--i:2">is independent.</span></span>
    </h1>

    <p class="hero__value hero-in" style="--i:3">Make connections around the world.</p>

    <div class="opus-entry hero-in" style="--i:4">
      <form class="opus-entry__form" action="/world" method="get" role="search" data-hero-search autocomplete="off">
        <label for="opus-q" class="sr-only">What are you trying to accomplish?</label>
        <div class="hsearch">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4.3-4.3"/></svg>
          <input id="opus-q" name="q" type="text" placeholder="What are you trying to accomplish?" />
          <button type="submit" aria-label="Search"><Icon name="arrow-right" size={18} /></button>
        </div>
      </form>
      <!-- Ways in without typing. Each goes to a real page; Charts is still in development and says so. -->
      <ul class="opus-quick" role="list" aria-label="Shortcuts">
        <li><a href="/musicians" data-hero-kind="musician">Find People</a></li>
        <li><a href="/studios" data-hero-kind="studio">Find Studios</a></li>
        <li><a href="/charts">Explore Charts <span class="opus-quick__soon">Soon</span></a></li>
        <li><a href="/music">My Releases</a></li>
      </ul>
      <a class="opus-entry__open" href="/world" data-hero-open>Explore World <Icon name="arrow-right" size={18} /></a>
    </div>

    <!-- Accessible fallback, shown when WebGL is not available -->
    <nav class="hero__fallback" data-globe-fallback hidden aria-label="Browse by city">
      <ul role="list">{topCities.map((c) => <li><a href={`/world/${citySlug(c.name)}`}>{c.name}</a></li>)}</ul>
    </nav>
  </div>

  <!-- Shown while the browser asks for the visitor's location. -->
  <p class="dv-locate" data-locate hidden aria-live="polite"><span class="dv-locate__dot" aria-hidden="true"></span><span data-locate-text>Finding where you are…</span></p>

</section>

<script>
  import { CITIES, findCity, citySlug } from '@/data/cities';
  import type { ListingKind } from '@/types/directory';
  type CityPoint = { city: string; country: string; lat: number; lng: number; count: number };
  type Near = { lat: number; lng: number };

  /*
   * One World. Every way in from this page (Explore World, the search box, Find People,
   * Find Studios and the cities on the globe) does the same thing: the camera closes in on this globe,
   * finds the place, then World opens there. There is no second, homepage-only directory.
   */
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const host = hero.querySelector<HTMLElement>('[data-hero-globe]')!;
  const form = hero.querySelector<HTMLFormElement>('[data-hero-search]')!;
  const input = form.querySelector<HTMLInputElement>('input')!;
  const locate = hero.querySelector<HTMLElement>('[data-locate]')!;
  const locateText = locate.querySelector<HTMLElement>('[data-locate-text]')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let api: { spin: () => void; flyTo: (lat: number, lng: number) => void; dive: (lat?: number, lng?: number, close?: boolean) => void; here: (lat: number, lng: number) => void; rise: () => void } | null = null;
  /** The visitor's position, kept in this page only. Never sent to Opus or stored. */
  let me: Near | null = null;
  let meCity: { city: import('@/data/cities').City; km: number } | undefined;

  const hasWebGL = () => {
    try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; }
  };
  const fail = () => {
    host.querySelector('[data-globe-loading]')?.remove();
    const fb = hero.querySelector<HTMLElement>('[data-globe-fallback]');
    if (fb) fb.hidden = false;
  };

  // Real member counts by city (aggregated to the metro, never exact locations).
  const summary: Promise<CityPoint[]> = fetch('/api/world?summary=1')
    .then((r) => (r.ok ? r.json() : Promise.reject(new Error(`HTTP ${r.status}`))))
    .then((d: { cities: CityPoint[] }) => d.cities)
    .catch((err) => { console.error('Could not load member counts', err); return []; });

  async function boot() {
    if (!hasWebGL()) return fail();
    const points = await summary;
    try {
      const { mountHeroGlobe } = await import('@/scripts/hero-globe');
      api = await mountHeroGlobe(host, points, {
        onSelect: (p) => { const c = findCity(p.city); go({ lat: c?.lat ?? p.lat, lng: c?.lng ?? p.lng, href: c ? cityHref(c.name) : worldHref() }); },
      });
      host.classList.add('is-ready');
      host.querySelector('[data-globe-loading]')?.remove();
    } catch (err) {
      console.error('Globe failed to load', err);
      fail();
    }
  }
  const idle = (window as any).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
  idle(boot);

  // ---------- Where World opens ----------
  // Phones open the full-screen map; wider screens open World's usual directory beside the map.
  const phone = () => matchMedia('(max-width: 760px)').matches;
  const qs = (extra: Record<string, string> = {}) => {
    const u = new URLSearchParams(extra);
    if (phone()) u.set('view', 'map');
    const s = u.toString();
    return s ? `?${s}` : '';
  };
  const cityHref = (name: string, extra: Record<string, string> = {}) => `/world/${citySlug(name)}${qs(extra)}`;
  const worldHref = (extra: Record<string, string> = {}) => `/world${qs(extra)}`;

  // ---------- Location: ask the browser, then fly to where the visitor is ----------
  function askLocation(): Promise<Near | null> {
    if (!('geolocation' in navigator)) return Promise.resolve(null);
    return new Promise((resolve) => {
      navigator.geolocation.getCurrentPosition(
        (p) => resolve({ lat: p.coords.latitude, lng: p.coords.longitude }),
        () => resolve(null),
        { enableHighAccuracy: false, timeout: 12000, maximumAge: 10 * 60 * 1000 },
      );
    });
  }
  async function findMe(): Promise<boolean> {
    showLocate('Finding where you are…');
    const pos = await askLocation();
    if (pos) {
      const mod = await import('@/scripts/hero-dive');
      me = pos;
      meCity = mod.nearestCity(CITIES, pos);
      api?.here(pos.lat, pos.lng);
    }
    return !!pos;
  }
  function showLocate(text: string) {
    locateText.textContent = text;
    locate.hidden = false;
    requestAnimationFrame(() => locate.classList.add('is-on'));
  }

  // ---------- The move: words dissolve, the camera closes in, World opens at that spot ----------
  let leaving = false;
  const leave = (href: string, after: number) => setTimeout(() => { location.href = href; }, reduce ? 0 : after);
  function start(): boolean {
    if (leaving) return false;
    leaving = true;
    if (scrollY > 0) scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    hero.classList.add('is-diving', 'is-leaving');
    return true;
  }
  /** A known place (a city on the globe, or one typed in the search box). */
  function go(to: { lat: number; lng: number; href: string; label?: string }) {
    if (!api) { location.href = to.href; return; }
    if (!start()) return;
    api.dive(to.lat, to.lng, true);
    if (to.label) showLocate(to.label);
    leave(to.href, 1500);
  }
  /** No place given: find the visitor, fly to their area, open World there. Without location, the whole world turns. */
  async function explore(kind: ListingKind | '' = '') {
    const extra: Record<string, string> = kind ? { type: kind } : {};
    if (!api) { location.href = kind ? `/${kind === 'musician' ? 'musicians' : 'studios'}` : worldHref(); return; }
    if (!start()) return;
    api.dive();
    const found = me ? (api.here(me.lat, me.lng), true) : await findMe();
    if (found && meCity && meCity.km < 300) {
      showLocate(`Taking you to ${meCity.city.name}`);
      leave(cityHref(meCity.city.name, extra), 1900);
    } else {
      api.spin();
      showLocate(found ? 'Taking you to World' : 'Opening the whole world');
      leave(worldHref(extra), 1500);
    }
  }

  const plainClick = (e: MouseEvent) => !(e.metaKey || e.ctrlKey || e.shiftKey || e.altKey);
  hero.querySelector<HTMLAnchorElement>('[data-hero-open]')?.addEventListener('click', (e) => {
    if (!plainClick(e)) return;
    e.preventDefault();
    explore();
  });
  // Without the globe (no WebGL) these stay plain links to /musicians and /studios.
  hero.querySelectorAll<HTMLAnchorElement>('[data-hero-kind]').forEach((a) => a.addEventListener('click', (e) => {
    if (!api || !plainClick(e)) return;
    e.preventDefault();
    explore(a.dataset.heroKind as ListingKind);
  }));
  // Words: a city flies there; anything else is searched in World.
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const t = input.value.trim();
    if (!t) return explore();
    const head = t.split(',')[0]!.trim().toLowerCase();
    const exact = findCity(t);
    const named = exact ?? CITIES.find((c) => new RegExp(`\\b${c.name}\\b`, 'i').test(t));
    if (named && named.name.toLowerCase() === head) return go({ lat: named.lat, lng: named.lng, href: cityHref(named.name), label: `Taking you to ${named.name}` });
    if (named) return go({ lat: named.lat, lng: named.lng, href: cityHref(named.name, { q: t.replace(new RegExp(`\\b(in|near|around)?\\s*${named.name}\\b`, 'i'), '').trim() }), label: `Taking you to ${named.name}` });
    location.href = worldHref({ q: t });
  });

  // Coming back with the back button restores this page from cache: undo the dive.
  addEventListener('pageshow', (e) => {
    if (!e.persisted || !leaving) return;
    leaving = false;
    hero.classList.remove('is-diving', 'is-leaving');
    locate.classList.remove('is-on'); locate.hidden = true;
    api?.rise();
  });
</script>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: max(100svh, 680px); display: flex; align-items: center; justify-content: center;
    padding-block: 96px 64px; background: var(--bg);
  }
  /* Faint stars behind the Earth. Three tiled layers at different sizes so no pattern shows. */
  .hero::before { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0.9;
    background-image:
      radial-gradient(1px 1px at 23px 41px, rgba(255,255,255,.8) 50%, transparent 51%),
      radial-gradient(1px 1px at 157px 97px, rgba(255,255,255,.55) 50%, transparent 51%),
      radial-gradient(1.4px 1.4px at 91px 173px, rgba(220,232,255,.9) 50%, transparent 51%),
      radial-gradient(1px 1px at 211px 13px, rgba(255,255,255,.45) 50%, transparent 51%),
      radial-gradient(1px 1px at 67px 229px, rgba(255,255,255,.6) 50%, transparent 51%),
      radial-gradient(1.2px 1.2px at 301px 151px, rgba(255,255,255,.7) 50%, transparent 51%);
    background-size: 140px 160px, 230px 190px, 310px 270px, 170px 210px, 260px 150px, 420px 370px; }
  /* The globe fills the hero, behind the words. */
  .hero__globe { position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0; transition: opacity 1.4s var(--ease); }
  /* Only inside World can you turn and zoom the globe; on the homepage it just spins. */
  .hero__globe :global(canvas) { outline: none; }
  .hero__globe.is-ready, .hero__globe:has([data-globe-loading]) { opacity: 1; }
  .hero__loading { position: absolute; inset: 0; display: grid; place-items: center; }
  .hero__loading span { width: min(68vh, 90vw); aspect-ratio: 1; border-radius: 50%; border: 1px solid var(--line); animation: breathe 2.4s ease-in-out infinite; }
  @keyframes breathe { 50% { border-color: var(--line-strong); } }
  /* A soft pool of darkness behind the words keeps them legible over the globe. */
  .hero__veil { position: absolute; inset: 0; z-index: 1; pointer-events: none; transition: opacity 1s var(--ease);
    background: radial-gradient(50% 42% at 50% 50%, color-mix(in srgb, var(--bg) 78%, transparent) 0%, color-mix(in srgb, var(--bg) 40%, transparent) 60%, transparent 100%), linear-gradient(0deg, var(--bg) 0%, transparent 16%); }

  .hero__stage { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 36px; pointer-events: none;
    transition: transform 0.9s cubic-bezier(.5, 0, .2, 1), opacity 0.7s var(--ease), filter 0.9s var(--ease); }
  .hero__stage > * { pointer-events: auto; }
  .hero__title { font-size: clamp(2.6rem, 1rem + 5.6vw, 6.75rem); line-height: 0.95; letter-spacing: -0.06em; font-weight: 500; color: #f4f2ee; }
  .hero__value { margin: -14px 0 0; font-size: clamp(1.1rem, 0.95rem + 0.6vw, 1.5rem); line-height: 1.3; letter-spacing: -0.02em; color: rgba(244, 242, 238, 0.76); }
  .hero__line { display: block; overflow: hidden; padding-bottom: 0.05em; }
  .hero__line > span { display: inline-block; }

  .opus-entry { display: flex; flex-direction: column; align-items: center; gap: 14px; width: min(100%, 560px); }
  .opus-entry__form { display: flex; flex-direction: column; align-items: center; gap: 16px; width: 100%; }
  .hsearch { display: flex; align-items: center; gap: 12px; width: 100%; height: 58px; padding: 0 6px 0 20px; text-align: left;
    background: color-mix(in srgb, var(--surface) 72%, transparent); border: 1px solid var(--c-ink-600); border-radius: var(--r-pill); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); color: var(--c-fg-faint);
    transition: border-color var(--dur) var(--ease); }
  .hsearch:focus-within { border-color: var(--c-accent); }
  .hsearch input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: var(--c-white); font-size: 16px; }
  .hsearch input::placeholder { color: var(--text-3); }
  .hsearch button { display: grid; place-items: center; width: 46px; height: 46px; padding: 0; border: 0; border-radius: 50%; background: color-mix(in srgb, var(--c-white) 14%, transparent); color: var(--c-white); cursor: pointer; transition: background var(--dur) var(--ease); }
  .hsearch button:hover { background: color-mix(in srgb, var(--c-white) 24%, transparent); }
  .opus-quick { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 2px 0 0; padding: 0; list-style: none; }
  .opus-quick a { display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 16px; border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--surface) 55%, transparent); border: 1px solid var(--line); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    font-size: 14px; font-weight: 500; letter-spacing: -0.01em; color: var(--text-2); white-space: nowrap;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease), background var(--dur) var(--ease); }
  .opus-quick a:hover { color: var(--text); border-color: var(--line-strong); background: color-mix(in srgb, var(--surface) 80%, transparent); }
  .opus-quick a:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 2px; }
  .opus-quick__soon { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); }
  /* The primary action: one bright pill, last in the hierarchy but the strongest control. */
  .opus-entry__open { display: inline-flex; align-items: center; gap: 10px; min-height: 54px; margin-top: 12px; padding: 0 30px; border-radius: var(--r-pill);
    background: var(--c-white); color: var(--c-black); font-size: 16px; font-weight: 500; letter-spacing: -0.01em;
    box-shadow: 0 18px 50px -18px rgba(0, 0, 0, 0.7); transition: gap var(--dur) var(--ease), transform var(--dur) var(--ease); }
  .opus-entry__open:hover { gap: 14px; transform: translateY(-1px); }
  .opus-entry__open:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 4px; }

  .hero__fallback ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 0; }
  .hero__fallback a { display: inline-flex; padding: 8px 12px; border: 1px solid var(--c-ink-600); border-radius: var(--r-pill); font-size: 14px; }

  /* Diving: the words move toward the viewer and dissolve while the camera closes in on the globe. */
  .hero.is-diving .hero__stage { transform: scale(1.35); opacity: 0; filter: blur(8px); pointer-events: none; }
  .hero.is-diving .hero__stage > * { pointer-events: none; }
  .hero.is-diving .hero__veil { opacity: 0.35; }

  /* ---------- Finding the visitor ---------- */
  .dv-locate { position: absolute; left: 50%; bottom: 14%; z-index: 4; display: inline-flex; align-items: center; gap: 10px; margin: 0; padding: 12px 18px;
    transform: translate(-50%, 8px); opacity: 0; transition: opacity .3s var(--ease), transform .3s var(--ease);
    background: color-mix(in srgb, var(--bg) 80%, transparent); border: 1px solid var(--line); border-radius: var(--r-pill);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); font-size: 14px; color: var(--text); white-space: nowrap; }
  .dv-locate.is-on { opacity: 1; transform: translate(-50%, 0); }
  .dv-locate__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); animation: ping 1.4s ease-out infinite; }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); } 100% { box-shadow: 0 0 0 12px transparent; } }

  .hero__globe { transition: opacity 1.4s var(--ease), transform 1.2s var(--ease); }


  .js .hero-in { opacity: 0; transform: translateY(0.5em); animation: hero-in 1.1s var(--ease) forwards; animation-delay: calc(var(--i) * 80ms + 120ms); }
  .js .hero__line .hero-in { transform: translateY(105%); }
  @keyframes hero-in { to { opacity: 1; transform: none; } }

  /* Map-from-space labels on the globe. */
  :global(.gl-label) { pointer-events: none; transform: translate(-50%, -50%); white-space: nowrap; text-align: center; transition: opacity .4s var(--ease);
    font-family: var(--font-sans); text-shadow: 0 1px 2px rgba(0,0,0,.8), 0 0 10px rgba(0,0,0,.6); }
  :global(.gl-label--land) { font-size: 11px; font-weight: 600; letter-spacing: .28em; text-transform: uppercase; color: rgba(255,255,255,.92); }
  :global(.gl-label--sea) { max-width: 7em; white-space: normal; font-size: 11px; font-style: italic; font-weight: 500; letter-spacing: .06em; line-height: 1.15; color: rgba(150,200,240,.85); }
  /* You are here, the Opus way: the OC mark in a dark glass chip, with icy sound waves rippling out. */
  :global(.gl-label--me) { position: relative; width: 34px; height: 34px; }
  :global(.gl-label--me span) { position: absolute; inset: 0; display: grid; place-items: center; border-radius: 50%;
    background: rgba(12, 13, 16, 0.82); border: 1px solid rgba(255, 255, 255, 0.85); box-shadow: 0 4px 14px rgba(0, 0, 0, 0.55); backdrop-filter: blur(6px); }
  :global(.gl-label--me img) { width: 18px; height: auto; }
  :global(.gl-label--me b) { position: absolute; inset: 0; border-radius: 50%; border: 1.5px solid rgba(169, 199, 236, 0.9);
    animation: me-wave 2.4s cubic-bezier(.2, .6, .3, 1) infinite; }
  :global(.gl-label--me b:nth-child(2)) { animation-delay: .8s; }
  :global(.gl-label--me b:nth-child(3)) { animation-delay: 1.6s; }
  @keyframes me-wave { from { transform: scale(1); opacity: .9; } to { transform: scale(2.8); opacity: 0; } }
  @media (max-width: 760px) { :global(.gl-label--land), :global(.gl-label--sea) { font-size: 9.5px; } }
  /* The headline sits over the globe: map labels appear only once you dive in. */
  .hero:not(.is-diving) :global(.gl-label--land), .hero:not(.is-diving) :global(.gl-label--sea) { opacity: 0 !important; }
  :global(.gl-tip) { padding: 8px 10px; background: var(--glass); border: 1px solid var(--line-strong); border-radius: 6px; font: 13px var(--font-sans); color: var(--text); display: flex; flex-direction: column; gap: 2px; }
  :global(.gl-tip span) { color: var(--text-3); font-size: 12px; }

  /* Phones: the same order, stacked tighter. */
  @media (max-width: 760px) {
    .hero { min-height: max(calc(100svh - 48px), 600px); padding: 84px 0 calc(32px + env(safe-area-inset-bottom)); }
    .hero__stage { gap: 26px; }
    .hero__title { font-size: clamp(2.5rem, 11vw, 3.25rem); line-height: 0.98; }
    .hero__value { margin-top: -10px; font-size: 1.05rem; }
    .opus-entry { gap: 12px; }
    .hsearch { height: 54px; padding-left: 16px; }
    .hsearch input { font-size: 16px; }
    .hsearch button { width: 42px; height: 42px; }
    .opus-quick { gap: 6px; }
    .hsearch > svg { display: none; }
    .opus-quick a { height: 36px; padding: 0 14px; font-size: 13.5px; }
    .opus-entry__open { min-height: 52px; margin-top: 8px; }
    .hero__veil { background: radial-gradient(80% 50% at 50% 50%, color-mix(in srgb, var(--bg) 70%, transparent) 0%, transparent 100%), linear-gradient(0deg, var(--bg) 0%, transparent 16%); }
    .dv-locate { bottom: auto; top: 40%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__stage { transition: none; }
  }
</style>
