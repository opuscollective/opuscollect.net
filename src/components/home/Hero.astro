---
import Button from '../ui/Button.astro';
import { SITE } from '@/data/site';
import { SAMPLE_LISTINGS } from '@/data/sample-world';
import { byCity, stats } from '@/lib/world';
import { CITIES } from '@/data/cities';

const points = byCity(SAMPLE_LISTINGS);
const s = stats(SAMPLE_LISTINGS);
const topCities = [...points].sort((a, b) => b.count - a.count).slice(0, 8);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__globe" data-hero-globe data-points={JSON.stringify(points)}>
    <div class="hero__loading" data-globe-loading aria-hidden="true"><span></span></div>
    <!-- Accessible fallback, shown when WebGL is not available -->
    <nav class="hero__fallback" data-globe-fallback hidden aria-label="Browse by city">
      <p class="t-meta">Browse by city</p>
      <ul role="list">{topCities.map((c) => <li><a href={`/world?city=${encodeURIComponent(c.city)}`}>{c.city}<span>{c.count}</span></a></li>)}</ul>
    </nav>
  </div>
  <div class="hero__fade" aria-hidden="true"></div>

  <div class="container hero__inner">
    <p class="hero__eyebrow t-meta hero-in" style="--i:0"><span class="hero__dot" aria-hidden="true"></span>Opus World · {SITE.motto}</p>
    <h1 id="hero-title" class="hero__title">
      <span class="hero__line"><span class="hero-in" style="--i:1">The future of</span></span>
      <span class="hero__line"><span class="hero-in" style="--i:2">music is</span></span>
      <span class="hero__line"><span class="hero-in" style="--i:3">independent.</span></span>
    </h1>
    <p class="hero__lead hero-in" style="--i:4">
      Discover the artists, producers, engineers, studios, and organizations shaping what’s next.
    </p>

    <form class="hsearch hero-in" style="--i:5" action="/world" method="get" role="search" data-hero-search autocomplete="off">
      <label for="hero-city" class="sr-only">Search a city</label>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4.3-4.3"/></svg>
      <input id="hero-city" name="city" type="text" placeholder="Search a city: Atlanta, London, Lagos…" list="hero-cities" />
      <datalist id="hero-cities">{CITIES.map((c) => <option value={c.name}>{c.countryName}</option>)}</datalist>
      <button type="submit">Go</button>
    </form>
    <p class="hsearch__result t-meta" data-hero-result aria-live="polite"></p>

    <div class="hero__ctas hero-in" style="--i:6">
      <Button href="/world" size="lg" arrow="right">Explore the World</Button>
      <Button href="/join.html" variant="secondary" size="lg">Join Opus</Button>
    </div>

    <dl class="hero__stats hero-in" style="--i:7" aria-label="Sample data statistics">
      <div><dt>Musicians</dt><dd>{s.musicians}</dd></div>
      <div><dt>Studios</dt><dd>{s.studios}</dd></div>
      <div><dt>Countries</dt><dd>{s.countries}</dd></div>
      <p class="hero__statnote t-meta">Sample data · live counts arrive with member accounts</p>
    </dl>
  </div>
</section>

<script>
  import { findCity } from '@/data/cities';
  type CityPoint = { city: string; country: string; lat: number; lng: number; count: number };

  const host = document.querySelector<HTMLElement>('[data-hero-globe]');
  const form = document.querySelector<HTMLFormElement>('[data-hero-search]');
  const result = document.querySelector<HTMLElement>('[data-hero-result]');
  let api: { flyTo: (lat: number, lng: number) => void } | null = null;

  const hasWebGL = () => {
    try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; }
  };
  const fail = () => {
    host?.querySelector('[data-globe-loading]')?.remove();
    const fb = host?.querySelector<HTMLElement>('[data-globe-fallback]');
    if (fb) fb.hidden = false;
  };

  async function boot() {
    if (!host) return;
    if (!hasWebGL()) return fail();
    const points: CityPoint[] = JSON.parse(host.dataset.points || '[]');
    try {
      const { mountHeroGlobe } = await import('@/scripts/hero-globe');
      api = await mountHeroGlobe(host, points, {
        onSelect: (p) => { location.href = `/world?city=${encodeURIComponent(p.city)}`; },
      });
      host.classList.add('is-ready');
      host.querySelector('[data-globe-loading]')?.remove();
    } catch (err) {
      console.error('Globe failed to load', err);
      fail();
    }
  }

  // Load the globe once the hero is visible and the main thread is idle.
  if (host) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        const idle = (window as any).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
        idle(boot);
      }
    });
    io.observe(host);
  }

  // City search: rotate the globe to the city, then offer to open it in Opus World.
  form?.addEventListener('submit', (e) => {
    const q = (form.elements.namedItem('city') as HTMLInputElement).value;
    const c = findCity(q);
    if (!c) return; // Let the form submit to /world, which shows a helpful empty state.
    e.preventDefault();
    if (api) api.flyTo(c.lat, c.lng);
    if (result) {
      result.innerHTML = `<a href="/world?city=${encodeURIComponent(c.name)}">Open ${c.name} in Opus World →</a>`;
    }
    if (!api) location.href = `/world?city=${encodeURIComponent(c.name)}`;
  });
</script>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: max(100svh, 720px); display: flex; align-items: center;
    padding-top: 96px; padding-bottom: 64px;
    background: radial-gradient(80% 60% at 75% 45%, #0d0f13 0%, var(--c-bg) 70%);
  }
  /* Edge-to-edge globe on the right; bleeds off the page edge */
  .hero__globe {
    position: absolute; z-index: 0; top: 50%; right: -18vw;
    width: min(1100px, 82vw); aspect-ratio: 1; transform: translateY(-50%);
    cursor: grab; touch-action: none;
  }
  .hero__globe:active { cursor: grabbing; }
  .hero__globe :global(canvas) { outline: none; }
  .hero__globe { opacity: 0; transition: opacity 1.4s var(--ease); }
  .hero__globe.is-ready, .hero__globe:has([data-globe-fallback]:not([hidden])) { opacity: 1; }
  .hero__globe:has([data-globe-loading]) { opacity: 1; }
  .hero__loading { position: absolute; inset: 12%; display: grid; place-items: center; }
  .hero__loading span { width: 100%; aspect-ratio: 1; border-radius: 50%; border: 1px solid #1c1e23; box-shadow: inset 0 0 120px rgba(180,205,234,.04); animation: breathe 2.4s ease-in-out infinite; }
  @keyframes breathe { 50% { border-color: #2a2d34; } }
  .hero__fallback { position: absolute; inset: 20% 15%; display: flex; flex-direction: column; justify-content: center; gap: 16px; }
  .hero__fallback ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .hero__fallback a { display: inline-flex; gap: 8px; padding: 8px 12px; border: 1px solid var(--c-ink-600); border-radius: var(--r-sm); font-size: 14px; }
  .hero__fallback a span { color: var(--c-fg-faint); }

  /* Keeps type legible where it overlaps the globe */
  .hero__fade { position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg, var(--c-bg) 0%, rgba(5,5,6,.85) 30%, rgba(5,5,6,0) 58%), linear-gradient(0deg, var(--c-bg) 0%, transparent 18%); }

  .hero__inner { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; pointer-events: none; }
  .hero__inner > * { pointer-events: auto; }
  .hero__eyebrow { display: flex; align-items: center; gap: 10px; color: var(--c-fg-muted); }
  .hero__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--c-accent); box-shadow: 0 0 10px var(--c-accent-glow); }
  .hero__title { font-size: clamp(2.75rem, 1rem + 6.2vw, 7.25rem); line-height: 0.92; letter-spacing: -0.06em; font-weight: 500; max-width: 9.5ch; }
  .hero__line { display: block; overflow: hidden; padding-bottom: 0.05em; }
  .hero__line > span { display: inline-block; }
  .hero__lead { max-width: 440px; font-size: var(--t-lead); line-height: 1.5; color: var(--c-fg-subtle); }

  .hsearch { display: flex; align-items: center; gap: 12px; width: min(100%, 460px); height: 56px; padding: 0 6px 0 18px;
    background: rgba(14, 15, 18, 0.8); border: 1px solid var(--c-ink-600); border-radius: var(--r-md); backdrop-filter: blur(12px); color: var(--c-fg-faint);
    transition: border-color var(--dur) var(--ease); }
  .hsearch:focus-within { border-color: var(--c-accent); }
  .hsearch input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: var(--c-white); font-size: 16px; }
  .hsearch input::placeholder { color: #77727a; }
  .hsearch button { height: 44px; padding: 0 18px; border: 0; border-radius: var(--r-sm); background: var(--c-white); color: var(--c-black); font-weight: 500; }
  .hsearch__result { min-height: 14px; margin-top: -12px; color: var(--c-accent); }
  .hsearch__result :global(a:hover) { text-decoration: underline; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  .hero__stats { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 32px; margin: 16px 0 0; padding-top: 20px; border-top: 1px solid var(--c-line); }
  .hero__stats div { display: flex; flex-direction: column-reverse; }
  .hero__stats dt { font-size: 12px; color: var(--c-fg-faint); }
  .hero__stats dd { margin: 0; font-size: 28px; font-weight: 500; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .hero__statnote { width: 100%; color: var(--c-fg-ghost); font-size: 10px; }

  .js .hero-in { opacity: 0; transform: translateY(0.5em); animation: hero-in 1.1s var(--ease) forwards; animation-delay: calc(var(--i) * 80ms + 120ms); }
  .js .hero__line .hero-in { transform: translateY(105%); }
  @keyframes hero-in { to { opacity: 1; transform: none; } }

  :global(.gl-tip) { padding: 8px 10px; background: rgba(10,11,13,.92); border: 1px solid #2a2d34; border-radius: 6px; font: 13px var(--font-sans); color: #fff; display: flex; flex-direction: column; gap: 2px; }
  :global(.gl-tip span) { color: #8e8890; font-size: 12px; }

  @media (max-width: 900px) {
    .hero { flex-direction: column; align-items: stretch; padding-top: 64px; min-height: auto; }
    /* Whole globe visible on phones; vertical swipes scroll the page, sideways swipes turn the globe. */
    .hero__globe { position: relative; top: auto; right: auto; transform: none; width: min(100%, 560px); min-height: 0; overflow: hidden; margin: 0 auto; align-self: center; touch-action: pan-y; }
    .hero__fade { background: linear-gradient(0deg, var(--c-bg) 0%, transparent 22%); }
    .hero__inner { margin-top: -4vw; }
  }
</style>
