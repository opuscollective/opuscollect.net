---
import { CITIES, citySlug } from '@/data/cities';
import Icon from '../ui/Icon.astro';
import { SPECIALTIES } from '@/data/specialties';
import { GENRES } from '@/data/genres';

// Fallback links when WebGL is unavailable. Plain city names only; live counts come from /api/world.
const topCities = CITIES.slice(0, 8);
---
<section class="hero tone-dark" aria-labelledby="hero-title" data-hero>
  <div class="hero__globe" data-hero-globe>
    <div class="hero__loading" data-globe-loading aria-hidden="true"><span></span></div>
  </div>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="container hero__stage" data-hero-stage>
    <h1 id="hero-title" class="hero__title">
      <span class="hero__line"><span class="hero-in" style="--i:1">The future of music</span></span>
      <span class="hero__line"><span class="hero-in" style="--i:2">is independent.</span></span>
    </h1>

    <div class="opus-entry hero-in" style="--i:4">
      <p class="opus-entry__kicker t-meta">Your vision starts here</p>
      <form class="opus-entry__form" action="/world" method="get" role="search" data-hero-search autocomplete="off">
        <label for="opus-q" class="opus-entry__q">What are you trying to accomplish?</label>
        <div class="hsearch">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4.3-4.3"/></svg>
          <input id="opus-q" name="q" type="text" placeholder="A producer in Birmingham, a studio in London…" />
          <button type="submit">Go</button>
        </div>
      </form>
      <!-- Ways in without typing. Each goes to a real page; Charts is still in development and says so. -->
      <ul class="opus-quick" role="list" aria-label="Shortcuts">
        <li><a href="/musicians" data-hero-kind="musician">Find People</a></li>
        <li><a href="/studios" data-hero-kind="studio">Find Studios</a></li>
        <li><a href="/charts">Explore Charts <span class="opus-quick__soon">Soon</span></a></li>
        <li><a href="/music">My Releases</a></li>
      </ul>
      <a class="opus-entry__open" href="/world" data-hero-open><span class="hero__desk">Open World</span><span class="hero__phone">Explore the World</span> <Icon name="arrow-right" size={16} /></a>
      <!-- Phones: a quiet way into the Opus guide, in place of the search box. -->
      <button type="button" class="opus-entry__ask" data-opus-ask>Ask Opus</button>
    </div>

    <!-- Accessible fallback, shown when WebGL is not available -->
    <nav class="hero__fallback" data-globe-fallback hidden aria-label="Browse by city">
      <ul role="list">{topCities.map((c) => <li><a href={`/world/${citySlug(c.name)}`}>{c.name}</a></li>)}</ul>
    </nav>
  </div>

  <!-- Shown while the browser asks for the visitor's location. -->
  <p class="dv-locate" data-locate hidden aria-live="polite"><span class="dv-locate__dot" aria-hidden="true"></span><span data-locate-text>Finding where you are…</span></p>

  <!-- The directory panel, on the left, after the camera moves into the globe. -->
  <div class="dv" data-dive hidden role="dialog" aria-modal="false" aria-labelledby="dv-title">
    <div class="dv__panel">
      <div class="dv__head">
        <h2 id="dv-title" class="sr-only">World directory</h2>
        <form class="dv__search" role="search" data-dive-form autocomplete="off">
          <Icon name="search" size={18} />
          <label for="dv-q" class="sr-only">Search World</label>
          <input id="dv-q" type="search" placeholder="Search a city, a name or a specialty" data-dive-q />
        </form>
        <button type="button" class="dv__close" data-dive-close aria-label="Close and return to the globe"><Icon name="close" size={20} /></button>
      </div>
      <div class="dv__place">
        <p class="dv__here" data-dive-here></p>
        <button type="button" class="dv__me" data-dive-me><Icon name="pin" size={14} /> <span>Near me</span></button>
      </div>
      <div class="dv__row">
        <div class="dv__tabs" role="radiogroup" aria-label="Show">
          <button type="button" role="radio" aria-checked="true" data-kind="">All</button>
          <button type="button" role="radio" aria-checked="false" data-kind="musician">Musicians</button>
          <button type="button" role="radio" aria-checked="false" data-kind="studio">Studios</button>
          <button type="button" role="radio" aria-checked="false" data-kind="organization">Orgs</button>
        </div>
        <button type="button" class="dv__fbtn" data-dive-ftoggle aria-expanded="false" aria-controls="dv-filters">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>
          <span>Filters</span><b data-dive-fcount hidden></b>
        </button>
      </div>
      <div class="dv__filters" id="dv-filters" data-dive-filters hidden>
        <label class="dv__field" data-only="musician"><span>Specialty</span>
          <select data-f="specialty">
            <option value="">Any specialty</option>
            {Object.entries(SPECIALTIES).map(([k, d]) => <option value={k}>{d.plural}</option>)}
          </select>
        </label>
        <label class="dv__field" data-only="musician"><span>Genre</span>
          <select data-f="genre">
            <option value="">Any genre</option>
            {GENRES.map((g) => <option value={g}>{g}</option>)}
          </select>
        </label>
        <label class="dv__field" data-only="studio" hidden><span>Studio type</span>
          <select data-f="studioType">
            <option value="">Any studio</option>
            <option value="commercial">Recording studios</option>
            <option value="home">Home studios</option>
            <option value="remote">Remote services</option>
          </select>
        </label>
        <label class="dv__switch"><input type="checkbox" role="switch" data-f="verifiedOnly" /><span>Opus Verified only</span></label>
        <label class="dv__switch" data-only="musician"><input type="checkbox" role="switch" data-f="openToCollab" /><span>Open to collaborate</span></label>
        <button type="button" class="dv__reset" data-dive-reset>Reset filters</button>
      </div>
      <p class="dv__count t-meta" data-dive-count aria-live="polite"></p>
      <ul class="dv__list" role="list" data-dive-list></ul>
      <a class="dv__all" href="/world" data-dive-all>Open in World <Icon name="arrow-right" size={16} /></a>
    </div>
  </div>
</section>

<script>
  import { CITIES, findCity, citySlug } from '@/data/cities';
  import type { ListingKind } from '@/types/directory';
  type CityPoint = { city: string; country: string; lat: number; lng: number; count: number };
  type DiveQuery = import('@/scripts/hero-dive').DiveQuery;
  type DiveFilters = import('@/scripts/hero-dive').DiveFilters;
  type Near = { lat: number; lng: number };

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const host = hero.querySelector<HTMLElement>('[data-hero-globe]')!;
  const form = hero.querySelector<HTMLFormElement>('[data-hero-search]')!;
  const input = form.querySelector<HTMLInputElement>('input')!;
  const dive = hero.querySelector<HTMLElement>('[data-dive]')!;
  const dq = dive.querySelector<HTMLInputElement>('[data-dive-q]')!;
  const list = dive.querySelector<HTMLElement>('[data-dive-list]')!;
  const count = dive.querySelector<HTMLElement>('[data-dive-count]')!;
  const here = dive.querySelector<HTMLElement>('[data-dive-here]')!;
  const meBtn = dive.querySelector<HTMLButtonElement>('[data-dive-me]')!;
  const all = dive.querySelector<HTMLAnchorElement>('[data-dive-all]')!;
  const tabs = [...dive.querySelectorAll<HTMLButtonElement>('[data-kind]')];
  const fPanel = dive.querySelector<HTMLElement>('[data-dive-filters]')!;
  const fToggle = dive.querySelector<HTMLButtonElement>('[data-dive-ftoggle]')!;
  const fCount = dive.querySelector<HTMLElement>('[data-dive-fcount]')!;
  const fInputs = [...fPanel.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-f]')];
  const locate = hero.querySelector<HTMLElement>('[data-locate]')!;
  const locateText = locate.querySelector<HTMLElement>('[data-locate-text]')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let api: { spin: () => void; flyTo: (lat: number, lng: number) => void; dive: (lat?: number, lng?: number, close?: boolean) => void; here: (lat: number, lng: number) => void; rise: () => void } | null = null;
  let q: DiveQuery = { text: '', kind: '' };
  /** The visitor's position, kept in this page only. Never sent to Opus or stored. */
  let me: Near | null = null;
  let meCity: { city: import('@/data/cities').City; km: number } | undefined;
  /** The visitor said no to location (or the browser has none). */
  let locOff = false;

  const hasWebGL = () => {
    try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; }
  };
  const fail = () => {
    host.querySelector('[data-globe-loading]')?.remove();
    const fb = hero.querySelector<HTMLElement>('[data-globe-fallback]');
    if (fb) fb.hidden = false;
  };

  // Real member counts by city (aggregated to the metro, never exact locations).
  const summary: Promise<CityPoint[]> = fetch('/api/world?summary=1')
    .then((r) => (r.ok ? r.json() : Promise.reject(new Error(`HTTP ${r.status}`))))
    .then((d: { cities: CityPoint[] }) => d.cities)
    .catch((err) => { console.error('Could not load member counts', err); return []; });

  async function boot() {
    if (!hasWebGL()) return fail();
    const points = await summary;
    try {
      const { mountHeroGlobe } = await import('@/scripts/hero-globe');
      api = await mountHeroGlobe(host, points, {
        onSelect: (p) => {
          const c = findCity(p.city);
          const next: DiveQuery = { text: p.city, kind: q.kind, city: c, plain: !!c, filters: q.filters };
          if (hero.classList.contains('is-diving')) { q = next; dq.value = q.text; api?.dive(c?.lat ?? p.lat, c?.lng ?? p.lng, true); render(); }
          else open(next);
        },
      });
      host.classList.add('is-ready');
      host.querySelector('[data-globe-loading]')?.remove();
      // The visitor opened the world before the globe finished loading: catch the camera up.
      if (hero.classList.contains('is-diving')) {
        if (me && (!q.city || q.city === meCity?.city)) api.here(me.lat, me.lng);
        else api.dive(q.city?.lat, q.city?.lng, !!q.city);
      }
    } catch (err) {
      console.error('Globe failed to load', err);
      fail();
    }
  }
  const idle = (window as any).requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
  idle(boot);

  // ---------- Words → query ----------
  const parse = (text: string, kind: ListingKind | '' = ''): DiveQuery => {
    const t = text.trim();
    const exact = t ? findCity(t) : undefined;
    const plain = !!exact && exact.name.toLowerCase().startsWith(t.split(',')[0]!.trim().toLowerCase());
    const named = exact ?? CITIES.find((c) => new RegExp(`\\b${c.name}\\b`, 'i').test(t));
    return { text: t, kind, city: named, plain, filters: q.filters };
  };

  // ---------- Filters (the same ones as the World directory) ----------
  function readFilters(): DiveFilters {
    const f: Record<string, string | boolean> = {};
    for (const el of fInputs) {
      const k = el.dataset.f!;
      if (el instanceof HTMLInputElement && el.type === 'checkbox') { if (el.checked) f[k] = true; }
      else if (el.value && !el.closest<HTMLElement>('[data-only]')?.hidden) f[k] = el.value;
    }
    return f as DiveFilters;
  }
  function syncFilterFields() {
    fPanel.querySelectorAll<HTMLElement>('[data-only]').forEach((el) => {
      el.hidden = !!q.kind && el.dataset.only !== q.kind || (!q.kind && el.dataset.only === 'studio');
    });
  }
  const onFilters = () => { q = { ...q, filters: readFilters() }; render(); };
  fInputs.forEach((el) => el.addEventListener('change', onFilters));
  fToggle.addEventListener('click', () => {
    const open = fPanel.hidden;
    fPanel.hidden = !open;
    fToggle.setAttribute('aria-expanded', String(open));
  });
  dive.querySelector('[data-dive-reset]')?.addEventListener('click', () => {
    fInputs.forEach((el) => { if (el instanceof HTMLInputElement) el.checked = false; else el.value = ''; });
    onFilters();
  });

  // ---------- Results ----------
  async function render() {
    const mod = await import('@/scripts/hero-dive');
    mod.ensureImageFallbacks(dive);
    // The visitor's own position only sorts the list when no other place is in the words.
    const near = me && (!q.city || q.city === meCity?.city) ? me : undefined;
    const query: DiveQuery = { ...q, near };
    all.href = mod.worldHref(near && meCity ? { ...q, city: meCity.city, plain: true } : q);
    tabs.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.kind === q.kind)));
    syncFilterFields();
    const nf = Object.keys(q.filters ?? {}).length;
    fCount.hidden = !nf; fCount.textContent = String(nf);
    here.textContent = near && meCity
      ? (meCity.km < mod.NEAR_KM ? `Near you · ${meCity.city.name}` : 'Near you')
      : q.city ? q.city.name : q.text ? `“${q.text}”` : 'Everywhere';
    meBtn.hidden = !!near;
    count.textContent = 'Loading…';
    try {
      const results = mod.filter(await mod.loadListings(), query);
      if (near) {
        const n = mod.nearCount(results, near);
        count.textContent = n
          ? `${n} within about 100 miles`
          : results.length ? 'No one on Opus near you yet. Here’s who’s closest.' : 'Nothing matches yet.';
      } else {
        const where = q.plain && q.city ? ` in ${q.city.name}` : '';
        count.textContent = locOff && !q.text
          ? 'Location is off, so this is everyone. Search a city to look around.'
          : results.length ? `${results.length} result${results.length === 1 ? '' : 's'}${where}` : `Nothing matches yet${where}.`;
      }
      list.innerHTML = results.slice(0, 30).map((l) => mod.rowHtml(l, mod.worldHref(q, l.id), near)).join('');
      list.scrollTop = 0;
    } catch {
      count.textContent = 'Couldn’t load results.';
      list.innerHTML = '';
    }
  }

  // ---------- Location: ask the browser, then fly to where the visitor is ----------
  function askLocation(): Promise<Near | null> {
    if (!('geolocation' in navigator)) return Promise.resolve(null);
    return new Promise((resolve) => {
      navigator.geolocation.getCurrentPosition(
        (p) => resolve({ lat: p.coords.latitude, lng: p.coords.longitude }),
        () => resolve(null),
        { enableHighAccuracy: false, timeout: 12000, maximumAge: 10 * 60 * 1000 },
      );
    });
  }
  async function findMe(): Promise<boolean> {
    locateText.textContent = 'Finding where you are…';
    locate.hidden = false;
    requestAnimationFrame(() => locate.classList.add('is-on'));
    const pos = await askLocation();
    if (pos) {
      const mod = await import('@/scripts/hero-dive');
      me = pos;
      meCity = mod.nearestCity(CITIES, pos);
      api?.here(pos.lat, pos.lng);
    }
    locate.classList.remove('is-on');
    setTimeout(() => { if (!locate.classList.contains('is-on')) locate.hidden = true; }, 250);
    return !!pos;
  }

  // ---------- The dive: words move past the camera, the globe comes closer, the panel opens ----------
  function showPanel(delay: number) {
    const show = () => {
      dive.hidden = false;
      requestAnimationFrame(() => dive.classList.add('is-open'));
      if (!matchMedia('(pointer: coarse)').matches) dq.focus({ preventScroll: true });
    };
    setTimeout(show, api && !reduce ? delay : 0);
  }
  function enter() {
    if (scrollY > 0) scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    hero.classList.add('is-diving');
  }

  function open(next: DiveQuery) {
    q = next;
    dq.value = q.text;
    enter();
    api?.dive(q.city?.lat, q.city?.lng, !!q.city);
    render();
    showPanel(750);
  }

  /** "Open World": zoom in, ask where the visitor is, fly there, then open the directory. */
  /** "Open World" and the Find People / Find Studios shortcuts: zoom in, ask where the visitor is, fly there, open the directory. */
  async function openWorld(kind: ListingKind | '' = q.kind) {
    q = { text: '', kind, filters: q.filters };
    dq.value = '';
    enter();
    api?.dive();
    const found = me ? (api?.here(me.lat, me.lng), true) : await findMe();
    locOff = !found;
    render();
    showPanel(found ? 900 : 300);
  }

  function close() {
    dive.classList.remove('is-open');
    hero.classList.remove('is-diving');
    api?.rise();
    setTimeout(() => { dive.hidden = true; }, reduce ? 0 : 300);
    // Phones have no search box in the hero: return focus to the way in instead.
    (input.offsetParent ? input : hero.querySelector<HTMLElement>('[data-hero-open]'))?.focus({ preventScroll: true });
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    open(parse(input.value));
  });
  hero.querySelector<HTMLAnchorElement>('[data-hero-open]')?.addEventListener('click', (e) => {
    if (e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    // Phones: the camera dives into this globe, asks where you are, flies to your part of the world,
    // then hands over to the full World map at that spot. Without location, the whole world keeps turning.
    if (matchMedia('(max-width: 760px)').matches) { exploreFromHere(); return; }
    openWorld('');
  });
  let exploring = false;
  async function exploreFromHere() {
    if (exploring) return;
    exploring = true;
    const go = (href: string) => { location.href = href; };
    if (!api) return go('/world?view=map');
    hero.classList.add('is-diving', 'is-leaving');
    api.dive();
    const found = me ? (api.here(me.lat, me.lng), true) : await findMe();
    if (found && meCity) {
      // Let the camera arrive over the visitor's area before World opens there.
      const near = meCity.km < 300;
      showLocate(near ? `Taking you to ${meCity.city.name}` : 'Taking you to World');
      setTimeout(() => go(near ? `/world/${citySlug(meCity!.city.name)}?view=map` : '/world?view=map'), reduce ? 0 : 1900);
    } else {
      api.spin();
      showLocate('Opening the whole world');
      setTimeout(() => go('/world?view=map'), reduce ? 0 : 1500);
    }
  }
  function showLocate(text: string) {
    locateText.textContent = text;
    locate.hidden = false;
    requestAnimationFrame(() => locate.classList.add('is-on'));
  }

  // Coming back with the back button restores this page from cache: undo the dive.
  addEventListener('pageshow', (e) => {
    if (!e.persisted || !hero.classList.contains('is-leaving')) return;
    exploring = false;
    hero.classList.remove('is-diving', 'is-leaving');
    locate.classList.remove('is-on'); locate.hidden = true;
    api?.rise();
  });
  // Without the globe (no WebGL) these stay plain links to /musicians and /studios.
  hero.querySelectorAll<HTMLAnchorElement>('[data-hero-kind]').forEach((a) => a.addEventListener('click', (e) => {
    if (!api || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    openWorld(a.dataset.heroKind as ListingKind);
  }));
  meBtn.addEventListener('click', async () => {
    const found = me ? (api?.here(me.lat, me.lng), true) : await findMe();
    if (found) { locOff = false; q = { text: '', kind: q.kind, filters: q.filters }; dq.value = ''; render(); }
    else count.textContent = 'Your browser didn’t share your location. You can turn it on in the site settings.';
  });
  dive.querySelector('[data-dive-form]')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const next = parse(dq.value, q.kind);
    if (next.city && next.city !== q.city) api?.dive(next.city.lat, next.city.lng, true);
    q = next;
    render();
  });
  let typing: ReturnType<typeof setTimeout>;
  dq.addEventListener('input', () => {
    clearTimeout(typing);
    typing = setTimeout(() => {
      const next = parse(dq.value, q.kind);
      if (next.plain && next.city && next.city !== q.city) api?.dive(next.city.lat, next.city.lng, true);
      q = next;
      render();
    }, 220);
  });
  tabs.forEach((b) => b.addEventListener('click', () => {
    q = { ...q, kind: (b.dataset.kind ?? '') as ListingKind | '' };
    syncFilterFields();
    q.filters = readFilters();
    render();
  }));
  dive.querySelector('[data-dive-close]')?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && hero.classList.contains('is-diving')) close(); });
</script>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: max(100svh, 680px); display: flex; align-items: center; justify-content: center;
    padding-block: 96px 64px; background: var(--bg);
  }
  /* Faint stars behind the Earth. Three tiled layers at different sizes so no pattern shows. */
  .hero::before { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0.9;
    background-image:
      radial-gradient(1px 1px at 23px 41px, rgba(255,255,255,.8) 50%, transparent 51%),
      radial-gradient(1px 1px at 157px 97px, rgba(255,255,255,.55) 50%, transparent 51%),
      radial-gradient(1.4px 1.4px at 91px 173px, rgba(220,232,255,.9) 50%, transparent 51%),
      radial-gradient(1px 1px at 211px 13px, rgba(255,255,255,.45) 50%, transparent 51%),
      radial-gradient(1px 1px at 67px 229px, rgba(255,255,255,.6) 50%, transparent 51%),
      radial-gradient(1.2px 1.2px at 301px 151px, rgba(255,255,255,.7) 50%, transparent 51%);
    background-size: 140px 160px, 230px 190px, 310px 270px, 170px 210px, 260px 150px, 420px 370px; }
  /* The globe fills the hero, behind the words. */
  .hero__globe { position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0; transition: opacity 1.4s var(--ease); }
  /* Only inside World can you turn and zoom the globe; on the homepage it just spins. */
  .hero.is-diving .hero__globe { cursor: grab; }
  .hero.is-diving .hero__globe:active { cursor: grabbing; }
  .hero__globe :global(canvas) { outline: none; }
  .hero__globe.is-ready, .hero__globe:has([data-globe-loading]) { opacity: 1; }
  .hero__loading { position: absolute; inset: 0; display: grid; place-items: center; }
  .hero__loading span { width: min(68vh, 90vw); aspect-ratio: 1; border-radius: 50%; border: 1px solid var(--line); animation: breathe 2.4s ease-in-out infinite; }
  @keyframes breathe { 50% { border-color: var(--line-strong); } }
  /* A soft pool of darkness behind the words keeps them legible over the globe. */
  .hero__veil { position: absolute; inset: 0; z-index: 1; pointer-events: none; transition: opacity 1s var(--ease);
    background: radial-gradient(50% 42% at 50% 50%, color-mix(in srgb, var(--bg) 78%, transparent) 0%, color-mix(in srgb, var(--bg) 40%, transparent) 60%, transparent 100%), linear-gradient(0deg, var(--bg) 0%, transparent 16%); }

  .hero__stage { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 36px; pointer-events: none;
    transition: transform 0.9s cubic-bezier(.5, 0, .2, 1), opacity 0.7s var(--ease), filter 0.9s var(--ease); }
  .hero__stage > * { pointer-events: auto; }
  .hero__title { font-size: clamp(2.6rem, 1rem + 5.6vw, 6.75rem); line-height: 0.95; letter-spacing: -0.06em; font-weight: 500; }
