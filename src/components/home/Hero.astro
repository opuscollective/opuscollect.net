---
import Button from '../ui/Button.astro';
import { SITE } from '@/data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <img src="/images/scenic-room.jpg" alt="" width="1600" height="2400" fetchpriority="high" decoding="async" />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="container hero__inner">
    <p class="hero__eyebrow t-meta hero-in" style="--i:0">
      <span>Opus Collective</span><span class="hero__rule" aria-hidden="true"></span><span>{SITE.motto}</span>
    </p>
    <h1 id="hero-title" class="hero__title">
      <span class="hero__line"><span class="hero-in" style="--i:1">The future</span></span>
      <span class="hero__line"><span class="hero-in" style="--i:2">of music is</span></span>
      <span class="hero__line"><span class="hero-in" style="--i:3"><em>independent.</em></span></span>
    </h1>
    <div class="hero__foot">
      <p class="hero__lead hero-in" style="--i:4">
        Discover the artists, producers, engineers, and visionaries shaping what’s next.
      </p>
      <div class="hero__ctas hero-in" style="--i:5">
        <Button href="/directory" size="lg" arrow="right">Explore the Directory</Button>
        <Button href="/join.html" variant="secondary" size="lg">Join Opus</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: 100svh; display: flex; align-items: flex-end;
    padding-top: 120px; padding-bottom: clamp(48px, 7vw, 96px);
  }
  .hero__media { position: absolute; inset: 0; z-index: -2; }
  .hero__media img {
    width: 100%; height: 100%; object-fit: cover; object-position: 30% 40%;
    filter: grayscale(1) contrast(1.1) brightness(0.62);
    transform: scale(1.06); animation: hero-settle 2.4s var(--ease) forwards;
  }
  .hero__shade {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgba(0,0,0,.65) 0%, rgba(0,0,0,.1) 30%, rgba(0,0,0,.35) 60%, #000 100%),
      linear-gradient(90deg, rgba(0,0,0,.6) 0%, rgba(0,0,0,0) 60%);
  }
  .hero__inner { display: flex; flex-direction: column; gap: clamp(24px, 3vw, 40px); }
  .hero__eyebrow { display: flex; align-items: center; gap: 16px; color: var(--c-fg-muted); flex-wrap: wrap; }
  .hero__rule { width: 48px; height: 1px; background: rgba(255,255,255,.4); }
  .hero__title {
    font-size: clamp(2.6rem, 0.6rem + 8.4vw, 9.5rem); line-height: 0.92; letter-spacing: -0.06em;
    font-weight: 500; text-transform: uppercase; max-width: 14ch;
  }
  .hero__title em { font-style: normal; color: transparent; -webkit-text-stroke: 1.5px var(--c-white); }
  @supports not (-webkit-text-stroke: 1px white) { .hero__title em { color: var(--c-fg-faint); } }
  .hero__line { display: block; overflow: hidden; padding-bottom: 0.04em; }
  .hero__line > span { display: inline-block; }
  .hero__foot { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 28px 48px; padding-top: clamp(8px, 1.5vw, 20px); border-top: 1px solid rgba(255,255,255,.16); padding-top: 28px; }
  .hero__lead { max-width: 440px; font-size: var(--t-lead); line-height: 1.5; color: #d9d5da; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  /* Entrance */
  .js .hero-in { opacity: 0; transform: translateY(0.5em); animation: hero-in 1.1s var(--ease) forwards; animation-delay: calc(var(--i) * 90ms + 150ms); }
  .js .hero__line .hero-in { transform: translateY(105%); }
  @keyframes hero-in { to { opacity: 1; transform: none; } }
  @keyframes hero-settle { to { transform: scale(1); } }

  @media (max-width: 640px) {
    .hero { min-height: 92svh; }
    .hero__media img { object-position: 22% 40%; }
    .hero__ctas { width: 100%; }
    .hero__ctas :global(.btn) { flex: 1 1 100%; }
    .hero__title em { -webkit-text-stroke-width: 1px; }
    .hero__eyebrow > span:not(:last-child) { display: none; }
  }
</style>
