---
import Button from '../ui/Button.astro';
---
<section class="section join" aria-labelledby="join-title">
  <div class="container">
    <div class="join__panel" data-reveal>
      <p class="t-meta join__kicker">Don’t create in isolation.</p>
      <h2 id="join-title" class="join__title">Claim your place in the directory.</h2>
      <div class="join__foot">
        <p>Build your profile, show your work, get discovered.</p>
        <div class="join__ctas">
          <Button href="/sign-up" variant="inverse" size="lg" arrow="right">Join Opus</Button>
          <a class="join__alt" href="https://discord.gg/QudUMNB5yP" target="_blank" rel="noopener">Join the Discord ↗</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .join__panel {
    background: var(--c-white); color: var(--c-black); border-radius: var(--r-lg);
    padding: clamp(36px, 7vw, 112px); display: flex; flex-direction: column; gap: clamp(24px, 3vw, 40px);
  }
  .join__kicker { color: color-mix(in srgb, var(--c-black) 58%, var(--c-white)); }
  .join__title { max-width: 11ch; font-size: clamp(2.6rem, 1rem + 6.4vw, 8rem); line-height: 0.92; letter-spacing: -0.06em; font-weight: 500; }
  .join__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 28px 48px; padding-top: 28px; border-top: 1px solid color-mix(in srgb, var(--c-black) 16%, var(--c-white)); }
  .join__foot p { max-width: 520px; font-size: var(--t-lead); line-height: 1.55; color: color-mix(in srgb, var(--c-black) 74%, var(--c-white)); }
  .join__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; }
  .join__alt { font-size: 15px; font-weight: 500; min-height: 44px; display: inline-flex; align-items: center; }
  .join__alt:hover { text-decoration: underline; text-underline-offset: 6px; }
  .join :focus-visible { outline-color: var(--c-black); }
</style>
