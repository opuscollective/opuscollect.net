---
import Button from '../ui/Button.astro';
---
<section class="section join" aria-labelledby="join-title">
  <div class="container join__inner">
    <h2 id="join-title" class="join__title" data-reveal>Claim your place<br /><span class="dim">in Opus World.</span></h2>
    <div data-reveal style="--d:.06s"><Button href="/sign-up" variant="primary" size="lg" arrow="right">Join Opus</Button></div>
  </div>
</section>

<style>
  .join__inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px 48px; padding-top: clamp(40px, 5vw, 72px); border-top: 1px solid var(--line); }
  .join__title { font-size: clamp(2.5rem, 1rem + 4.6vw, 5.75rem); line-height: 0.95; letter-spacing: -0.055em; font-weight: 500; }
</style>
