---
/**
 * Works landing: one Opus Profile preview (the résumé section visible) that Works feeds. Entirely an EXAMPLE:
 * the member, photo, releases and credits are illustrative and labeled. No real artist is the face of Works, and the
 * artwork is drawn (gradients), not a real record. Selecting a release shows its details and credits; no autoplay.
 */
interface Credit { role: string; status: string; tag: string }
interface Rel { id: string; title: string; kind: string; date: string; art: string; credits: Credit[]; note: string }
const REL: Rel[] = [
  { id: 'a', title: 'Night Drive', kind: 'EP', date: 'Example · 2026', art: 'linear-gradient(150deg,#e8a15b 0%,#b5476b 48%,#2b1d3f 100%)', note: 'Added once in Works. It now sits in this résumé.',
    credits: [{ role: 'Producer', status: 'Self-reported', tag: '' }, { role: 'Mixing Engineer', status: 'Confirmed', tag: ' px-tag--confirmed' }, { role: 'Songwriter', status: 'Awaiting confirmation', tag: ' px-tag--pending' }] },
  { id: 'b', title: 'Slow Burn', kind: 'Single', date: 'Example · 2025', art: 'linear-gradient(160deg,#6aa0d8 0%,#33507f 55%,#101827 100%)', note: 'A single you mixed for another artist.',
    credits: [{ role: 'Mixing Engineer', status: 'Confirmed', tag: ' px-tag--confirmed' }, { role: 'Mastering', status: 'Not on Opus', tag: '' }] },
  { id: 'c', title: 'Open Water', kind: 'Album', date: 'Example · 2024', art: 'linear-gradient(145deg,#8fc7b0 0%,#3d7a6a 50%,#122a28 100%)', note: 'Credits appear on your résumé only when the person credited confirms.',
    credits: [{ role: 'Co-producer', status: 'Confirmed', tag: ' px-tag--confirmed' }, { role: 'Songwriter', status: 'Self-reported', tag: '' }] },
];
const [main, ...rest] = REL;
---
<div class="wp" data-wp role="group" aria-label="Example Opus Profile with a résumé section">
  <div class="wp__glow" aria-hidden="true"></div>
  <div class="wp__card">
    <span class="px-tag px-tag--example wp__ex">Example profile</span>
    <header class="wp__id">
      <span class="wp__ph"><img src="/images/placeholders/producer.jpg" alt="Placeholder photo" width="120" height="120" loading="eager" decoding="async" /></span>
      <div>
        <h2>Avery Example</h2>
        <p>Producer · Mixing Engineer · Birmingham, AL</p>
      </div>
    </header>
    <nav class="wp__tabs" aria-label="Profile sections"><span>Overview</span><span class="is-on" aria-current="true">Résumé</span><span>Releases</span><span>Connections</span></nav>

    <div class="wp__body">
      <div class="wp__works" role="group" aria-label="Selected works">
        <button type="button" class="wp__rel wp__rel--main is-on" data-wp-pick="a" aria-pressed="true">
          <span class="wp__art" style={`background:${main!.art}`}><i>{main!.title}</i></span>
          <span class="wp__meta"><b>{main!.title}</b><small>{main!.kind} · {main!.date}</small></span>
        </button>
        <div class="wp__more">
          {rest.map((r) => (
            <button type="button" class="wp__rel" data-wp-pick={r.id} aria-pressed="false">
              <span class="wp__art" style={`background:${r.art}`}><i>{r.title}</i></span>
              <span class="wp__meta"><b>{r.title}</b><small>{r.kind} · {r.date}</small></span>
            </button>
          ))}
        </div>
      </div>

      <div class="wp__detail" aria-live="polite">
        {REL.map((r, i) => (
          <section class="wp__panel" data-wp-panel={r.id} hidden={i !== 0}>
            <p class="wp__label">Credits on {r.title}</p>
            <ul role="list">
              {r.credits.map((c) => <li><b>{c.role}</b><span class={`px-tag${c.tag}`}>{c.status}</span></li>)}
            </ul>
            <p class="wp__note">{r.note}</p>
          </section>
        ))}
      </div>
    </div>
    <footer class="wp__feed"><svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 10h12m-4-4 4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg><span><b>Works</b> adds every release and credit to this résumé. Nothing is entered twice.</span></footer>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-wp]').forEach((root) => {
    const picks = root.querySelectorAll<HTMLButtonElement>('[data-wp-pick]');
    const panels = root.querySelectorAll<HTMLElement>('[data-wp-panel]');
    picks.forEach((b) => b.addEventListener('click', () => {
      picks.forEach((x) => { const on = x === b; x.classList.toggle('is-on', on); x.setAttribute('aria-pressed', String(on)); });
      panels.forEach((p) => { p.hidden = p.dataset.wpPanel !== b.dataset.wpPick; });
    }));
  });
</script>

<style>
  .wp { position: relative; isolation: isolate; }
  .wp__glow { position: absolute; z-index: -1; inset: -14% -10%; background: radial-gradient(60% 55% at 70% 30%, rgba(232,161,91,0.30), transparent 70%), radial-gradient(50% 50% at 25% 80%, rgba(181,71,107,0.22), transparent 70%); filter: blur(30px); pointer-events: none; }
  :global(:root[data-theme='light']) .wp__glow { opacity: 0.55; }
  .wp__card { position: relative; display: grid; gap: 20px; padding: clamp(20px, 2.6vw, 34px); border-radius: 18px; background: var(--surface); box-shadow: var(--ds-elev-3); }
  .wp__ex { position: absolute; top: 16px; right: 16px; }
  .wp__id { display: flex; align-items: center; gap: 16px; padding-right: 110px; }
  .wp__ph { width: 64px; height: 64px; border-radius: 50%; overflow: hidden; flex: none; box-shadow: 0 0 0 3px var(--surface), 0 0 0 4px var(--line); }
  .wp__ph img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.2); }
  .wp__id h2 { margin: 0; font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.75rem); font-weight: 600; letter-spacing: -0.03em; }
  .wp__id p { margin: 2px 0 0; font-size: 13.5px; color: var(--text-3); }
  .wp__tabs { display: flex; gap: 22px; font-size: 13.5px; color: var(--text-3); box-shadow: 0 1px 0 var(--line-faint); overflow-x: auto; }
  .wp__tabs span { padding: 0 0 12px; white-space: nowrap; }
  .wp__tabs .is-on { color: var(--text); box-shadow: 0 2px 0 var(--text); }
  .wp__body { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(18px, 2.6vw, 34px); align-items: start; }
  .wp__works { display: grid; gap: 14px; }
  .wp__more { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .wp__rel { all: unset; box-sizing: border-box; display: grid; gap: 10px; cursor: pointer; border-radius: 10px; transition: transform var(--m-card) var(--ds-ease); }
  .wp__rel:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .wp__art { position: relative; display: block; aspect-ratio: 1; border-radius: 4px; overflow: hidden; box-shadow: 0 22px 40px -26px rgba(0,0,0,.7); transition: box-shadow var(--m-card), transform var(--m-card) var(--ds-ease); }
  .wp__art i { position: absolute; left: 10px; bottom: 8px; font: 600 11px/1 var(--font-sans); font-style: normal; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.85); }
  .wp__rel--main .wp__art { aspect-ratio: 16 / 10; }
  .wp__rel--main .wp__art i { font-size: 13px; left: 14px; bottom: 12px; }
  .wp__meta { display: grid; gap: 1px; }
  .wp__meta b { font-size: 14.5px; font-weight: 600; letter-spacing: -0.01em; color: var(--text); }
  .wp__meta small { font-size: 12.5px; color: var(--text-3); }
  .wp__rel:not(.is-on) { opacity: .72; }
  .wp__rel.is-on .wp__art { box-shadow: 0 0 0 2px var(--text), 0 22px 40px -26px rgba(0,0,0,.7); }
  @media (hover: hover) { .wp__rel:hover { opacity: 1; transform: translateY(-2px); } }
  .wp__detail { min-height: 160px; }
  .wp__panel { animation: wp-in var(--m-card) var(--ds-ease); }
  @keyframes wp-in { from { opacity: 0; transform: translateY(6px); } }
  .wp__label { margin: 0 0 6px; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--text-3); }
  .wp__panel ul { margin: 0; padding: 0; list-style: none; }
  .wp__panel li { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 0; font-size: clamp(1.05rem, .95rem + .5vw, 1.3rem); font-weight: 300; letter-spacing: -0.02em; box-shadow: 0 -1px 0 var(--line-faint); }
  .wp__panel li:first-child { box-shadow: none; }
  .wp__panel li b { font-weight: 300; }
  .wp__note { margin: 10px 0 0; font-size: 13px; line-height: 1.5; color: var(--text-3); max-width: 36ch; }
  .wp__feed { display: flex; align-items: center; gap: 10px; padding-top: 16px; font-size: 13px; color: var(--text-2); box-shadow: 0 -1px 0 var(--line-faint); }
  .wp__feed b { font-weight: 600; color: var(--text); }
  @media (max-width: 700px) { .wp__body { grid-template-columns: 1fr; } .wp__id { padding-right: 0; padding-top: 22px; } }
  @media (prefers-reduced-motion: reduce) { .wp__panel { animation: none; } }
</style>
