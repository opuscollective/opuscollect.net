---
/**
 * DirectoryViewSwitcher: Map, Split, List. A radio group (arrow keys move between options).
 * Phones show Map and List only; Split needs a wide screen.
 */
const VIEWS = [
  { v: 'map', label: 'Map', icon: '<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2zM9 4v14M15 6v14"/>' },
  { v: 'split', label: 'Split', icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M14 4v16"/>' },
  { v: 'list', label: 'List', icon: '<path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/>' },
];
---
<div class="vs" role="radiogroup" aria-label="View" data-views>
  {VIEWS.map((x) => (
    <button type="button" role="radio" aria-checked="false" tabindex="-1" data-view-btn={x.v} class={`vs__b vs__b--${x.v}`} title={`${x.label} view`}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={x.icon} />
      <span>{x.label}</span>
    </button>
  ))}
</div>
