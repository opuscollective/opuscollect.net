---
import { HEADER_NAV, ACCOUNT, ACCOUNT_MENU, SITE } from '@/data/site';
import Icon from '../ui/Icon.astro';
import ThemeSwitch from '../ui/ThemeSwitch.astro';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// Which pages light up each nav item.
const SECTIONS: Record<string, string[]> = {
  '/world': ['/world', '/musicians', '/organizations', '/m/', '/verified'],
  '/works': ['/works', '/music', '/r/', '/start'],
  '/studios': ['/studios', '/business', '/bookings', '/account/bookings'],
  '/venues': ['/venues'],
  '/events': ['/events', '/summit'],
  '/airplay': ['/airplay'],
  '/future': ['/future'],
  '/charts': ['/charts'],
  '/network': ['/network', '/account/connections'],
  '/collective': ['/collective', '/community', '/about'],
};
const current = (href: string) => (SECTIONS[href] ?? [href]).some((p) => path === p || path.startsWith(p.endsWith('/') ? p : p + '/'));
// On narrower desktops these move into "More" instead of shrinking the type.
const OVERFLOW = new Set<string>();
---
<script is:inline>
  // Signed-in hint (not a credential): swap Sign in / Join for the account menu.
  if (document.cookie.split('; ').indexOf('opus_in=1') > -1) document.documentElement.classList.add('is-signed-in');
</script>
<header class:list={['hdr', { 'hdr--overlay': overlay, 'tone-dark': overlay }]} data-header data-overlay={overlay ? '' : undefined}>
  <div class="container hdr__inner">
    <a href="/" class="hdr__brand" aria-label={`${SITE.product} home`}>
      <img class="logo" src="/images/oc-logo.png" alt="" width="34" height="22" />
    </a>

    <nav class="hdr__nav" aria-label="Main">
      <ul role="list" class="hdr__list">
        {HEADER_NAV().map((item, i) => (
          <li class:list={['hdr__item', { 'hdr__item--more': OVERFLOW.has(item.label) }]} data-nav-item>
            <a class="hdr__link" href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>
            <button class="hdr__disc" type="button" aria-expanded="false" aria-controls={`nav-${i}`} data-nav-disc><span class="sr-only">{item.label} menu</span><Icon name="chevron-down" size={12} /></button>
            <div class="navp" id={`nav-${i}`} data-nav-panel hidden>
              <div class:list={['navp__card', { 'navp__card--wide': item.groups.length > 1 }]}>
                <div class="navp__head">
                  <p class="navp__name">{item.label}{item.soon && <span class="navp__soon">Coming soon</span>}</p>
                  <p class="navp__line">{item.line}</p>
                </div>
                <div class="navp__groups">
                  {item.groups.map((g) => (
                    <div class="navp__group">
                      {g.title && <p class="navp__title">{g.title}</p>}
                      <ul role="list">
                        {g.links.map((l) => (
                          <li><a href={l.href} data-open-messages={l.messages ? 'private' : undefined} data-auth-only={l.count || l.messages ? '' : undefined}>
                            <span>{l.label}</span>{l.count && <span class="hdr__count" data-req-count hidden></span>}
                          </a></li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__actions">
      <ThemeSwitch variant="icon" />
      <a href={ACCOUNT.signIn.href} class="hdr__signin" data-auth-out>{ACCOUNT.signIn.label}</a>
      <a href={ACCOUNT.join.href} class="hdr__join" data-auth-out>{ACCOUNT.join.label}</a>

      <div class="hdr__social" data-auth-in hidden>
        <a class="hdr__ico" href="/network?messages=1" data-open-messages="private" aria-label="Messages">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.5-4.6A8 8 0 1 1 21 12z"/></svg>
          <b class="hdr__badge" data-hdr-msg hidden></b>
        </a>
        <a class="hdr__ico" href="/network?tab=received" aria-label="Connection requests">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.9-3.4 3.4-5.2 6.5-5.2s5.6 1.8 6.5 5.2M18 8v6M15 11h6"/></svg>
          <b class="hdr__badge" data-hdr-req hidden></b>
        </a>
      </div>

      <div class="acct" data-auth-in hidden>
        <button class="acct__btn" type="button" aria-expanded="false" aria-controls="acct-menu" aria-haspopup="true" data-acct-toggle>
          <Icon name="user" size={18} /><span class="sr-only">Account menu</span><Icon name="chevron-down" size={14} class="acct__chev" />
        </button>
        <div class="acct__menu" id="acct-menu" hidden data-acct-menu>
          <ul role="list">
            {ACCOUNT_MENU.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
          <button type="button" class="acct__out" data-logout>Sign out</button>
        </div>
      </div>

      <button class="hdr__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="sr-only">Menu</span>
        <Icon name="menu" size={22} class="hdr__icon-open" />
        <Icon name="close" size={22} class="hdr__icon-close" />
      </button>
    </div>
  </div>

  <div class="mmenu" id="mobile-menu" hidden data-menu>
    <nav class="container" aria-label="Mobile">
      <ul role="list" class="mmenu__list">
        {HEADER_NAV().map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
              <span class="mmenu__name">{item.label}{item.soon && <span class="mmenu__soon">Soon</span>}{item.label === 'Network' && <span class="hdr__count" data-req-count hidden></span>}</span>
              <span class="mmenu__line">{item.line}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mmenu__actions">
        <ul role="list" class="mmenu__acct" data-auth-in hidden>
          {ACCOUNT_MENU.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><button type="button" data-logout>Sign out</button></li>
        </ul>
        <a href={ACCOUNT.signIn.href} class="mmenu__signin" data-auth-out>{ACCOUNT.signIn.label}</a>
        <div class="mmenu__theme"><span class="t-meta">Theme</span><ThemeSwitch variant="segmented" /></div>
      </div>
    </nav>
  </div>
</header>
<div class="nav-scrim" data-nav-scrim aria-hidden="true"></div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const overlay = header?.hasAttribute('data-overlay') ?? false;
  // On the homepage the header floats over the dark globe hero. It stays dark (clear, then dark glass)
  // for as long as the hero is behind it, and only takes the page's own colour once the hero has scrolled away.
  const hero = overlay ? document.querySelector<HTMLElement>('.hero') : null;
  const overHero = () => !!hero && hero.getBoundingClientRect().bottom > (header?.offsetHeight ?? 72);
  const tone = () => header?.classList.toggle('tone-dark', overlay && overHero() && !header.classList.contains('is-open'));
  if (header) {
    const onScroll = () => { header.classList.toggle('is-solid', window.scrollY > 24); tone(); };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
  if (toggle && menu && header) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
      tone();
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) menu.hidden = false;
      else setTimeout(() => { if (toggle.getAttribute('aria-expanded') === 'false') menu.hidden = true; }, 300);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && header.classList.contains('is-open')) { set(false); toggle.focus(); } });
    window.matchMedia('(min-width: 961px)').addEventListener('change', (e) => { if (e.matches) set(false); });
  }

  /*
   * Product panels. One controller for all of them, in JavaScript rather than CSS :hover, so the panel
   * never drops while the pointer travels into it:
   * - the trigger and its panel are one region (the panel sits inside the item, joined by an invisible bridge);
   * - leaving the region closes after a short delay, and re-entering cancels it;
   * - moving to a neighbouring item switches panels at once, without closing in between;
   * - click outside, Escape, or tabbing away closes; the chevron button opens it from the keyboard.
   * While a panel is open the page behind recedes (blur and dim); the header and panel stay sharp.
   */
  const items = [...document.querySelectorAll<HTMLElement>('[data-nav-item]')];
  const scrim = document.querySelector<HTMLElement>('[data-nav-scrim]');
  let openItem: HTMLElement | null = null;
  let openTimer = 0, closeTimer = 0;
  const panelOf = (li: HTMLElement) => li.querySelector<HTMLElement>('[data-nav-panel]')!;
  const discOf = (li: HTMLElement) => li.querySelector<HTMLButtonElement>('[data-nav-disc]')!;
  const desktop = () => window.matchMedia('(min-width: 961px)').matches;

  function place(li: HTMLElement) {
    // Keep the card on screen: start under the item, shift left if it would overflow the right edge.
    const card = panelOf(li).firstElementChild as HTMLElement;
    card.style.transform = '';
    const r = card.getBoundingClientRect();
    const over = r.right - (window.innerWidth - 16);
    if (over > 0) card.style.transform = `translateX(${-over}px)`;
  }
  function show(li: HTMLElement | null, focusFirst = false) {
    window.clearTimeout(closeTimer); window.clearTimeout(openTimer);
    if (openItem === li) { if (focusFirst && li) panelOf(li).querySelector('a')?.focus(); return; }
    const switching = !!openItem && !!li;
    if (openItem) {
      const prev = openItem;
      prev.classList.remove('is-open'); discOf(prev).setAttribute('aria-expanded', 'false');
      const pp = panelOf(prev);
      if (switching) pp.hidden = true; else window.setTimeout(() => { if (!prev.classList.contains('is-open')) pp.hidden = true; }, 220);
    }
    openItem = li;
    header?.classList.toggle('has-panel', !!li);
    scrim?.classList.toggle('is-on', !!li);
    if (!li) return;
    const p = panelOf(li);
    p.hidden = false;
    place(li);
    li.classList.toggle('is-switch', switching);
    requestAnimationFrame(() => li.classList.add('is-open'));
    discOf(li).setAttribute('aria-expanded', 'true');
    if (focusFirst) requestAnimationFrame(() => p.querySelector('a')?.focus());
  }
  const closeSoon = (ms = 180) => { window.clearTimeout(openTimer); window.clearTimeout(closeTimer); closeTimer = window.setTimeout(() => show(null), ms); };

  items.forEach((li) => {
    li.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || !desktop()) return;
      window.clearTimeout(closeTimer);
      if (openItem) { show(li); return; }
      // A short pause, so sweeping across the bar doesn't flash panels.
      window.clearTimeout(openTimer);
      openTimer = window.setTimeout(() => show(li), 90);
    });
    li.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') closeSoon(); });
    const link = li.querySelector<HTMLAnchorElement>('.hdr__link')!;
    // Touch on a wide screen: the first tap opens the panel, a second tap follows the link.
    link.addEventListener('click', (e) => {
      if (!desktop() || openItem === li) return;
      if ((e as PointerEvent).pointerType === 'touch' || (e as PointerEvent).pointerType === 'pen') { e.preventDefault(); show(li); }
    });
    link.addEventListener('keydown', (e) => { if (e.key === 'ArrowDown') { e.preventDefault(); show(li, true); } });
    discOf(li).addEventListener('click', () => (openItem === li ? show(null) : show(li, true)));
    li.addEventListener('focusout', (e) => { if (openItem === li && !li.contains(e.relatedTarget as Node)) closeSoon(0); });
    panelOf(li).addEventListener('keydown', (e) => {
      const links = [...panelOf(li).querySelectorAll<HTMLAnchorElement>('a')].filter((a) => a.offsetParent);
      const at = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); links[(at + (e.key === 'ArrowDown' ? 1 : links.length - 1)) % links.length]?.focus(); }
    });
    // Following a link closes the panel straight away (and the Messages link opens the panel instead of a page).
    panelOf(li).addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) show(null); });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !openItem) return;
    const li = openItem; show(null); li.querySelector<HTMLAnchorElement>('.hdr__link')?.focus();
  });
  // Outside the header the page sits under the scrim, so a click there only closes the menu; it never
  // reaches the link or button underneath. Inside the header (logo, account) it closes and carries on.
  document.addEventListener('pointerdown', (e) => { if (openItem && e.target !== scrim && !openItem.contains(e.target as Node)) show(null); });
  scrim?.addEventListener('click', (e) => { e.preventDefault(); show(null); });
  scrim?.addEventListener('pointerenter', (e) => { if (openItem && e.pointerType === 'mouse') closeSoon(); });
  window.addEventListener('resize', () => { if (openItem) { if (desktop()) place(openItem); else show(null); } });
  document.addEventListener('astro:before-swap', () => show(null));

  // Pending connection requests: one real count, shown on Network.
  if (document.documentElement.classList.contains('is-signed-in')) {
    fetch('/api/messages/unread').then((r) => (r.ok ? r.json() : null)).then((d: { requests?: number } | null) => {
      const n = d?.requests ?? 0;
      document.querySelectorAll<HTMLElement>('[data-req-count]').forEach((el) => {
        el.textContent = n > 9 ? '9+' : String(n); el.hidden = n === 0;
        el.setAttribute('aria-label', `${n} pending connection ${n === 1 ? 'request' : 'requests'}`);
      });
    }).catch(() => {});
  }

  // Account menu (signed in)
  const acctBtn = document.querySelector<HTMLButtonElement>('[data-acct-toggle]');
  const acctMenu = document.querySelector<HTMLElement>('[data-acct-menu]');
  if (acctBtn && acctMenu) {
    const open = (on: boolean) => { acctBtn.setAttribute('aria-expanded', String(on)); acctMenu.hidden = !on; };
    acctBtn.addEventListener('click', (e) => { e.stopPropagation(); open(acctMenu.hidden); });
    document.addEventListener('click', (e) => { if (!acctMenu.hidden && !acctMenu.contains(e.target as Node)) open(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !acctMenu.hidden) { open(false); acctBtn.focus(); } });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-logout]').forEach((b) => b.addEventListener('click', async () => {
    b.disabled = true;
    await fetch('/api/auth/logout', { method: 'POST' }).catch(() => null);
    location.href = '/';
  }));
</script>

<script>
  // Live unread-message and pending-request counts for signed-in members. Real numbers only; zero hides the badge.
  if (document.cookie.split('; ').indexOf('opus_in=1') > -1) {
    const set = (sel: string, n: number) => document.querySelectorAll<HTMLElement>(sel).forEach((el) => { el.hidden = n <= 0; el.textContent = n > 99 ? '99+' : String(n); });
    const pull = async () => {
      try {
        const r = await fetch('/api/messages/unread', { credentials: 'same-origin' });
        if (!r.ok) return;
        const u = await r.json() as { dm?: number; requests?: number };
        set('[data-hdr-msg]', u.dm ?? 0);
        set('[data-hdr-req], [data-req-count]', u.requests ?? 0);
      } catch { /* offline */ }
    };
    pull();
    setInterval(pull, 60000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) pull(); });
  }
</script>
<style>
  :global(.is-signed-in) [data-auth-out] { display: none !important; }
  :global(.is-signed-in) [data-auth-in] { display: block !important; }
  :global(.is-signed-in) .hdr__social[data-auth-in] { display: flex !important; }
  .hdr {
    position: sticky; top: 0; z-index: var(--z-header); color: var(--text);
    background: var(--glass-header); backdrop-filter: blur(18px) saturate(1.2); -webkit-backdrop-filter: blur(18px) saturate(1.2);
    border-bottom: 1px solid var(--line-faint);
    transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  /* Over the hero: pinned to the very top, a faint dark fade instead of a bar, so the globe runs up behind it. */
  .hdr--overlay { position: fixed; inset: 0 0 auto; background: linear-gradient(180deg, rgba(8, 8, 10, 0.55) 0%, rgba(8, 8, 10, 0.18) 70%, rgba(8, 8, 10, 0) 100%) border-box no-repeat; border-color: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .hdr--overlay.is-solid, .hdr.is-open { background: var(--glass-header); border-color: var(--line-faint); backdrop-filter: blur(18px) saturate(1.2); -webkit-backdrop-filter: blur(18px) saturate(1.2); }
  /* Still over the dark hero: dark glass, never a light bar across the globe. */
  .hdr--overlay.is-solid.tone-dark { background: rgba(13, 13, 15, 0.55); border-color: rgba(255, 255, 255, 0.06); }

  /* backdrop-filter makes the header the containing block for the fixed menu, so drop it while open */
  .hdr.is-open { background: var(--bg); backdrop-filter: none; -webkit-backdrop-filter: none; }
  /* Three zones: logo | links | account. The equal outer columns keep the links centred on the viewport. */
  .hdr__inner { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 32px; height: var(--hdr-h); }
  .hdr__brand { display: inline-flex; align-items: center; gap: 12px; flex-shrink: 0; justify-self: start; grid-column: 1; }
  .hdr__nav { grid-column: 2; }
  .hdr__actions { grid-column: 3; justify-self: end; }
  .hdr__brand img { height: 22px; width: auto; }

  /* One row of ten words. Each item fills the bar's height; its panel hangs from it, joined by a bridge. */
  .hdr__nav { align-self: stretch; }
  .hdr__list { display: flex; align-items: center; gap: 2px; height: 100%; margin: 0; }
  .hdr__item { position: relative; display: flex; align-items: center; height: 100%; }
  .hdr__link { position: relative; display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 13px; border-radius: 9px;
    font-size: 14px; letter-spacing: -0.005em; color: var(--text-2); white-space: nowrap; transition: background-color var(--m-hover) var(--m-ease), color var(--m-hover) var(--m-ease); }
  /* Hover: a soft neutral surface. Current page: the text in full colour with a quieter mark, so the two never look alike. */
  .hdr__item:hover > .hdr__link, .hdr__item.is-open > .hdr__link { background: var(--nav-hover); color: var(--text); }
  .hdr__link[aria-current] { color: var(--text); font-weight: 500; }
  .hdr__link[aria-current]::after { content: ''; position: absolute; left: 50%; bottom: 3px; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%; background: currentColor; opacity: .55; }
  .hdr__link:focus-visible, .hdr__disc:focus-visible, .navp a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* Keyboard-only: a small chevron appears beside a focused item to open its panel. */
  .hdr__disc { position: absolute; right: -6px; top: 50%; width: 18px; height: 18px; margin-top: -9px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 5px;
    background: var(--surface-raised); color: var(--text-2); opacity: 0; pointer-events: none; z-index: 1; }
  .hdr__disc:focus-visible, .hdr__disc[aria-expanded='true']:focus { opacity: 1; pointer-events: auto; }
  .hdr__more { display: none; }
  .hdr__actions .hdr__social:not([hidden]) { display: flex; flex-direction: row; align-items: center; gap: 2px; }
  .hdr__social[hidden] { display: none; }
  .hdr__ico { position: relative; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; color: var(--text-2); transition: background .18s, color .18s; }
  .hdr__ico:hover { background: var(--nav-hover); color: var(--text); }
  .hdr__badge { position: absolute; top: 3px; right: 1px; display: grid; place-items: center; min-width: 17px; height: 17px; padding: 0 5px; border-radius: 9px; background: var(--c-verified, #2f80ff); color: #fff; font-size: 11px; font-weight: 600; line-height: 1; box-shadow: 0 0 0 2px var(--bg); }
  .hdr__badge[hidden] { display: none; }
  @media (max-width: 999px) { .hdr__ico { width: 36px; height: 36px; } }
  .hdr__count { display: inline-grid; place-items: center; min-width: 17px; height: 17px; padding: 0 5px; border-radius: 9px; background: var(--c-verified, #2f80ff); color: #fff; font-size: 11px; font-weight: 600; line-height: 1; }
  .hdr__count[hidden] { display: none; }

  /* Panels: a compact card under its item, sized to its links. */
  .navp { position: absolute; top: 100%; left: -8px; z-index: 2; padding-top: 6px; }
  .navp::before { content: ''; position: absolute; left: 0; right: 0; top: -14px; height: 20px; } /* the bridge: no gap between word and card */
  .navp__card { width: max-content; max-width: min(460px, calc(100vw - 32px)); padding: 18px 8px 10px; border-radius: 14px; background: var(--surface-raised);
    box-shadow: 0 0 0 1px var(--line-faint), 0 18px 50px -18px var(--shadow-c), 0 6px 16px -10px var(--shadow-c);
    opacity: 0; transform: translateY(-4px); transition: opacity var(--m-menu) var(--m-ease), transform var(--m-menu) var(--m-ease); }
  .navp__card--wide { max-width: min(520px, calc(100vw - 32px)); }
  .hdr__item.is-open .navp__card { opacity: 1; transform: none; }
  /* Moving from one open menu to the next: a quick crossfade in place, no slide, so nothing flickers. */
  .hdr__item.is-switch .navp__card { transform: none; transition: opacity var(--m-hover) var(--m-ease); }
  .navp__head { padding: 0 12px 12px; margin-bottom: 6px; border-bottom: 1px solid var(--line-faint); max-width: 34ch; }
  .navp__name { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; color: var(--text); }
  .navp__line { margin: 3px 0 0; font-size: 13px; line-height: 1.45; color: var(--text-3); }
  .navp__soon { padding: 2px 7px; border: 1px solid var(--line); border-radius: var(--r-pill); font-size: 10px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); }
  .navp__groups { display: flex; gap: 8px; }
  .navp__group { flex: 1; min-width: 180px; }
  .navp__title { margin: 8px 12px 4px; font-size: 11px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); }
  .navp ul { margin: 0; padding: 0; }
  .navp a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 36px; padding: 0 12px; border-radius: 8px; font-size: 14px; color: var(--text); transition: background-color var(--m-hover) var(--ease); }
  .navp a:hover { background: var(--nav-hover); }
  :global(html:not(.is-signed-in)) .navp a[data-auth-only] .hdr__count { display: none; }
