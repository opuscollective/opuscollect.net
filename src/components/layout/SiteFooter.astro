---
import { FOOTER_NAV, SOCIALS, SITE } from '@/data/site';
const year = new Date().getFullYear();
/** light: the black footer in either theme, continuing the dark globe hero (homepage). */
const { light = false } = Astro.props as { light?: boolean };
---
<footer class:list={['ftr', { 'ftr--light tone-dark': light }]}>
  <div class="container">
    <div class="ftr__top">
      <div class="ftr__brand">
        <img class="logo" src="/images/oc-logo.png" alt="" width="52" height="34" />
        <p class="ftr__motto">{SITE.motto}</p>
      </div>
      <nav aria-label="Footer">
        <ul class="ftr__links" role="list">{FOOTER_NAV.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    </div>

    <p class="ftr__wordmark" aria-hidden="true">Opus Collective</p>

    <div class="ftr__legal">
      <span>© {year} {SITE.name} · {SITE.location}</span>
      <ul class="ftr__social" role="list" aria-label="Social">{SOCIALS.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
      <ul role="list">
        <li><a href="/legal">Privacy</a></li>
        <li><a href="/legal">Terms</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .ftr.ftr--light { background: var(--bg); color: var(--text); border-top: 0; }
  .ftr--light .ftr__links a:hover, .ftr--light .ftr__legal a:hover { color: var(--text); }
  .ftr--light .ftr__legal { border-top-color: rgba(255,255,255,.1); }
  .ftr.ftr--light { padding-top: clamp(28px, 3vw, 44px); }
  .ftr { border-top: 1px solid var(--c-line); padding-top: clamp(40px, 4.5vw, 64px); overflow: hidden; }
  .ftr__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px 56px; }
  /* One line: mark, hairline, motto. The links sit on the same centre line across the page. */
  .ftr__brand { display: flex; align-items: center; gap: 16px; }
  .ftr__brand img { height: 26px; width: auto; }
  .ftr__motto { margin: 0; padding-left: 16px; border-left: 1px solid var(--c-line); font-size: 15px; font-weight: 400; letter-spacing: -0.01em; color: var(--c-fg-subtle); }
  .ftr__links { display: flex; flex-wrap: wrap; gap: 4px 28px; margin: 0; }
  .ftr__links a { display: inline-flex; align-items: center; min-height: 40px; font-size: 15px; color: var(--c-fg-subtle); transition: color var(--dur-fast); }
  .ftr__links a:hover { color: var(--c-white); }
  .ftr__wordmark {
    margin-top: clamp(28px, 3.5vw, 52px); font-size: min(193px, calc((100vw - 2 * var(--gutter)) / 6.75)); line-height: 0.8; font-weight: 600;
    letter-spacing: -0.065em; white-space: nowrap; color: var(--wordmark); user-select: none; padding-bottom: 0.16em; /* room for the p descender above the rule */
  }
  .ftr__legal { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px; padding-block: 20px 64px; margin-top: 8px; border-top: 1px solid var(--c-line); font-size: 12px; color: var(--c-fg-ghost); }
  .ftr__legal ul { display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 0; }
  .ftr__legal a { display: inline-flex; min-height: 32px; align-items: center; }
  .ftr__legal a:hover { color: var(--c-white); }
  @media (max-width: 760px) {
    .ftr__top { align-items: flex-start; }
    .ftr__links { gap: 0 22px; }
    .ftr__legal { flex-direction: column; align-items: flex-start; padding-bottom: 32px; }
  }
</style>
