---
import { FOOTER_NAV, SOCIALS, SITE } from '@/data/site';
const year = new Date().getFullYear();
/** light: the warm-white editorial footer in either theme (homepage). */
const { light = false } = Astro.props as { light?: boolean };
---
<footer class:list={['ftr', { 'ftr--light tone-light': light }]}>
  <div class="container">
    <div class="ftr__top">
      <div class="ftr__brand">
        <img class="logo" src="/images/oc-logo.png" alt="" width="52" height="34" />
        <p class="ftr__motto">{SITE.motto}</p>
      </div>
      <nav aria-label="Footer">
        <ul class="ftr__links" role="list">{FOOTER_NAV.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    </div>

    <p class="ftr__wordmark" aria-hidden="true">Opus Collective</p>

    <div class="ftr__legal">
      <span>© {year} {SITE.name} · {SITE.location}</span>
      <ul class="ftr__social" role="list" aria-label="Social">{SOCIALS.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
      <ul role="list">
        <li><a href="/legal">Privacy</a></li>
        <li><a href="/legal">Terms</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .ftr--light { background: var(--bg); color: var(--text); border-top: 0; }
  .ftr--light .ftr__links a:hover, .ftr--light .ftr__legal a:hover { color: var(--text); }
  .ftr { border-top: 1px solid var(--c-line); padding-top: clamp(56px, 7vw, 96px); overflow: hidden; }
  .ftr__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 32px 56px; }
  .ftr__brand { display: flex; flex-direction: column; gap: 14px; }
  .ftr__brand img { height: 34px; width: auto; align-self: flex-start; }
  .ftr__motto { font-size: 17px; font-weight: 500; letter-spacing: -0.015em; }
  .ftr__links { display: flex; flex-wrap: wrap; gap: 4px 28px; margin: 0; }
  .ftr__links a { display: inline-flex; align-items: center; min-height: 40px; font-size: 15px; color: var(--c-fg-subtle); transition: color var(--dur-fast); }
  .ftr__links a:hover { color: var(--c-white); }
  .ftr__wordmark {
    margin-top: clamp(56px, 8vw, 112px); font-size: min(200px, calc((100vw - 2 * var(--gutter)) / 7.1)); line-height: 0.8; font-weight: 600;
    letter-spacing: -0.065em; white-space: nowrap; color: var(--wordmark); user-select: none;
  }
  .ftr__legal { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px; padding-block: 24px 32px; margin-top: 24px; border-top: 1px solid var(--c-line); font-size: 12px; color: var(--c-fg-ghost); }
  .ftr__legal ul { display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 0; }
  .ftr__legal a { display: inline-flex; min-height: 32px; align-items: center; }
  .ftr__legal a:hover { color: var(--c-white); }
  @media (max-width: 760px) {
    .ftr__links { flex-direction: column; gap: 0; }
    .ftr__legal { flex-direction: column; align-items: flex-start; }
  }
</style>
