---
/**
 * Preview page for a product that isn't built yet: what it does, who it's for, what's coming, and when.
 * Nothing on it pretends to work. The only actions are real ones elsewhere on Opus.
 */
interface Props {
  name: string; line: string; lead: string; availability: string;
  does: string[]; forWho: string[]; coming: string[];
  now: { label: string; href: string }[];
}
const { name, line, lead, availability, does, forWho, coming, now } = Astro.props;
const user = Astro.locals.user;
---
<section class="pp">
  <div class="pp__hero tone-dark">
    <div class="pp__in">
      <p class="pp__kicker">{name} <span class="pp__soon">Coming soon</span></p>
      <h1 class="pp__title">{line}</h1>
      <p class="pp__lead">{lead}</p>
      <slot name="visual" />
    </div>
  </div>
  <div class="pp__in pp__cols">
    <div><h2>What it does</h2><ul role="list">{does.map((d) => <li>{d}</li>)}</ul></div>
    <div><h2>Who it’s for</h2><ul role="list">{forWho.map((d) => <li>{d}</li>)}</ul></div>
    <div><h2>What’s coming</h2><ul role="list">{coming.map((d) => <li>{d}</li>)}</ul></div>
  </div>
  <div class="pp__in pp__avail">
    <div><h2>Availability</h2><p>{availability}</p></div>
    <div class="pp__ctas">
      {!user && <a class="pp__btn pp__btn--go" href="/sign-up">Join Opus</a>}
      {now.map((n) => <a class="pp__btn" href={n.href}>{n.label}</a>)}
    </div>
  </div>
</section>
<style>
  .pp { padding-bottom: 96px; }
  .pp__hero { margin: 0 12px; padding: clamp(120px, 14vw, 180px) 0 clamp(56px, 7vw, 96px); background: #0b0b0d; color: #f4f2ee; border-radius: 0 0 28px 28px; overflow: hidden; }
  .pp__in { max-width: 1120px; margin: 0 auto; padding: 0 var(--gutter, 24px); }
  .pp__kicker { display: flex; align-items: center; gap: 12px; margin: 0; font-size: 15px; font-weight: 500; color: rgba(244, 242, 238, 0.8); }
  .pp__soon { padding: 3px 10px; border: 1px solid rgba(244, 242, 238, 0.4); border-radius: var(--r-pill); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }
  .pp__title { margin: 18px 0 0; font-size: clamp(2.6rem, 1.6rem + 4.4vw, 5.4rem); font-weight: 600; letter-spacing: -0.045em; line-height: 0.98; }
  .pp__lead { margin: 20px 0 0; max-width: 46ch; font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem); line-height: 1.5; color: rgba(244, 242, 238, 0.76); }
  .pp__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 4vw, 56px); margin-top: 64px; }
  .pp h2 { margin: 0 0 14px; font-size: 13px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); }
  .pp ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .pp li { font-size: 16px; line-height: 1.5; color: var(--text); padding-top: 12px; border-top: 1px solid var(--line); }
  .pp__avail { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px; margin-top: 64px; }
  .pp__avail p { margin: 0; max-width: 56ch; font-size: 16px; line-height: 1.55; color: var(--text-2); }
  .pp__ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  .pp__btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 20px; border-radius: var(--r-pill); border: 1px solid var(--line-strong); color: var(--text); font-size: 15px; font-weight: 500; }
  .pp__btn--go { background: var(--text); color: var(--bg); border-color: var(--text); }
  .pp__btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (max-width: 760px) {
    .pp__hero { margin: 0; border-radius: 0; }
    .pp__cols { grid-template-columns: 1fr; margin-top: 44px; }
  }
</style>
